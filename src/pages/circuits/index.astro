---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CircuitsHub from "../../components/CircuitsHub.astro";

const index = JSON.parse(fs.readFileSync(path.resolve("./data/circuits/index.json"), "utf8"));
---

<BaseLayout
  title="F1 Circuits — Every Track in Championship History | f1delta"
  description="Every circuit that has hosted a Formula 1 World Championship race — track profiles, race records, and history from 1950 to today."
  canonical="https://f1delta.com/circuits"
>
  <CircuitsHub index={index} />
  <script src="/f1-records.js" defer is:inline></script>
</BaseLayout>
