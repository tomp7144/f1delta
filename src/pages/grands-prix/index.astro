---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GrandsPrixHub from "../../components/GrandsPrixHub.astro";

const index = JSON.parse(fs.readFileSync(path.resolve("./data/grands-prix/index.json"), "utf8"));
---

<BaseLayout
  title="F1 Grands Prix — Every Race in Championship History | f1delta"
  description="Every Grand Prix in Formula 1 World Championship history — all-time winners, records, and runnings from 1950 to today."
  canonical="https://f1delta.com/grands-prix"
>
  <GrandsPrixHub index={index} />
  <script src="/f1-records.js" defer is:inline></script>
</BaseLayout>
