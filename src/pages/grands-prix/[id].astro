---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GrandPrixPage from "../../components/GrandPrixPage.astro";

export function getStaticPaths() {
  const DIR = path.resolve("./data/grands-prix");
  const index = JSON.parse(fs.readFileSync(path.join(DIR, "index.json"), "utf8"));
  return index.grandsPrix.map((gp: any) => ({
    params: { id: gp.id },
    props: { gp: JSON.parse(fs.readFileSync(path.join(DIR, `${gp.id}.json`), "utf8")) },
  }));
}

const { gp } = Astro.props as { gp: any };
const desc = `${gp.name}: all-time winners, poles, fastest laps and records across ${gp.runnings} runnings from ${gp.firstYear} to ${gp.lastYear}.`;
---

<BaseLayout
  title={`${gp.name} — All-Time Records | f1delta`}
  description={desc}
  canonical={`https://f1delta.com/grands-prix/${gp.id}`}
>
  <GrandPrixPage gp={gp} />
  <script src="/f1-records.js" defer is:inline></script>
</BaseLayout>
