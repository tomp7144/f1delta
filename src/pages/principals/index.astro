---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PeopleHub from "../../components/PeopleHub.astro";

const PEOPLE_DIR = path.resolve("./data/people");
const data = JSON.parse(fs.readFileSync(path.join(PEOPLE_DIR, "principals.json"), "utf8"));

const people = data.people.map((p: any) => {
  const full = JSON.parse(fs.readFileSync(path.join(PEOPLE_DIR, `${p.id}.json`), "utf8"));
  const tpRoles = full.roles.filter((r: any) => r.type === "team-principal");
  const teams   = [...new Map(tpRoles.map((r: any) => [r.teamId as string, r.teamName as string])).entries()].map(([id, name]) => ({ id, name }));
  const lastYear = tpRoles.every((r: any) => r.toYear === null) ? null
    : Math.max(...tpRoles.map((r: any) => r.toYear ?? 0).filter((y: number) => y > 0));
  return { ...p, teams, lastYear };
});
---

<BaseLayout
  title="F1 Team Principals | f1delta"
  description="Every Formula 1 team principal — current and historical, across all constructors."
  canonical="https://f1delta.com/principals"
>
  <PeopleHub
    people={people}
    title="Team Principals"
    lede="Every Formula 1 team principal — current and historical."
  />
  <script src="/f1-records.js" defer is:inline></script>
</BaseLayout>
