---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import F1DeltaExplain from "../../components/F1DeltaExplain.astro";
import ReliabilityExplain from "../../components/ReliabilityExplain.astro";

export function getStaticPaths() {
  const { drivers } = JSON.parse(
    fs.readFileSync(path.resolve("./data/drivers/index.json"), "utf8")
  );
  const salaries = JSON.parse(fs.readFileSync(path.resolve("./data/salaries.json"), "utf8"));
  const rtf1All  = JSON.parse(fs.readFileSync(path.resolve("./data/rtf1.json"), "utf8"));
  const byDriver = JSON.parse(fs.readFileSync(path.resolve("./data/people/by-driver.json"), "utf8"));
  return drivers.map((dr: any) => ({
    params: { id: dr.driverId },
    props: {
      salary:   salaries[dr.driverId] ?? null,
      rtf1:     rtf1All[dr.driverId]  ?? null,
      engineer: byDriver[dr.driverId] ?? null,
    },
  }));
}

const { id } = Astro.params as { id: string };
const { salary, rtf1, engineer } = Astro.props as {
  salary: any; rtf1: any; engineer: any;
};

const { pairings: _h2hPairings } = JSON.parse(
  fs.readFileSync(path.resolve("./data/h2h-pairings.json"), "utf8")
);
const h2hSlugs = new Set<string>((_h2hPairings as any[]).map((p: any) => p.slug));

const d = JSON.parse(
  fs.readFileSync(path.resolve(`./data/drivers/${id}.json`), "utf8")
);

const active = d.lastSeason >= 2026;
const titles: number = d.totals.championships ?? 0;

function fmt(n: number | null | undefined): string {
  if (n == null) return "";
  return n % 1 === 0 ? String(n) : n.toFixed(1);
}

const TEAM_COLOR: Record<string, string> = {
  "red-bull": "#3671C6", "toro-rosso": "#4562FF", "rb": "#6692FF", "ferrari": "#E8002D",
  "mclaren": "#FF8000", "mercedes": "#27F4D2", "williams": "#64C4FF", "aston-martin": "#229971",
  "alpine": "#0093CC", "haas": "#B6BABD", "sauber": "#52E252", "renault": "#FFF500",
  "racing-point": "#F596C8", "force-india": "#F596C8", "lotus-f1": "#FFB800", "brawn": "#B8FD6E",
  "alfa-romeo": "#C92D4B", "jordan": "#E8B432", "benetton": "#00A650", "bmw-sauber": "#2E4BB1",
  "bar": "#C8102E", "toyota": "#E00F3A", "minardi": "#1e1e1e", "jaguar": "#006540",
  "arrows": "#F28A17", "prost": "#00488B", "stewart": "#D6001C",
};
const ac = (tid: string) => TEAM_COLOR[tid] || "#9aa0ab";

function yrRange(ys: number[] | undefined): string {
  if (!ys?.length) return "";
  const mn = Math.min(...ys), mx = Math.max(...ys);
  return ys.length === 1
    ? `'${String(mn).slice(2)}`
    : `'${String(mn).slice(2)}–'${String(mx).slice(2)}`;
}

const career = [...(d.career ?? [])].sort((a: any, b: any) => a.season - b.season);
const teammates = [...(d.teammates ?? [])].sort(
  (a: any, b: any) => b.aggregate.races - a.aggregate.races
);

const yearSpan = active ? `${d.firstSeason}–present` : `${d.firstSeason}–${d.lastSeason}`;

const starts: number = d.totals.races ?? 0;
const dnfPct = starts > 0 ? ((d.totals.dnfCount / starts) * 100).toFixed(1) + "%" : "—";
const ptsPct = starts > 0 ? ((d.totals.pointsFinishes / starts) * 100).toFixed(1) + "%" : "—";
const titleStr = `${d.name} | F1 Driver | f1delta`;
const descStr = `Career stats for ${d.name}: ${d.totals.races ?? 0} races, ${d.totals.wins ?? 0} wins${titles > 0 ? `, ${titles} World Championship${titles > 1 ? "s" : ""}` : ""}. F1DB data, 1950–present.`;

---

<BaseLayout
  title={titleStr}
  description={descStr}
  canonical={`https://f1delta.com/drivers/${id}`}
>

  <!-- ── Identity header ───────────────────────────────────────────── -->
  <div class="drv-id">
    <div class="drv-wrap">
      <div class="id-row">
        <span class="code">{d.code || "—"}</span>
        <h1>{d.name}</h1>
      </div>
      <div class="meta">{yearSpan}</div>
      <div class="totals">
        {([
          ["Starts",  d.totals.races    ?? 0],
          ["Wins",    d.totals.wins     ?? 0],
          ["Podiums", d.totals.podiums  ?? 0],
          ["Poles",   d.totals.poles    ?? 0],
          ["Titles",  titles],
          ["Points",  fmt(d.totals.points)],
        ] as [string, string | number][]).map(([k, v]) => (
          <div class="tot">
            <div class:list={["v", { gold: k === "Titles" && titles > 0 }]}>{v}</div>
            <div class="k">{k}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Body ─────────────────────────────────────────────────────── -->
  <div class="drv-wrap drv-body">

    <!-- Season-by-season ─────────────────────────────────────────── -->
    <section class="drv-sec">
      <div class="sec-h">
        <h2>Season by season</h2>
        <span class="hint">tap a header to sort</span>
      </div>
      <div class="card">
        <div class="table-scroll">
          <table data-record-table>
            <thead>
              <tr>
                <th class="l" data-sort="season" data-type="num" aria-sort="ascending">Season</th>
                <th class="l">Team</th>
                <th class="ent" data-sort="ent" data-type="num">ENT</th>
                <th data-sort="races"   data-type="num">R</th>
                <th data-sort="wins"    data-type="num">Win</th>
                <th data-sort="podiums" data-type="num">Pod</th>
                <th data-sort="poles"   data-type="num">Pole</th>
                <th data-sort="points"  data-type="num">Pts</th>
                <th data-sort="wdc"     data-type="num">WDC</th>
              </tr>
            </thead>
            <tbody>
              {career.map((s: any) => {
                const champ = s.wdcFinish === 1;
                const teams: any[] = s.teams ?? [{ constructorId: s.primaryTeamId, constructor: s.primaryTeam, races: s.races }];
                const multiTeam = teams.length > 1;
                return (
                  <tr
                    data-season={s.season}
                    data-ent={s.entries ?? 0}
                    data-races={s.races ?? 0}
                    data-wins={s.wins ?? 0}
                    data-podiums={s.podiums ?? 0}
                    data-poles={s.poles ?? 0}
                    data-points={s.points ?? 0}
                    data-wdc={s.wdcFinish ?? 999}
                    class={champ ? "champ" : ""}
                  >
                    <td class="yr">
                      <a href={`/standings/${s.season}`}>{s.season}</a>
                    </td>
                    <td class:list={["tm", { multi: multiTeam }]}>
                      {teams.map((t: any, i: number) => (
                        <>
                          {i > 0 && <span class="tm-sep"> · </span>}
                          <span class="dot" style={`background:${ac(t.constructorId)}`}></span>
                          <a href={`/teams/${t.constructorId}`}>{t.constructor}</a>
                          {multiTeam && <span class="tm-ct"> ({t.races})</span>}
                        </>
                      ))}
                    </td>
                    <td class="n ent">{s.entries ?? ""}</td>
                    <td class="n">{s.races ?? ""}</td>
                    <td class:list={["n", { hot: (s.wins ?? 0) > 0 }]}>{s.wins ?? 0}</td>
                    <td class="n">{s.podiums ?? 0}</td>
                    <td class="n">{s.poles ?? 0}</td>
                    <td class="n strong">{fmt(s.points)}</td>
                    <td class:list={["wdc", { t: champ }]}>
                      {s.wdcFinish != null ? `P${s.wdcFinish}` : "—"}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Race engineer ────────────────────────────────────────────── -->
    {engineer && (engineer.current || engineer.past?.length > 0) && (
      <section class="drv-sec">
        <div class="sec-h"><h2>Race engineer</h2></div>
        <div class="card eng-card">
          {engineer.current && (
            <div class="eng-cur">
              <a class="eng-name" href={`/people/${engineer.current.personId}`}>
                {engineer.current.personName}
                {engineer.current.aka ? ` "${engineer.current.aka}"` : ""}
              </a>
              <span class="eng-meta">
                <a href={`/teams/${engineer.current.teamId}`}>{engineer.current.teamName}</a>
                {" · since "}{engineer.current.fromYear}
              </span>
              {engineer.current.notes && (
                <span class="eng-note">{engineer.current.notes}</span>
              )}
            </div>
          )}
          {engineer.past?.length > 0 && (
            <div class="eng-past">
              {engineer.past.map((p: any) => (
                <div class="eng-past-row">
                  <a class="eng-name" href={`/people/${p.personId}`}>
                    {p.personName}{p.aka ? ` "${p.aka}"` : ""}
                  </a>
                  <span class="eng-meta">
                    <a href={`/teams/${p.teamId}`}>{p.teamName}</a>
                    {" · "}
                    {p.fromYear === p.toYear ? p.fromYear : `${p.fromYear}–${p.toYear}`}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Ad slot ──────────────────────────────────────────────────── -->
    <div class="ad-slot" id="driver-ad-slot" data-ad-slot></div>

    <!-- Teammates, head to head ──────────────────────────────────── -->
    {teammates.length > 0 && (
      <section class="drv-sec">
        <div class="sec-h">
          <h2>Teammates, head to head</h2>
          <span class="hint">most races first · default: both classified</span>
        </div>
        <div class="card">
          <div class="table-scroll">
            <table data-f1-table>
              <thead>
                <tr>
                  <th class="l">Teammate</th>
                  <th class="l">Qualifying</th>
                  <th class="l">Race</th>
                  <th class="l">Points</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {teammates.map((t: any) => {
                  const a = t.aggregate;
                  const slug = [id, t.teammateId].sort().join("-vs-");
                  return (
                    <tr class:list={[{ "h2h-row": h2hSlugs.has(slug) }]}
                        data-href={h2hSlugs.has(slug) ? `/h2h/${slug}` : undefined}>
                      <td class="who">
                        <a href={`/drivers/${t.teammateId}`}>{t.teammate}</a>
                        <span class="ys">{yrRange(t.seasonsShared)}</span>
                      </td>
                      <td class="h2s">
                        <span class="sc"><b>{a.qualiAhead}</b>–{a.qualiBehind}</span>
                      </td>
                      <td class="h2s">
                        <span class="sc"><b>{a.raceAhead}</b>–{a.raceBehind}</span>
                      </td>
                      <td class="pts">
                        <b>{fmt(a.pointsSelf)}</b>
                        <span class="vs">{fmt(a.pointsMate)}</span>
                      </td>
                      <td class="bdl">
                        {h2hSlugs.has(slug)
                          ? <a class="h2h-link" href={`/h2h/${slug}`}>→</a>
                          : null}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}

    <!-- Compare with any driver ────────────────────────────────── -->
    <section class="drv-sec">
      <div class="sec-h">
        <h2>Compare with any driver</h2>
        <span class="hint">career records side by side · any era</span>
      </div>
      <div class="card cmp-card">
        <div id="drv-cmp-ctrl" class="drv-cmp-ctrl">
          <input
            id="drv-cmp-input"
            type="text"
            class="drv-cmp-input"
            placeholder={`Compare ${d.name} with…`}
            autocomplete="off"
          />
          <div id="drv-cmp-results" class="drv-cmp-results" hidden></div>
        </div>
        <p class="drv-cmp-note">
          Teammate Head-to-Head (above) covers same-car seasons only.
          Compare reaches across any era — pick any driver.
        </p>
      </div>
    </section>
    <script define:vars={{ driverId: id }} is:inline>
    (function () {
      var SELF = driverId;
      var _index = null;

      var ctrl    = document.getElementById("drv-cmp-ctrl");
      var input   = document.getElementById("drv-cmp-input");
      var results = document.getElementById("drv-cmp-results");

      function filterDrivers(q) {
        if (!_index || !q.trim()) return [];
        var n = q.trim().toLowerCase();
        return _index
          .filter(function (d) {
            if (d.type !== "driver" || d.id === SELF) return false;
            var lbl = d.label.toLowerCase();
            return lbl.startsWith(n) ||
                   lbl.split(/\s+/).some(function (w) { return w.startsWith(n); }) ||
                   (d.code || "").toLowerCase().startsWith(n);
          })
          .sort(function (a, b) {
            var n2 = q.trim().toLowerCase();
            var as = a.label.toLowerCase().startsWith(n2);
            var bs = b.label.toLowerCase().startsWith(n2);
            if (as && !bs) return -1;
            if (bs && !as) return  1;
            return (b.ly || 0) - (a.ly || 0);
          })
          .slice(0, 8);
      }

      function renderResults(matches) {
        if (!matches.length) { results.hidden = true; return; }
        results.innerHTML = matches.map(function (d) {
          return '<button class="drv-cmp-opt" data-id="' + d.id + '">' +
            '<span class="drv-cmp-opt-name">' + d.label + '</span>' +
            '<span class="drv-cmp-opt-yr">' + d.fy + '–' + d.ly + '</span>' +
            '</button>';
        }).join("");
        results.hidden = false;
      }

      async function ensureIndex() {
        if (_index) return;
        var r = await fetch("/search-index.json");
        _index = await r.json();
      }

      input.addEventListener("input", async function () {
        await ensureIndex();
        renderResults(filterDrivers(input.value));
      });

      input.addEventListener("focus", async function () {
        await ensureIndex();
        if (input.value) renderResults(filterDrivers(input.value));
      });

      results.addEventListener("click", function (e) {
        var btn = e.target.closest(".drv-cmp-opt");
        if (!btn) return;
        var otherId = btn.dataset.id;
        var slug = [SELF, otherId].sort().join("-vs-");
        window.location.href = "/compare/" + slug;
      });

      input.addEventListener("keydown", function (e) {
        var btns = Array.from(results.querySelectorAll(".drv-cmp-opt"));
        var fi = btns.indexOf(document.activeElement);
        if (e.key === "ArrowDown") {
          e.preventDefault();
          if (fi < 0) btns[0] && btns[0].focus();
          else if (fi < btns.length - 1) btns[fi + 1].focus();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (fi > 0) btns[fi - 1].focus();
          else input.focus();
        } else if (e.key === "Enter" && fi < 0 && btns.length) {
          btns[0].click();
        } else if (e.key === "Escape") {
          results.hidden = true; input.focus();
        }
      });

      document.addEventListener("click", function (e) {
        if (!ctrl.contains(e.target)) results.hidden = true;
      });
    })();
    </script>

    <!-- Road to Formula 1 ───────────────────────────────────────── -->
    {rtf1 && (
      <section class="drv-sec">
        <div class="sec-h"><h2>Road to Formula 1</h2></div>
        {rtf1.prose?.length > 0 && (
          <div class:list={["card", { "card-gap": !!rtf1.timeline }]}>
            <div class="rtf1-card">
              {(rtf1.prose as [string, string][]).map(([label, text]) => (
                <div class="rtf1-row">
                  <div class="rtf1-label">{label}</div>
                  <p class="rtf1-text">{text}</p>
                </div>
              ))}
            </div>
          </div>
        )}
        {rtf1.timeline && (
          <div class="card">
            <div class="rtf1-tl">
              {rtf1.timeline.entries.map((e: any, i: number) => {
                const prevYear = i > 0 ? rtf1.timeline.entries[i - 1].year : null;
                const showYr = prevYear !== e.year;
                return (
                  <div class="rtf1-tl-row">
                    <span class="rtf1-tl-yr">{showYr ? e.year : ""}</span>
                    <span class="rtf1-tl-nd">
                      <svg width="12" height="12" viewBox="0 0 12 12">
                        <circle cx="6" cy="6" r="4" fill="var(--surface)" stroke="var(--faint)" stroke-width="1.5" />
                      </svg>
                    </span>
                    <div class="rtf1-tl-ct">
                      <div class="rtf1-tl-sr">{e.series}</div>
                      {(e.team || e.result) && (
                        <div class="rtf1-tl-mt">
                          {e.team && <span>{e.team}</span>}
                          {e.team && e.result && <span>{" · "}</span>}
                          {e.result && (
                            <span class:list={[{ "rtf1-res-w": e.result === "Champion" }]}>
                              {e.result}
                            </span>
                          )}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
              <div class="rtf1-tl-row rtf1-tl-row--f1">
                <span class="rtf1-tl-yr">{rtf1.timeline.debut.year}</span>
                <span class="rtf1-tl-nd">
                  <svg width="16" height="16" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="7" fill="var(--red)" />
                  </svg>
                </span>
                <div class="rtf1-tl-ct">
                  <div class="rtf1-tl-sr">Formula 1 Debut</div>
                  <div class="rtf1-tl-mt">{rtf1.timeline.debut.team}</div>
                </div>
              </div>
            </div>
          </div>
        )}
      </section>
    )}

    <!-- f1δ Score ──────────────────────────────────────────────── -->
    {d.f1delta && (
      <section class="drv-sec">
        <div class="sec-h">
          <h2>f1δ Score</h2>
          <span class="hint">era-fair · % of max · career sum · <a href="/methodology" class="hint-link">what is this?</a></span>
        </div>
        <div class="card f1d-card">
          <div class="f1d-hero">
            <span class="f1d-career">{(d.f1delta.career as number).toFixed(1)}</span>
            <span class="f1d-career-label">career f1δ</span>
          </div>
          {(d.f1delta as any).peak != null && (
            <div class="f1d-stats">
              <div class="f1d-stat">
                <span class="f1d-stat-val">{((d.f1delta as any).peak as number).toFixed(1)}</span>
                <span class="f1d-stat-label">peak ({(d.f1delta as any).peakYear})</span>
              </div>
              <div class="f1d-stat">
                <span class="f1d-stat-val">{(d.f1delta as any).seasonalWins}</span>
                <span class="f1d-stat-label">seasonal wins</span>
              </div>
              <div class="f1d-stat">
                <span class="f1d-stat-val">{(d.f1delta as any).seasonalPodiums}</span>
                <span class="f1d-stat-label">seasonal podiums</span>
              </div>
              {(d.f1delta as any).dominantStretch > 0 && (
                <div class="f1d-stat">
                  <span class="f1d-stat-val">{(d.f1delta as any).dominantStretch}</span>
                  <span class="f1d-stat-label">
                    stretch ({(d.f1delta as any).stretchStart === (d.f1delta as any).stretchEnd
                      ? (d.f1delta as any).stretchStart
                      : `${(d.f1delta as any).stretchStart}–${(d.f1delta as any).stretchEnd}`})
                  </span>
                </div>
              )}
            </div>
          )}
          <div class="f1d-strip">
            {(d.f1delta.seasons as any[]).map((s: any) => (
              <div class="f1d-row">
                <a class="f1d-yr" href={`/standings/${s.year}`}>{s.year}</a>
                <div class="f1d-bar-wrap">
                  <span class="f1d-bar" style={`width:${Math.min(s.f1delta, 100)}%`}></span>
                </div>
                <span class="f1d-val">{(s.f1delta as number).toFixed(1)}</span>
                {s.rank != null && (
                  <span class={`f1d-rank ${s.rank === 1 ? 'r1' : s.rank <= 3 ? 'r3' : 'rout'}`}>
                    #{s.rank}
                  </span>
                )}
              </div>
            ))}
          </div>
          <F1DeltaExplain />
        </div>
      </section>
    )}

    <!-- Reliability & Consistency ───────────────────────────────── -->
    {starts > 0 && (
      <section class="drv-sec">
        <div class="sec-h">
          <h2>Reliability &amp; consistency</h2>
          <span class="hint">era-dependent · see explanation</span>
        </div>
        <div class="card rel-card">
          <div class="rel-stats">
            <div class="rel-stat">
              <span class="rel-val">{dnfPct}</span>
              <span class="rel-label">DNF rate</span>
              <span class="rel-sub">{d.totals.dnfCount} in {starts} starts</span>
            </div>
            <div class="rel-stat">
              <span class="rel-val">{ptsPct}</span>
              <span class="rel-label">points-finish rate</span>
              <span class="rel-sub">{d.totals.pointsFinishes} in {starts} starts</span>
            </div>
            {d.totals.bestFinish != null && (
              <div class="rel-stat">
                <span class="rel-val">P{d.totals.bestFinish}</span>
                <span class="rel-label">best finish</span>
              </div>
            )}
            {d.totals.bestGrid != null && (
              <div class="rel-stat">
                <span class="rel-val">P{d.totals.bestGrid}</span>
                <span class="rel-label">best grid</span>
              </div>
            )}
          </div>
          <ReliabilityExplain />
        </div>
      </section>
    )}

    <!-- 2026 Salary ─────────────────────────────────────────────── -->
    {salary && (
      <section class="drv-sec">
        <div class="sec-h"><h2>2026 Salary</h2></div>
        <div class="card sal-card">
          <div class="sal-fence">estimated — not officially disclosed</div>
          <div class="sal-rows">
            <div class="sal-row">
              <span class="sal-label">Est. annual</span>
              <span class="sal-val sal-primary">{salary.salary}</span>
            </div>
            <div class="sal-row">
              <span class="sal-label">Contract through</span>
              <span class="sal-val">{salary.through}</span>
            </div>
            <div class="sal-row">
              <span class="sal-label">Base / bonus</span>
              <span class:list={["sal-val", { "sal-unknown": salary.split === "UNKNOWN" }]}>
                {salary.split === "UNKNOWN" ? "not reported" : salary.split}
              </span>
            </div>
          </div>
          <p class="sal-source">Source: {salary.source}</p>
        </div>
      </section>
    )}

  </div>

  <script src="/f1-records.js" defer is:inline></script>

  <script is:inline>
  // H2H row click: navigate to breakdown, but let inner <a> links handle themselves
  document.addEventListener('click', function (e) {
    var row = e.target.closest('tr.h2h-row');
    if (!row) return;
    if (e.target.closest('a')) return; // let links inside the row navigate naturally
    var href = row.dataset.href;
    if (href) window.location.href = href;
  });
  </script>

