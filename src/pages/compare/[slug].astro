---
export const prerender = false;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import F1DeltaExplain from "../../components/F1DeltaExplain.astro";

// ── Module-level init (cold start, not per-request) ────────────────────────
const _root = path.resolve(".");

const { pairings: _pairings } = JSON.parse(
  fs.readFileSync(path.join(_root, "data/h2h-pairings.json"), "utf8")
);
const h2hSlugs = new Set<string>(_pairings.map((p: any) => p.slug));

const { drivers: _driverIndex } = JSON.parse(
  fs.readFileSync(path.join(_root, "data/drivers/index.json"), "utf8")
);
const validIds = new Set<string>(_driverIndex.map((d: any) => d.driverId));

// ── Request handling ───────────────────────────────────────────────────────
const { slug } = Astro.params as { slug: string };

const vsIdx = slug ? slug.indexOf("-vs-") : -1;
if (!slug || vsIdx < 0) return new Response(null, { status: 404 });

const rawA = slug.slice(0, vsIdx);
const rawB = slug.slice(vsIdx + 4);

if (!rawA || !rawB) return new Response(null, { status: 404 });

// Canonical redirect: IDs must be alphabetically sorted
const sorted = [rawA, rawB].sort();
if (sorted[0] !== rawA || sorted[1] !== rawB) {
  return Astro.redirect(`/compare/${sorted.join("-vs-")}`, 301);
}

const idA = rawA, idB = rawB;
if (idA === idB) return new Response(null, { status: 404 });

if (!validIds.has(idA) || !validIds.has(idB)) {
  return new Response(null, { status: 404 });
}

let dA: any, dB: any;
try {
  dA = JSON.parse(fs.readFileSync(path.join(_root, `data/drivers/${idA}.json`), "utf8"));
  dB = JSON.parse(fs.readFileSync(path.join(_root, `data/drivers/${idB}.json`), "utf8"));
} catch {
  return new Response(null, { status: 404 });
}

// CDN-cacheable: 1-hour browser, 7-day Netlify/Cloudflare, 1-day SWR
// Purge-on-deploy busts the CDN cache automatically.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400"
);

// ── Stats helpers ─────────────────────────────────────────────────────────
const tA = dA.totals ?? {};
const tB = dB.totals ?? {};

function pct(n: number, d: number) {
  return d > 0 ? (n / d * 100).toFixed(1) + "%" : "—";
}
function fmt(n: number | null | undefined) {
  if (n == null) return "—";
  return n % 1 === 0 ? String(n) : n.toFixed(1);
}

// Career teams (in order of first appearance)
function careerTeams(d: any) {
  const seen = new Set<string>();
  const result: { id: string; name: string }[] = [];
  for (const s of Object.values(d.career ?? {})) {
    const id = (s as any).primaryTeamId;
    const name = (s as any).primaryTeam;
    if (id && !seen.has(id)) { seen.add(id); result.push({ id, name }); }
  }
  return result;
}
const teamsA = careerTeams(dA);
const teamsB = careerTeams(dB);

const seasonsA = Object.keys(dA.career ?? {}).length;
const seasonsB = Object.keys(dB.career ?? {}).length;

// ── Rate rows (era-fair, higher = better) ─────────────────────────────────
const rateRows = [
  {
    label: "Win %",
    aVal: pct(tA.wins ?? 0, tA.races ?? 0),
    bVal: pct(tB.wins ?? 0, tB.races ?? 0),
    aRaw: (tA.wins ?? 0) / (tA.races || 1),
    bRaw: (tB.wins ?? 0) / (tB.races || 1),
  },
  {
    label: "Podium %",
    aVal: pct(tA.podiums ?? 0, tA.races ?? 0),
    bVal: pct(tB.podiums ?? 0, tB.races ?? 0),
    aRaw: (tA.podiums ?? 0) / (tA.races || 1),
    bRaw: (tB.podiums ?? 0) / (tB.races || 1),
  },
  {
    label: "Pole %",
    aVal: pct(tA.poles ?? 0, tA.races ?? 0),
    bVal: pct(tB.poles ?? 0, tB.races ?? 0),
    aRaw: (tA.poles ?? 0) / (tA.races || 1),
    bRaw: (tB.poles ?? 0) / (tB.races || 1),
  },
];

// ── H2H cross-link ────────────────────────────────────────────────────────
const h2hSlug = [idA, idB].sort().join("-vs-");
const hasH2H = h2hSlugs.has(h2hSlug);

// ── f1δ lenses ────────────────────────────────────────────────────────────
const f1dA = (dA.f1delta ?? {}) as any;
const f1dB = (dB.f1delta ?? {}) as any;
const hasF1D = f1dA.career != null || f1dB.career != null;

const f1dRows = [
  {
    label: "Career f1δ",
    aVal: f1dA.career != null ? (f1dA.career as number).toFixed(1) : "—",
    bVal: f1dB.career != null ? (f1dB.career as number).toFixed(1) : "—",
    aRaw: f1dA.career ?? 0,
    bRaw: f1dB.career ?? 0,
  },
  {
    label: "Peak season",
    aVal: f1dA.peak != null ? `${(f1dA.peak as number).toFixed(1)} (${f1dA.peakYear})` : "—",
    bVal: f1dB.peak != null ? `${(f1dB.peak as number).toFixed(1)} (${f1dB.peakYear})` : "—",
    aRaw: f1dA.peak ?? 0,
    bRaw: f1dB.peak ?? 0,
  },
  {
    label: "Seasonal wins",
    aVal: f1dA.seasonalWins != null ? String(f1dA.seasonalWins) : "—",
    bVal: f1dB.seasonalWins != null ? String(f1dB.seasonalWins) : "—",
    aRaw: f1dA.seasonalWins ?? 0,
    bRaw: f1dB.seasonalWins ?? 0,
  },
  {
    label: "Seasonal podiums",
    aVal: f1dA.seasonalPodiums != null ? String(f1dA.seasonalPodiums) : "—",
    bVal: f1dB.seasonalPodiums != null ? String(f1dB.seasonalPodiums) : "—",
    aRaw: f1dA.seasonalPodiums ?? 0,
    bRaw: f1dB.seasonalPodiums ?? 0,
  },
  {
    label: "Longest stretch",
    aVal: f1dA.dominantStretch > 0
      ? `${f1dA.dominantStretch} · ${f1dA.stretchStart}–${f1dA.stretchEnd}`
      : f1dA.career != null ? "0" : "—",
    bVal: f1dB.dominantStretch > 0
      ? `${f1dB.dominantStretch} · ${f1dB.stretchStart}–${f1dB.stretchEnd}`
      : f1dB.career != null ? "0" : "—",
    aRaw: f1dA.dominantStretch ?? 0,
    bRaw: f1dB.dominantStretch ?? 0,
  },
];

// Season-shape strip (career-season alignment)
const stripA = (f1dA.seasons ?? []) as any[];
const stripB = (f1dB.seasons ?? []) as any[];
const stripCols = Math.max(stripA.length, stripB.length);

// ── Page meta ─────────────────────────────────────────────────────────────
const pageTitle = `${dA.name} vs ${dB.name} — f1delta`;
const pageDesc  = `Compare ${dA.name} and ${dB.name}: championships, wins, podiums, poles, and career rates.`;
const canonical = `https://f1delta.com/compare/${slug}`;
---

<BaseLayout title={pageTitle} description={pageDesc} canonical={canonical}>

  <div class="cmp">

    <!-- Header -->
    <div class="cmp-hd">
      <div class="cmp-names">
        <a class="cmp-name" href={`/drivers/${idA}`}>{dA.name}</a>
        <span class="cmp-sep">vs</span>
        <a class="cmp-name" href={`/drivers/${idB}`}>{dB.name}</a>
      </div>
      <p class="cmp-back"><a href="/compare">← Compare another pair</a></p>
    </div>

    <!-- Comparison grid -->
    <div class="card">
      <div class="table-scroll">
        <table class="cmp-tbl">
          <thead>
            <tr>
              <th class="lbl"></th>
              <th class="drv-col"><a href={`/drivers/${idA}`}>{dA.name}</a></th>
              <th class="drv-col"><a href={`/drivers/${idB}`}>{dB.name}</a></th>
            </tr>
          </thead>
          <tbody>

            <!-- ── CAREER ──────────────────────────────────────── -->
            <tr class="grp-hd"><th colspan="3">Career</th></tr>

            <!-- Championships (directional: more = better) -->
            {(() => {
              const a = tA.championships ?? 0, b = tB.championships ?? 0;
              const aWin = a > b, bWin = b > a;
              return (
                <tr>
                  <td class="lbl">Championships</td>
                  <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{a || "—"}</td>
                  <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{b || "—"}</td>
                </tr>
              );
            })()}

            <tr>
              <td class="lbl">Career span</td>
              <td class="val neutral">{dA.firstSeason}–{dA.lastSeason}</td>
              <td class="val neutral">{dB.firstSeason}–{dB.lastSeason}</td>
            </tr>
            <tr>
              <td class="lbl">Seasons</td>
              <td class="val neutral">{seasonsA}</td>
              <td class="val neutral">{seasonsB}</td>
            </tr>
            <tr>
              <td class="lbl">Race starts</td>
              <td class="val neutral">{tA.races ?? "—"}</td>
              <td class="val neutral">{tB.races ?? "—"}</td>
            </tr>
            <tr class="teams-row">
              <td class="lbl">Teams</td>
              <td class="val neutral teams">
                {teamsA.map((t, i) => (
                  <>
                    {i > 0 && <span class="tsep">, </span>}
                    <a href={`/teams/${t.id}`}>{t.name}</a>
                  </>
                ))}
              </td>
              <td class="val neutral teams">
                {teamsB.map((t, i) => (
                  <>
                    {i > 0 && <span class="tsep">, </span>}
                    <a href={`/teams/${t.id}`}>{t.name}</a>
                  </>
                ))}
              </td>
            </tr>

            <!-- ── f1δ SCORE ──────────────────────────────────── -->
            {hasF1D && (
              <>
                <tr class="grp-hd">
                  <th colspan="3">
                    f1δ Score
                    <span class="grp-note">era-fair dominance · <a href="/methodology" class="grp-link">what is this?</a></span>
                  </th>
                </tr>
                {f1dRows.map(row => {
                  const aWin = row.aRaw > row.bRaw;
                  const bWin = row.bRaw > row.aRaw;
                  return (
                    <tr>
                      <td class="lbl">{row.label}</td>
                      <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{row.aVal}</td>
                      <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{row.bVal}</td>
                    </tr>
                  );
                })}
              </>
            )}

            <!-- ── WINS & PODIUMS (era-dependent) ─────────────── -->
            <tr class="grp-hd">
              <th colspan="3">
                Wins &amp; podiums
                <span class="grp-note">era-dependent · not directly comparable across eras</span>
              </th>
            </tr>

            <tr>
              <td class="lbl">Wins</td>
              <td class="val neutral">{fmt(tA.wins)}</td>
              <td class="val neutral">{fmt(tB.wins)}</td>
            </tr>
            <tr>
              <td class="lbl">Podiums</td>
              <td class="val neutral">{fmt(tA.podiums)}</td>
              <td class="val neutral">{fmt(tB.podiums)}</td>
            </tr>
            <tr>
              <td class="lbl">Poles</td>
              <td class="val neutral">{fmt(tA.poles)}</td>
              <td class="val neutral">{fmt(tB.poles)}</td>
            </tr>
            <tr>
              <td class="lbl">Fastest laps</td>
              <td class="val neutral">{fmt(tA.fastestLaps)}</td>
              <td class="val neutral">{fmt(tB.fastestLaps)}</td>
            </tr>

            <!-- ── ERA-FAIR RATES ──────────────────────────────── -->
            <tr class="grp-hd">
              <th colspan="3">
                Era-fair rates
                <span class="grp-note">career rate · across all seasons</span>
              </th>
            </tr>

            {rateRows.map(row => {
              const aWin = row.aRaw > row.bRaw;
              const bWin = row.bRaw > row.aRaw;
              return (
                <tr>
                  <td class="lbl">{row.label}</td>
                  <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{row.aVal}</td>
                  <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{row.bVal}</td>
                </tr>
              );
            })}

            <!-- ── POINTS ──────────────────────────────────────── -->
            <tr class="grp-hd">
              <th colspan="3">
                Points
                <span class="grp-note">scoring-era variable · not directly comparable</span>
              </th>
            </tr>
            <tr>
              <td class="lbl">Career total</td>
              <td class="val neutral">{fmt(tA.points)}</td>
              <td class="val neutral">{fmt(tB.points)}</td>
            </tr>

          </tbody>
        </table>
      </div>

      {stripCols > 0 && (
        <div class="f1ds-section">
          <div class="f1ds-hd">
            <span class="f1ds-title">f1δ season shape</span>
            <span class="f1ds-hint">career-season alignment · each bar = one season</span>
          </div>
          <div class="f1ds-body">
            {([
              { drv: dA, id: idA, strip: stripA },
              { drv: dB, id: idB, strip: stripB },
            ] as { drv: any; id: string; strip: any[] }[]).map(({ drv, id, strip }) => (
              <div class="f1ds-drv">
                <a class="f1ds-dname" href={"/drivers/" + id}>{drv.name}</a>
                <div class="f1ds-bars">
                  {strip.map((s: any) => (
                    <div class="f1ds-col" title={s.year + ": " + (s.f1delta as number).toFixed(1) + " f1delta, rank " + (s.rank ?? "-")}>
                      <span class={"f1ds-rnk " + (s.rank === 1 ? "r1" : s.rank <= 3 ? "r3" : "rout")}>
                        {s.rank <= 3 ? "#" + s.rank : ""}
                      </span>
                      <div class="f1ds-bw">
                        <span class="f1ds-b" style={"height:" + (s.f1delta as number).toFixed(1) + "%"}></span>
                      </div>
                      <span class="f1ds-yr">{String(s.year).slice(2)}</span>
                    </div>
                  ))}
                  {Array.from({ length: stripCols - strip.length }).map(() => (
                    <div class="f1ds-col f1ds-phantom"></div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <F1DeltaExplain compareNote={true} />
        </div>
      )}
    </div>

    <!-- Ad slot (E2): after table, before footer links -->
    <div id="cmp-ad-slot" data-ad-slot></div>

    <!-- H2H cross-link (E1): only if they were teammates with a race-comparable pairing -->
    {hasH2H && (
      <div class="h2h-xlink">
        <span class="h2h-xlink-icon">🏎</span>
        <div>
          <strong>They shared a car.</strong>
          <a class="h2h-xlink-a" href={`/h2h/${h2hSlug}`}>See the teammate head-to-head →</a>
        </div>
      </div>
    )}

    <!-- Footer links (E1) -->
    <div class="cmp-foot">
      <a href={`/drivers/${idA}`}>{dA.name} career page →</a>
      <a href={`/drivers/${idB}`}>{dB.name} career page →</a>
    </div>

  </div>

</BaseLayout>

<style>
  .cmp {
    max-width: 680px; margin: 0 auto; padding: 0 20px 56px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .cmp-hd { padding: 28px 0 20px; }
  .cmp-names {
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap; margin-bottom: 8px;
  }
  .cmp-name {
    font-family: var(--disp);
    font-size: clamp(18px, 3.5vw, 26px); font-weight: 700;
    color: var(--red); text-decoration: none; letter-spacing: -.01em;
  }
  .cmp-name:hover { text-decoration: underline; }
  .cmp-sep {
    font-family: var(--disp); font-size: 18px;
    font-weight: 700; color: var(--faint);
  }
  .cmp-back { margin: 0; }
  .cmp-back a { font-size: 12px; color: var(--dim); text-decoration: none; }
  .cmp-back a:hover { color: var(--ink); text-decoration: underline; }

  /* ── Card ────────────────────────────────────────────────────── */
  .card {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 8px; overflow: hidden; margin-bottom: 16px;
  }
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  /* ── Table ───────────────────────────────────────────────────── */
  .cmp-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }

  .cmp-tbl thead th {
    padding: 10px 12px; text-align: left;
    font-size: 12px; font-weight: 600; color: var(--ink);
    border-bottom: 2px solid var(--line); background: var(--surface);
  }
  .cmp-tbl thead th.drv-col { text-align: right; min-width: 100px; }
  .cmp-tbl thead th a { color: var(--red); text-decoration: none; }
  .cmp-tbl thead th a:hover { text-decoration: underline; }
  .cmp-tbl thead th.lbl { width: 38%; min-width: 110px; }

  /* Group headers */
  .grp-hd th {
    padding: 8px 12px 4px; text-align: left;
    font-size: 9.5px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--faint);
    background: var(--bg); border-top: 1px solid var(--line);
  }
  .grp-hd:first-of-type th { border-top: none; }
  .grp-note {
    font-weight: 400; letter-spacing: 0; text-transform: none;
    font-size: 9.5px; color: var(--faint); margin-left: 6px;
  }

  /* Data rows */
  .cmp-tbl tbody td {
    padding: 9px 12px; border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .cmp-tbl tbody tr:last-child td { border-bottom: none; }

  td.lbl {
    text-align: left; color: var(--dim); font-size: 12px;
  }
  td.val {
    text-align: right; font-family: var(--mono);
    font-variant-numeric: tabular-nums; font-size: 13px;
  }
  td.val.neutral { color: var(--ink); }
  /* Directional highlighting (C4) */
  td.val.win  { color: var(--red); font-weight: 700; }
  td.val.lose { color: var(--dim); }

  /* Teams cell */
  td.teams { font-family: system-ui, -apple-system, sans-serif; font-size: 12px; }
  td.teams a { color: var(--ink); text-decoration: none; }
  td.teams a:hover { color: var(--red); text-decoration: underline; }
  .tsep { color: var(--faint); }

  /* ── Ad slot ─────────────────────────────────────────────────── */
  #cmp-ad-slot {
    min-height: 90px; background: var(--bg);
    border: 1px dashed var(--line); border-radius: 6px;
    margin-bottom: 16px;
  }

  /* ── H2H cross-link ──────────────────────────────────────────── */
  .h2h-xlink {
    display: flex; align-items: center; gap: 12px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 8px; padding: 14px 16px; margin-bottom: 16px;
  }
  .h2h-xlink-icon { font-size: 20px; flex-shrink: 0; }
  .h2h-xlink strong { display: block; font-size: 13px; color: var(--ink); margin-bottom: 2px; }
  .h2h-xlink-a { font-size: 13px; color: var(--red); text-decoration: none; font-weight: 600; }
  .h2h-xlink-a:hover { text-decoration: underline; }

  /* ── Footer links ────────────────────────────────────────────── */
  .cmp-foot {
    display: flex; gap: 16px; flex-wrap: wrap;
    padding-top: 4px;
  }
  .cmp-foot a { font-size: 13px; color: var(--red); text-decoration: none; font-weight: 600; }
  .cmp-foot a:hover { text-decoration: underline; }

  /* ── f1δ group header link ───────────────────────────────────── */
  .grp-link { color: var(--faint); text-decoration: none; font-weight: 400; font-size: 9.5px; }
  .grp-link:hover { color: var(--ink); text-decoration: underline; }

  /* ── f1δ season shape strip ──────────────────────────────────── */
  .f1ds-section { border-top: 2px solid var(--line); }
  .f1ds-hd {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 12px; background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .f1ds-title {
    font-size: 9.5px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--faint);
    font-family: var(--mono);
  }
  .f1ds-hint { font-family: var(--mono); font-size: 9px; color: var(--faint); }
  .f1ds-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 10px; }
  .f1ds-drv { display: flex; flex-direction: column; gap: 3px; }
  .f1ds-dname {
    font-family: var(--mono); font-size: 10px; color: var(--dim);
    font-weight: 600; text-decoration: none; letter-spacing: .02em;
  }
  .f1ds-dname:hover { color: var(--ink); }
  .f1ds-bars { display: flex; gap: 2px; width: 100%; }
  .f1ds-col {
    flex: 1 1 0; min-width: 0;
    display: flex; flex-direction: column; align-items: center; gap: 1px;
  }
  .f1ds-phantom { visibility: hidden; }
  .f1ds-rnk {
    font-family: var(--mono); font-size: 7px; height: 10px; line-height: 10px;
    white-space: nowrap;
  }
  .f1ds-rnk.r1   { color: #7a5c00; font-weight: 700; }
  .f1ds-rnk.r3   { color: var(--red); }
  .f1ds-rnk.rout { visibility: hidden; }
  .f1ds-bw {
    width: 80%; height: 44px; background: var(--line);
    border-radius: 2px; display: flex; align-items: flex-end; overflow: hidden;
  }
  .f1ds-b {
    width: 100%; background: var(--red);
    border-radius: 1px 1px 0 0; min-height: 1px;
  }
  .f1ds-yr {
    font-family: var(--mono); font-size: 7px; color: var(--faint);
    white-space: nowrap; overflow: hidden;
  }
</style>
