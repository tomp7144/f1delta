---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Compare Drivers — f1delta"
  description="Compare any two Formula 1 drivers side by side: career stats, wins, podiums, poles, and era-fair rates."
  canonical="https://f1delta.com/compare"
>
  <div class="cmp-pick">
    <div class="cmp-hero">
      <h1>Compare Drivers</h1>
      <p class="cmp-sub">Pick any two drivers to compare their career records side by side.</p>
    </div>
    <div id="cmp-app"></div>
  </div>

  <script is:inline src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>
  <script type="text/babel" is:inline>
  (function () {
    const { useState, useEffect, useRef } = React;

    let _drivers = null;
    async function loadDrivers() {
      if (_drivers) return _drivers;
      const r = await fetch("/search-index.json");
      const all = await r.json();
      _drivers = all.filter(e => e.type === "driver");
      return _drivers;
    }

    function filterDrivers(drivers, q) {
      if (!q) return [];
      const n = q.trim().toLowerCase();
      if (n.length < 1) return [];
      return drivers
        .filter(d => {
          const label = d.label.toLowerCase();
          const code  = (d.code || "").toLowerCase();
          return label.startsWith(n) ||
                 label.split(/\s+/).some(w => w.startsWith(n)) ||
                 code.startsWith(n);
        })
        .sort((a, b) => {
          const al = a.label.toLowerCase(), bl = b.label.toLowerCase();
          const as = al.startsWith(n), bs = bl.startsWith(n);
          if (as && !bs) return -1;
          if (bs && !as) return  1;
          return (b.ly || 0) - (a.ly || 0);
        })
        .slice(0, 8);
    }

    function DriverInput({ label, selected, onSelect, otherId }) {
      const [q, setQ]         = useState("");
      const [open, setOpen]   = useState(false);
      const [active, setActive] = useState(-1);
      const [drivers, setDrivers] = useState(null);
      const wrapRef = useRef(null);

      async function ensureDrivers() {
        if (drivers) return;
        const d = await loadDrivers();
        setDrivers(d);
      }

      useEffect(() => {
        function onDown(e) {
          if (wrapRef.current && !wrapRef.current.contains(e.target)) {
            setOpen(false); setActive(-1);
          }
        }
        document.addEventListener("mousedown", onDown);
        return () => document.removeEventListener("mousedown", onDown);
      }, []);

      useEffect(() => { setActive(-1); }, [q]);

      const matches = filterDrivers(drivers || [], q).filter(d => d.id !== otherId);

      function pick(d) { onSelect(d); setQ(""); setOpen(false); setActive(-1); }
      function clear() { onSelect(null); setQ(""); }

      function onKeyDown(e) {
        if (!open) return;
        if (e.key === "ArrowDown") { e.preventDefault(); setActive(i => i < matches.length - 1 ? i + 1 : 0); }
        else if (e.key === "ArrowUp") { e.preventDefault(); setActive(i => i > 0 ? i - 1 : matches.length - 1); }
        else if (e.key === "Enter" && matches.length) { e.preventDefault(); pick(active >= 0 ? matches[active] : matches[0]); }
        else if (e.key === "Escape") { setOpen(false); setActive(-1); }
      }

      return (
        <div className="di-wrap" ref={wrapRef}>
          <div className="di-label">{label}</div>
          {selected ? (
            <div className="di-sel">
              <span className="di-name">{selected.label}</span>
              <span className="di-years">{selected.fy}–{selected.ly}</span>
              <button className="di-clear" onClick={clear} aria-label="Clear">×</button>
            </div>
          ) : (
            <div className="di-box">
              <input
                type="text"
                placeholder="Search drivers…"
                value={q}
                onFocus={() => { ensureDrivers(); setOpen(true); }}
                onChange={e => { setQ(e.target.value); setOpen(true); }}
                onKeyDown={onKeyDown}
              />
              {open && matches.length > 0 && (
                <div className="di-drop">
                  {matches.map((d, i) => (
                    <button key={d.id}
                      className={"di-opt" + (i === active ? " active" : "")}
                      onMouseDown={() => pick(d)}
                      onMouseEnter={() => setActive(i)}>
                      <span className="di-opt-name">{d.label}</span>
                      <span className="di-opt-yr">{d.fy}–{d.ly}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      );
    }

    function ComparePicker() {
      const [selA, setSelA] = useState(null);
      const [selB, setSelB] = useState(null);

      const sameDriver = selA && selB && selA.id === selB.id;
      const canCompare = selA && selB && !sameDriver;

      function compare() {
        if (!canCompare) return;
        const slug = [selA.id, selB.id].sort().join("-vs-");
        window.location.href = `/compare/${slug}`;
      }

      return (
        <div className="cmp-picker">
          <div className="cmp-row">
            <DriverInput label="Driver A" selected={selA} onSelect={setSelA} otherId={selB?.id} />
            <div className="cmp-vs">vs</div>
            <DriverInput label="Driver B" selected={selB} onSelect={setSelB} otherId={selA?.id} />
          </div>
          {sameDriver && <p className="cmp-warn">Pick two different drivers.</p>}
          <div className="cmp-actions">
            <button className="cmp-btn" disabled={!canCompare} onClick={compare}>
              Compare →
            </button>
          </div>
        </div>
      );
    }

    const el = document.getElementById("cmp-app");
    if (el) ReactDOM.createRoot(el).render(<ComparePicker />);
  })();
  </script>
</BaseLayout>

<style>
  .cmp-pick {
    max-width: 680px; margin: 0 auto; padding: 0 20px 56px;
  }
  .cmp-hero {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .cmp-hero h1 {
    font-family: var(--disp);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700; letter-spacing: -.01em;
    margin: 0 0 6px; color: var(--ink);
  }
  .cmp-sub { font-size: 14px; color: var(--dim); margin: 0; }
</style>

<style is:global>
  .cmp-picker { margin-top: 8px; }
  .cmp-row {
    display: flex; align-items: flex-start; gap: 12px;
    flex-wrap: wrap;
  }
  .cmp-vs {
    font-family: var(--disp); font-weight: 700; font-size: 18px;
    color: var(--faint); padding-top: 34px; flex-shrink: 0;
  }
  .di-wrap { flex: 1; min-width: 200px; }
  .di-label {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .07em; color: var(--faint); margin-bottom: 6px;
  }
  .di-sel {
    display: flex; align-items: center; gap: 8px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 7px; padding: 10px 12px; min-height: 44px;
  }
  .di-name { font-size: 14px; font-weight: 600; color: var(--red); flex: 1; }
  .di-years { font-family: var(--mono); font-size: 11px; color: var(--faint); }
  .di-clear {
    background: none; border: none; cursor: pointer;
    font-size: 18px; color: var(--faint); padding: 0 2px; line-height: 1;
  }
  .di-clear:hover { color: var(--ink); }
  .di-box { position: relative; }
  .di-box input {
    width: 100%; box-sizing: border-box;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 14px; color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); border-radius: 7px;
    padding: 11px 13px; outline: none; transition: border-color .15s;
  }
  .di-box input:focus { border-color: var(--ink); }
  .di-box input::placeholder { color: var(--faint); }
  .di-drop {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 7px; overflow: hidden;
    box-shadow: 0 12px 32px -12px rgba(0,0,0,.22);
  }
  .di-opt {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%; padding: 9px 13px; background: none; border: none;
    cursor: pointer; text-align: left; border-bottom: 1px solid var(--line);
    gap: 8px;
  }
  .di-opt:last-child { border-bottom: none; }
  .di-opt:hover, .di-opt.active { background: var(--hover, #f0f0ed); }
  .di-opt-name { font-size: 13px; font-weight: 500; color: var(--ink); }
  .di-opt-yr { font-family: var(--mono); font-size: 10px; color: var(--faint); }
  .cmp-warn { font-size: 13px; color: var(--red); margin: 10px 0 0; }
  .cmp-actions { margin-top: 20px; }
  .cmp-btn {
    background: var(--red); color: #fff;
    border: none; border-radius: 7px; cursor: pointer;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 14px; font-weight: 600;
    padding: 11px 28px; transition: background .15s;
  }
  .cmp-btn:disabled { background: var(--line); color: var(--faint); cursor: not-allowed; }
  .cmp-btn:not(:disabled):hover { background: #b80500; }
</style>
