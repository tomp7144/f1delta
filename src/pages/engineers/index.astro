---
// src/pages/engineers/index.astro — the /engineers index. Static.
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import EngineersHub from "../../components/EngineersHub.astro";

const index = JSON.parse(fs.readFileSync(path.resolve("./data/engineers/index.json"), "utf8"));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>F1 Race Engineers | f1delta</title>
    <meta name="description" content="The race engineers behind every Formula 1 driver — current grid and historical pairings." />
    <link rel="canonical" href="https://f1delta.com/engineers" />
  </head>
  <body style="margin:0;background:#f4f4f1">
    <EngineersHub index={index} />
    <script src="/f1-records.js" defer></script>
  </body>
</html>
