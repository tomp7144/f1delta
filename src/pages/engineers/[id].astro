---
// src/pages/engineers/[id].astro — one static page per engineer.
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import EngineerPage from "../../components/EngineerPage.astro";

export function getStaticPaths() {
  const DIR = path.resolve("./data/engineers");
  const index = JSON.parse(fs.readFileSync(path.join(DIR, "index.json"), "utf8"));
  return index.engineers.map((e) => ({
    params: { id: e.id },
    props: { eng: JSON.parse(fs.readFileSync(path.join(DIR, `${e.id}.json`), "utf8")) },
  }));
}

const { eng } = Astro.props;
const displayName = eng.aka ? `${eng.name} ("${eng.aka}")` : eng.name;
const title = `${eng.name} — F1 Race Engineer | f1delta`;
const desc = `${displayName}: career pairings and history as an F1 race engineer.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={`https://f1delta.com/engineers/${eng.id}`} />
  </head>
  <body style="margin:0;background:#f4f4f1">
    <EngineerPage eng={eng} />
    <script src="/f1-records.js" defer></script>
  </body>
</html>
