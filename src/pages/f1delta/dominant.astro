---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";

const MIN_RACES = 15;

const { drivers: allDrivers } = JSON.parse(
  fs.readFileSync(path.resolve("./data/f1delta/dominant.json"), "utf8")
) as {
  drivers: {
    driverId: string; name: string; career: number;
    dominantStretch: number; stretchStart: number; stretchEnd: number;
    seasonalWins: number; seasonalPodiums: number;
    seasons: number; races: number; firstSeason: number; lastSeason: number;
  }[];
};

const drivers = allDrivers.filter((d) => d.races >= MIN_RACES && d.dominantStretch > 0);
---

<BaseLayout
  title="f1δ Score — Dominant Stretch | f1delta"
  description="Dominant stretch leaderboard: longest run of consecutive top-3 f1δ seasons. Who stayed at the top for longest?"
  canonical="https://f1delta.com/f1delta/dominant"
>
  <div class="f1d-wrap">
    <div class="f1d-head">
      <h1>f1δ Score — Dominant Stretch</h1>
      <p class="f1d-sub">Longest run of consecutive seasons ranked top-3 in f1δ among all drivers that year — who ruled their era longest. A seasonal podium mirrors a race podium; a gap year breaks the run. <a href="/methodology">How it's calculated →</a></p>
      <nav class="f1d-nav">
        <a class="f1d-tab" href="/f1delta">Career</a>
        <a class="f1d-tab" href="/f1delta/peak">Peak Season</a>
        <a class="f1d-tab active" href="/f1delta/dominant">Dominant Stretch</a>
      </nav>
    </div>

    <div class="card">
      <div class="table-scroll">
        <table data-record-table>
          <thead>
            <tr>
              <th class="l" data-sort="rank" data-type="num">#</th>
              <th class="l" data-sort="name" data-type="text">Driver</th>
              <th data-sort="stretch" data-type="num">Stretch</th>
              <th class="l" data-sort="span" data-type="text">Span</th>
              <th data-sort="podiums" data-type="num">Season Podiums</th>
              <th data-sort="career" data-type="num">Career f1δ</th>
            </tr>
          </thead>
          <tbody>
            {drivers.map((d, i) => (
              <tr
                data-rank={i + 1}
                data-name={d.name}
                data-stretch={d.dominantStretch}
                data-span={`${d.stretchStart}–${d.stretchEnd}`}
                data-podiums={d.seasonalPodiums}
                data-career={d.career}
              >
                <td class="rk">{i + 1}</td>
                <td class="nm"><a href={`/drivers/${d.driverId}`}>{d.name}</a></td>
                <td class="sc">{d.dominantStretch}</td>
                <td class="sp">{d.stretchStart === d.stretchEnd ? d.stretchStart : `${d.stretchStart}–${d.stretchEnd}`}</td>
                <td class="n">{d.seasonalPodiums}</td>
                <td class="n">{d.career.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tbl-note">Minimum {MIN_RACES} race starts · Sorted by stretch length, tiebreak: season podiums, career f1δ · Indy 500 excluded</p>
    </div>
  </div>

  <script src="/f1-records.js" defer is:inline></script>
</BaseLayout>

<style>
  .f1d-wrap {
    max-width: 760px; margin: 0 auto; padding: 0 20px 56px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .f1d-head {
    background: var(--surface); border-bottom: 1px solid var(--line);
    margin: 0 -20px 20px; padding: 32px 20px 0;
  }
  .f1d-head h1 {
    font-family: var(--disp);
    font-size: clamp(22px, 4vw, 36px); font-weight: 700;
    letter-spacing: -.01em; margin: 0 0 8px; color: var(--ink);
  }
  .f1d-sub { font-size: 13px; color: var(--dim); margin: 0 0 20px; line-height: 1.5; }
  .f1d-sub a { color: var(--red); text-decoration: none; font-weight: 600; }
  .f1d-sub a:hover { text-decoration: underline; }

  .f1d-nav {
    display: flex; gap: 0; border-top: 1px solid var(--line);
  }
  .f1d-tab {
    font-family: var(--mono); font-size: 11px; font-weight: 600;
    text-decoration: none; color: var(--dim);
    padding: 9px 14px; border-bottom: 2px solid transparent;
    letter-spacing: .03em;
  }
  .f1d-tab:hover { color: var(--ink); }
  .f1d-tab.active { color: var(--red); border-bottom-color: var(--red); }

  .card {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 8px; overflow: hidden;
  }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead th {
    font-family: var(--mono);
    font-size: 10px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--faint);
    text-align: right; padding: 9px 10px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap; cursor: pointer; user-select: none;
  }
  thead th.l { text-align: left; }
  tbody td {
    font-variant-numeric: tabular-nums;
    padding: 8px 10px; border-bottom: 1px solid var(--line2, #f0f0ed);
    text-align: right; color: var(--dim); white-space: nowrap;
  }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: var(--hover, #f4f4f1); }
  td.rk  { text-align: left; font-family: var(--mono); font-size: 11px; color: var(--faint); width: 36px; }
  td.nm  { text-align: left; font-weight: 600; color: var(--ink); }
  td.nm a { color: var(--ink); text-decoration: none; }
  td.nm a:hover { text-decoration: underline; }
  td.sc  { color: var(--ink); font-weight: 700; font-family: var(--mono); font-size: 14px; }
  td.sp  { text-align: left; font-family: var(--mono); font-size: 11px; color: var(--dim); }
  td.n   { font-family: var(--mono); }
  .tbl-note {
    font-size: 11px; color: var(--faint); padding: 8px 12px 10px;
    margin: 0; border-top: 1px solid var(--line); line-height: 1.5;
  }

  @media (max-width: 500px) {
    .f1d-wrap  { padding-left: 12px; padding-right: 12px; }
    .f1d-head  { margin-left: -12px; margin-right: -12px; padding-left: 12px; padding-right: 12px; }
  }
</style>
