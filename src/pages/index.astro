---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

// ── Fantasy data ──────────────────────────────────────────────────────
let players: any   = null;
let raceSummaries: any   = {};
let races2026: any[]     = [];
let gpNames: Map<string, string> = new Map();

try { players = JSON.parse(fs.readFileSync(path.resolve("./data/fantasy/players.json"), "utf8")); } catch {}
try { raceSummaries = JSON.parse(fs.readFileSync(path.resolve("./public/fantasy/race-summaries.json"), "utf8")); } catch {}
try {
  const allRaces = JSON.parse(fs.readFileSync(path.resolve("./data/f1db/f1db-races.json"), "utf8"));
  races2026 = allRaces.filter((r: any) => r.year === 2026);
  const gps = JSON.parse(fs.readFileSync(path.resolve("./data/f1db/f1db-grands-prix.json"), "utf8"));
  for (const g of gps) gpNames.set(g.id, g.shortName ?? g.name);
} catch {}

// ── f1δ leaderboard: top 5 drivers by cumulative points ──────────────
const ldrTop5: { name: string; pageId: string; points: number }[] = players
  ? (players.assets as any[])
      .filter((a: any) => a.type === "driver" && (a.points ?? 0) > 0)
      .sort((a: any, b: any) => b.points - a.points)
      .slice(0, 5)
      .map((a: any) => ({ name: a.name, pageId: a.pageId, points: a.points }))
  : [];

const race2026Ids = new Set(races2026.map((r: any) => r.id));
const latestF1dRaceId = Object.keys(raceSummaries)
  .map(Number)
  .filter(id => race2026Ids.has(id))
  .sort((a, b) => b - a)[0] ?? null;
const latestF1dRace = latestF1dRaceId ? races2026.find((r: any) => r.id === latestF1dRaceId) : null;
const latestF1dGpName = latestF1dRace ? (gpNames.get(latestF1dRace.grandPrixId) ?? latestF1dRace.grandPrixId) : null;

// ── Hero pool: all 100+ race drivers with connection threads ──────────
type Thread = { rel: string; label: string; url: string; meta: string };
type Hero = { id: string; name: string; url: string; era: string; races: number; wins: number; threads: Thread[] };

let heroPool: Hero[] = [];
try {
  const byDriver: Record<string, any> = (() => {
    try { return JSON.parse(fs.readFileSync(path.resolve("./data/people/by-driver.json"), "utf8")); }
    catch { return {}; }
  })();
  const driverIdx: any[] = JSON.parse(
    fs.readFileSync(path.resolve("./data/drivers/index.json"), "utf8")
  ).drivers;

  for (const entry of driverIdx.filter((d: any) => (d.races ?? 0) >= 100)) {
    try {
      const d: any = JSON.parse(
        fs.readFileSync(path.resolve(`./data/drivers/${entry.driverId}.json`), "utf8")
      );
      const threads: Thread[] = [];

      // Top 2 teammates by seasons shared
      const mates: any[] = (d.teammates || []).slice().sort(
        (a: any, b: any) => (b.seasonsShared?.length ?? 0) - (a.seasonsShared?.length ?? 0)
      );
      for (const m of mates.slice(0, 2)) {
        const n = m.seasonsShared?.length ?? 1;
        threads.push({
          rel: "Teammate",
          label: m.teammate,
          url: `/h2h/${[entry.driverId, m.teammateId].sort().join("-vs-")}`,
          meta: n + (n === 1 ? " season" : " seasons"),
        });
      }

      // Top 2 career teams by seasons
      const teamSeas = new Map<string, { name: string; n: number }>();
      for (const s of d.career || []) {
        const t = s.teams?.[0];
        if (!t) continue;
        const prev = teamSeas.get(t.constructorId);
        if (prev) prev.n++;
        else teamSeas.set(t.constructorId, { name: t.constructor, n: 1 });
      }
      for (const [cid, { name, n }] of [...teamSeas.entries()]
        .sort((a, b) => b[1].n - a[1].n)
        .slice(0, 2)) {
        threads.push({
          rel: "Team",
          label: name,
          url: `/teams/${cid}`,
          meta: n + (n === 1 ? " season" : " seasons"),
        });
      }

      // Race engineer (if known)
      const eng = byDriver[entry.driverId];
      if (eng?.current) {
        threads.push({
          rel: "Engineer",
          label: eng.current.personName,
          url: `/people/${eng.current.personId}`,
          meta: String(eng.current.fromYear) + "–",
        });
      } else if (eng?.past?.[0]) {
        const e = eng.past[0];
        threads.push({
          rel: "Engineer",
          label: e.personName,
          url: `/people/${e.personId}`,
          meta: (e.fromYear ?? "") + "–" + (e.toYear ?? ""),
        });
      }

      if (threads.length < 2) continue;

      heroPool.push({
        id: entry.driverId,
        name: entry.name,
        url: `/drivers/${entry.driverId}`,
        era:
          entry.firstSeason === entry.lastSeason
            ? String(entry.firstSeason)
            : `${entry.firstSeason}–${entry.lastSeason}`,
        races: entry.races,
        wins: entry.wins ?? 0,
        threads: threads.slice(0, 4),
      });
    } catch {}
  }
} catch {}

// ── Build-time trivia question (changes per deploy) ───────────────────
type TriviaQ = {
  chain: string;
  answerId: string;
  answerName: string;
  options: { id: string; name: string }[];
};
let triviaQ: TriviaQ | null = null;
try {
  const td: any = JSON.parse(fs.readFileSync(path.resolve("./public/trivia.json"), "utf8"));
  const easy: any[] = td.drivers.filter(
    (d: any) => (d.races ?? 0) >= 100 && (d.chain?.length ?? 0) >= 2
  );
  if (easy.length >= 4) {
    const ai = Math.floor(Math.random() * easy.length);
    const answer = easy[ai];
    const decoys = easy
      .filter((_: any, i: number) => i !== ai)
      .sort(() => Math.random() - 0.5)
      .slice(0, 3);
    triviaQ = {
      chain: answer.chain.join(" → "),
      answerId: answer.id,
      answerName: answer.name,
      options: [answer, ...decoys]
        .sort(() => Math.random() - 0.5)
        .map((d: any) => ({ id: d.id, name: d.name })),
    };
  }
} catch {}
---

<BaseLayout
  title="f1delta — F1 Statistics & History"
  description="Formula 1 statistics and history from 1950 to today. Driver records, team histories, season standings, and circuit data."
  canonical="https://f1delta.com/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="home">

    <!-- ── Box grid ─────────────────────────────────────────────────── -->
    <div class="hgrid">

      <!-- Hero tile: random driver, filled by JS -->
      <div class="tile tile-hero" id="hero-tile">
        <div class="tile-hd">
          <span class="tile-label">Featured</span>
        </div>
        <div class="hero-loading">Loading…</div>
      </div>

      <!-- Results tile: last race from OpenF1 bake, filled by React -->
      <div class="tile tile-results" id="res-tile">
        <div class="tile-hd">
          <span class="tile-label">Last result</span>
        </div>
      </div>

      <!-- Trivia tile: build-time question, vanilla JS handles interaction -->
      <div class="tile tile-trivia">
        <div class="tile-hd">
          <span class="tile-label">Trivia</span>
          <a class="tile-more" href="/trivia">Full game →</a>
        </div>
        {triviaQ ? (
          <div class="triv-body">
            <p class="triv-prompt">Guess the driver by their team chain:</p>
            <p class="triv-chain">{triviaQ.chain}</p>
            <div class="triv-opts" id="triv-opts">
              {triviaQ.options.map(opt => (
                <button class="triv-opt" data-id={opt.id}>{opt.name}</button>
              ))}
            </div>
            <div class="triv-result" id="triv-result" style="display:none"></div>
            <a class="triv-more" id="triv-more" href="/trivia" style="display:none">Play more →</a>
          </div>
        ) : (
          <div class="triv-body">
            <p class="triv-prompt">Chain-based driver guessing game.</p>
            <a class="triv-more" href="/trivia">Play now →</a>
          </div>
        )}
      </div>

      <!-- Compare tile: compact picker, filled by React -->
      <div class="tile tile-cmp">
        <div class="tile-hd">
          <span class="tile-label">Compare</span>
          <a class="tile-more" href="/compare/lewis-hamilton-vs-max-verstappen">example →</a>
        </div>
        <div id="cmp-tile-inner"></div>
      </div>

      <!-- f1δ leaderboard tile: static from fantasy data -->
      <div class="tile tile-ldr">
        <div class="tile-hd">
          <span class="tile-label">f1δ 2026</span>
          <a class="tile-more" href="/fantasy">Full →</a>
        </div>
        {ldrTop5.length > 0 ? (
          <ol class="ldr-list">
            {ldrTop5.map((d, i) => (
              <li class="ldr-row">
                <span class="ldr-pos">{i + 1}</span>
                <a class="ldr-name" href={`/drivers/${d.pageId}`}>{d.name}</a>
                <span class="ldr-pts">{d.points}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="ldr-empty">No data yet.</p>
        )}
        {latestF1dGpName && (
          <p class="ldr-note">Latest: {latestF1dGpName}</p>
        )}
      </div>

      <!-- Editorial slot: reserved for future /stories content -->
      <div class="tile tile-ed">
        <div class="tile-hd">
          <span class="tile-label">Stories</span>
        </div>
        <p class="ed-coming">In-depth features and analysis coming soon.</p>
        <a class="ed-link" href="/about">About f1delta →</a>
      </div>

    </div><!-- /.hgrid -->

    <!-- ── Nav tiles ─────────────────────────────────────────────────── -->
    <section class="nav-grid">
      <a class="nav-tile" href="/standings"><span class="nt-label">Seasons</span><span class="nt-desc">WDC &amp; WCC standings, 1950–today</span></a>
      <a class="nav-tile" href="/drivers"><span class="nt-label">Drivers</span><span class="nt-desc">Career stats for every F1 driver</span></a>
      <a class="nav-tile" href="/teams"><span class="nt-label">Teams</span><span class="nt-desc">Constructor histories &amp; records</span></a>
      <a class="nav-tile" href="/grands-prix"><span class="nt-label">Grands Prix</span><span class="nt-desc">All races by event, with winners</span></a>
      <a class="nav-tile" href="/circuits"><span class="nt-label">Circuits</span><span class="nt-desc">Track histories &amp; statistics</span></a>
      <a class="nav-tile" href="/records"><span class="nt-label">Records</span><span class="nt-desc">All-time leaders across every category</span></a>
      <a class="nav-tile" href="/fantasy"><span class="nt-label">Fantasy</span><span class="nt-desc">Price tracker, PPM &amp; f1δ scores</span></a>
      <a class="nav-tile" href="/engineers"><span class="nt-label">Engineers</span><span class="nt-desc">Pitwall pairings, 1950–now</span></a>
    </section>

  </div><!-- /.home -->

  <!-- CDN scripts for React + Babel -->
  <script is:inline src="/grid-map.js"></script>
  <script is:inline src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>

  <!-- React: results card + compare picker -->
  <script type="text/babel" is:inline>
  (function () {
    const { useState, useEffect, useRef } = React;

    async function loadLatest() {
      try { const r = await fetch("/latest-race.json"); if (!r.ok) return null; return await r.json(); }
      catch { return null; }
    }

    // ── Results card ───────────────────────────────────────────────────
    function ResultsCard() {
      const [data, setData] = useState(null);
      const [loaded, setLoaded] = useState(false);
      const codeMap = window.F1_GRID || {};

      useEffect(() => {
        let alive = true;
        loadLatest().then(d => { if (alive) { setData(d); setLoaded(true); } });
        return () => { alive = false; };
      }, []);

      if (!loaded) return null;
      if (!data || !data.tower) return (
        <div className="h-empty">No result yet.</div>
      );

      return (
        <>
          <div className="res-hd">
            <span className="res-name">{data.session?.name || "Latest result"}</span>
            <span className="res-rnd">Rd {data.session?.round}</span>
          </div>
          <div className="h-card">
            <table>
              <thead>
                <tr>
                  <th className="l">P</th>
                  <th className="l">Driver</th>
                  <th>Gap</th>
                  <th>Pts</th>
                </tr>
              </thead>
              <tbody>
                {data.tower.map((r) => {
                  const slug = codeMap[(r.code || "").toUpperCase()];
                  const isDnf = r.dnf || r.position == null;
                  return (
                    <tr key={r.code}
                      className={slug ? "clik" : ""}
                      onClick={slug ? () => { window.location.href = `/drivers/${slug}`; } : undefined}>
                      <td className={"pos" + (isDnf ? " dnf" : "")}>{isDnf ? "—" : r.position}</td>
                      <td className="drv">
                        <span className="dot" style={{ background: r.teamColour || "#9aa0ab" }} />
                        <span className="cc">{r.code}</span>
                      </td>
                      <td className={"gap" + (r.leader ? " lead" : "")}>{r.leader ? "LEAD" : String(r.gap || "")}</td>
                      <td className={"pts" + (r.points > 0 ? "" : " zero")}>{r.points > 0 ? `+${r.points}` : "0"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      );
    }

    // ── Compare picker ─────────────────────────────────────────────────
    let _drivers = null;
    async function loadDrivers() {
      if (_drivers) return _drivers;
      const r = await fetch("/search-index.json");
      const all = await r.json();
      _drivers = all.filter(e => e.type === "driver");
      return _drivers;
    }
    function filterDrivers(drivers, q) {
      if (!q) return [];
      const n = q.trim().toLowerCase();
      if (n.length < 1) return [];
      return drivers
        .filter(d => {
          const label = d.label.toLowerCase();
          const code  = (d.code || "").toLowerCase();
          return label.startsWith(n) ||
                 label.split(/\s+/).some(w => w.startsWith(n)) ||
                 code.startsWith(n);
        })
        .sort((a, b) => {
          const al = a.label.toLowerCase(), bl = b.label.toLowerCase();
          const as = al.startsWith(n), bs = bl.startsWith(n);
          if (as && !bs) return -1;
          if (bs && !as) return  1;
          return (b.ly || 0) - (a.ly || 0);
        })
        .slice(0, 8);
    }
    function DriverInput({ label, selected, onSelect, otherId }) {
      const [q, setQ]           = useState("");
      const [open, setOpen]     = useState(false);
      const [active, setActive] = useState(-1);
      const [drivers, setDrivers] = useState(null);
      const wrapRef = useRef(null);
      async function ensureDrivers() {
        if (drivers) return;
        const d = await loadDrivers();
        setDrivers(d);
      }
      useEffect(() => {
        function onDown(e) {
          if (wrapRef.current && !wrapRef.current.contains(e.target)) {
            setOpen(false); setActive(-1);
          }
        }
        document.addEventListener("mousedown", onDown);
        return () => document.removeEventListener("mousedown", onDown);
      }, []);
      useEffect(() => { setActive(-1); }, [q]);
      const matches = filterDrivers(drivers || [], q).filter(d => d.id !== otherId);
      function pick(d) { onSelect(d); setQ(""); setOpen(false); setActive(-1); }
      function clear() { onSelect(null); setQ(""); }
      function onKeyDown(e) {
        if (!open) return;
        if (e.key === "ArrowDown") { e.preventDefault(); setActive(i => i < matches.length - 1 ? i + 1 : 0); }
        else if (e.key === "ArrowUp") { e.preventDefault(); setActive(i => i > 0 ? i - 1 : matches.length - 1); }
        else if (e.key === "Enter" && matches.length) { e.preventDefault(); pick(active >= 0 ? matches[active] : matches[0]); }
        else if (e.key === "Escape") { setOpen(false); setActive(-1); }
      }
      return (
        <div className="di-wrap" ref={wrapRef}>
          <div className="di-label">{label}</div>
          {selected ? (
            <div className="di-sel">
              <span className="di-name">{selected.label}</span>
              <span className="di-years">{selected.fy}–{selected.ly}</span>
              <button className="di-clear" onClick={clear} aria-label="Clear">&times;</button>
            </div>
          ) : (
            <div className="di-box">
              <input
                type="text"
                placeholder="Search drivers…"
                value={q}
                onFocus={() => { ensureDrivers(); setOpen(true); }}
                onChange={e => { setQ(e.target.value); setOpen(true); }}
                onKeyDown={onKeyDown}
              />
              {open && matches.length > 0 && (
                <div className="di-drop">
                  {matches.map((d, i) => (
                    <button key={d.id}
                      className={"di-opt" + (i === active ? " active" : "")}
                      onMouseDown={() => pick(d)}
                      onMouseEnter={() => setActive(i)}>
                      <span className="di-opt-name">{d.label}</span>
                      <span className="di-opt-yr">{d.fy}–{d.ly}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      );
    }
    function ComparePicker() {
      const [selA, setSelA] = useState(null);
      const [selB, setSelB] = useState(null);
      const sameDriver = selA && selB && selA.id === selB.id;
      const canCompare = selA && selB && !sameDriver;
      function compare() {
        if (!canCompare) return;
        const slug = [selA.id, selB.id].sort().join("-vs-");
        window.location.href = `/compare/${slug}`;
      }
      return (
        <div className="cmp-picker">
          <div className="cmp-row">
            <DriverInput label="Driver A" selected={selA} onSelect={setSelA} otherId={selB?.id} />
            <DriverInput label="Driver B" selected={selB} onSelect={setSelB} otherId={selA?.id} />
          </div>
          {sameDriver && <p className="cmp-warn">Pick two different drivers.</p>}
          <div className="cmp-actions">
            <button className="cmp-btn" disabled={!canCompare} onClick={compare}>
              Compare →
            </button>
          </div>
        </div>
      );
    }

    // ── Mount ──────────────────────────────────────────────────────────
    const resTile = document.getElementById("res-tile");
    if (resTile) ReactDOM.createRoot(resTile).render(
      React.createElement(React.Fragment, null,
        React.createElement("div", { className: "tile-hd" },
          React.createElement("span", { className: "tile-label" }, "Last result")
        ),
        React.createElement(ResultsCard)
      )
    );
    const cmpTile = document.getElementById("cmp-tile-inner");
    if (cmpTile) ReactDOM.createRoot(cmpTile).render(<ComparePicker />);
  })();
  </script>

  <!-- Vanilla JS: hero selection + trivia interaction -->
  <script is:inline define:vars={{ heroPool, triviaQ }}>
  (function () {
    // ── Hero tile ──────────────────────────────────────────────────────
    var pool = heroPool;
    var heroTile = document.getElementById("hero-tile");

    if (pool && pool.length && heroTile) {
      var lastIdx = -1;

      function pickIdx() {
        if (pool.length === 1) return 0;
        var idx;
        do { idx = Math.floor(Math.random() * pool.length); } while (idx === lastIdx);
        lastIdx = idx;
        return idx;
      }

      function renderHero() {
        var h = pool[pickIdx()];
        var sub = "Driver · " + h.era + " · " + h.races + " races"
          + (h.wins > 0 ? " · " + h.wins + (h.wins === 1 ? " win" : " wins") : "");

        var threadsHtml = h.threads.map(function (t) {
          return '<a href="' + t.url + '" class="thread">'
            + '<span class="thread-rel">' + t.rel + '</span>'
            + '<span class="thread-label">' + t.label + '</span>'
            + '<span class="thread-meta">' + t.meta + '</span>'
            + '</a>';
        }).join("");

        heroTile.innerHTML =
          '<div class="tile-hd">'
          + '<span class="tile-label">Featured driver</span>'
          + '<button class="hero-reroll" id="hero-reroll">different person</button>'
          + '</div>'
          + '<div class="hero-body">'
          + '<a href="' + h.url + '" class="hero-name">' + h.name + '</a>'
          + '<div class="hero-sub">' + sub + '</div>'
          + '<div class="hero-threads">' + threadsHtml + '</div>'
          + '</div>';

        var btn = document.getElementById("hero-reroll");
        if (btn) btn.addEventListener("click", renderHero);
      }

      renderHero();
    }

    // ── Trivia teaser ──────────────────────────────────────────────────
    var TQ = triviaQ;
    var optsEl = document.getElementById("triv-opts");
    var resultEl = document.getElementById("triv-result");
    var moreEl = document.getElementById("triv-more");

    if (TQ && optsEl) {
      optsEl.querySelectorAll(".triv-opt").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var isCorrect = btn.dataset.id === TQ.answerId;
          optsEl.querySelectorAll(".triv-opt").forEach(function (b) {
            b.disabled = true;
            if (b.dataset.id === TQ.answerId) b.classList.add("correct");
            else if (b === btn && !isCorrect) b.classList.add("wrong");
          });
          if (resultEl) {
            resultEl.textContent = isCorrect
              ? "Correct! That's " + TQ.answerName + "."
              : "Not quite — it was " + TQ.answerName + ".";
            resultEl.className = "triv-result " + (isCorrect ? "ok" : "no");
            resultEl.style.display = "block";
          }
          if (moreEl) moreEl.style.display = "inline";
        });
      });
    }
  })();
  </script>

</BaseLayout>

<style>
  .home {
    max-width: 760px; margin: 0 auto; padding: 0 20px 56px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
  }

  /* ── Box grid ──────────────────────────────────────────────────────── */
  .hgrid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: auto auto auto;   /* 3 explicit rows; -1 = line 4 */
    gap: 10px;
    margin-bottom: 24px;
  }
  .tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
    min-width: 0;
    overflow: hidden;
  }
  /* Results pins to right 2 cols, spans all 3 rows (grid-row 1/-1).
     The other tiles fill the left 4 cols row-by-row — no gap beside results. */
  .tile-hero    { grid-column: 1 / 5; grid-row: 1; }
  .tile-results { grid-column: 5 / 7; grid-row: 1 / -1; padding: 0; overflow: hidden; }
  .tile-trivia  { grid-column: 1 / 3; grid-row: 2; }
  .tile-cmp     { grid-column: 3 / 5; grid-row: 2; }
  .tile-ldr     { grid-column: 1 / 3; grid-row: 3; }
  .tile-ed      { grid-column: 3 / 5; grid-row: 3; }

  /* ── Tile header ──────────────────────────────────────────────────────
     :global — tile-hd/tile-label are re-created inside heroTile.innerHTML
     at runtime, so injected elements never carry the Astro CID attribute. */
  :global(.tile-hd) {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 12px;
  }
  :global(.tile-label) {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: var(--faint);
  }
  .tile-more {
    font-size: 11px; color: var(--dim); text-decoration: none;
    font-family: var(--mono);
  }
  .tile-more:hover { color: var(--ink); text-decoration: underline; }

  /* ── Hero tile ─────────────────────────────────────────────────────────
     :global — all hero + thread classes are injected via heroTile.innerHTML
     at runtime and never receive the Astro CID attribute. */
  .hero-loading { font-size: 13px; color: var(--faint); }
  :global(.hero-body)    { display: flex; flex-direction: column; gap: 6px; }
  :global(.hero-name) {
    font-family: var(--disp);
    font-weight: 700; font-size: clamp(22px, 4vw, 34px);
    letter-spacing: -.01em; line-height: 1.1;
    color: var(--ink); text-decoration: none;
  }
  :global(.hero-name:hover) { color: var(--red); }
  :global(.hero-sub) {
    font-size: 12px; color: var(--dim); font-family: var(--mono);
    margin-bottom: 6px;
  }
  :global(.hero-reroll) {
    font-size: 11px; color: var(--dim); background: none; border: none;
    cursor: pointer; padding: 0; font-family: var(--mono);
    text-decoration: underline; text-underline-offset: 2px;
  }
  :global(.hero-reroll:hover) { color: var(--ink); }
  :global(.hero-threads) { display: flex; flex-direction: column; gap: 1px; }
  :global(.thread) {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: 8px; align-items: baseline;
    padding: 7px 10px; margin: 0 -10px;
    text-decoration: none; color: var(--ink);
    border-radius: 4px;
  }
  :global(.thread:hover) { background: var(--bg); }
  :global(.thread-rel) {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .06em; color: var(--faint); flex-shrink: 0;
  }
  :global(.thread-label) { font-size: 13px; font-weight: 500; color: var(--ink); }
  :global(.thread-meta)  {
    font-size: 11px; color: var(--dim); font-family: var(--mono);
    white-space: nowrap; flex-shrink: 0;
  }

  /* ── Trivia tile ────────────────────────────────────────────────────── */
  .triv-body    { display: flex; flex-direction: column; gap: 8px; }
  .triv-prompt  { font-size: 12px; color: var(--dim); margin: 0; }
  .triv-chain   {
    font-size: 13px; font-weight: 500; color: var(--ink);
    line-height: 1.5; margin: 0;
  }
  .triv-opts    { display: flex; flex-direction: column; gap: 5px; margin-top: 4px; }
  .triv-opt {
    text-align: left; background: var(--bg); border: 1px solid var(--line);
    border-radius: 5px; padding: 8px 12px; font-size: 13px; font-weight: 500;
    color: var(--ink); cursor: pointer; transition: border-color .1s;
  }
  .triv-opt:hover:not(:disabled) { border-color: var(--dim); }
  .triv-opt:disabled { cursor: default; }
  .triv-opt.correct { background: #e8f5e9; border-color: #2e7d32; color: #1a5f33; }
  .triv-opt.wrong   { background: #fdecea; border-color: #c0392b; color: #922b21; }
  .triv-result {
    font-size: 13px; font-weight: 500; padding: 6px 10px;
    border-radius: 5px; margin-top: 2px;
  }
  .triv-result.ok { background: #e8f5e9; color: #1a5f33; }
  .triv-result.no { background: #fdecea; color: #922b21; }
  .triv-more {
    font-size: 12px; color: var(--red); text-decoration: none; font-weight: 600;
  }
  .triv-more:hover { text-decoration: underline; }

  /* ── f1δ leaderboard tile ───────────────────────────────────────────── */
  .ldr-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .ldr-row  {
    display: grid; grid-template-columns: 18px 1fr auto;
    gap: 8px; align-items: baseline;
    padding: 6px 0; border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .ldr-row:last-child { border-bottom: none; }
  .ldr-pos  { font-size: 11px; color: var(--faint); font-family: var(--mono); text-align: right; }
  .ldr-name { color: var(--ink); text-decoration: none; font-weight: 500; }
  .ldr-name:hover { text-decoration: underline; }
  .ldr-pts  { font-family: var(--mono); font-size: 12px; color: var(--dim); font-variant-numeric: tabular-nums; }
  .ldr-empty { font-size: 13px; color: var(--faint); margin: 0; }
  .ldr-note  { font-size: 11px; color: var(--faint); margin: 10px 0 0; font-style: italic; }

  /* ── Editorial slot ─────────────────────────────────────────────────── */
  .tile-ed { display: flex; align-items: center; gap: 16px; }
  .tile-ed .tile-hd { margin-bottom: 0; flex-shrink: 0; }
  .ed-coming { font-size: 13px; color: var(--dim); margin: 0; flex: 1; }
  .ed-link   { font-size: 12px; color: var(--dim); text-decoration: none; flex-shrink: 0; white-space: nowrap; }
  .ed-link:hover { color: var(--ink); text-decoration: underline; }

  /* ── Nav grid ───────────────────────────────────────────────────────── */
  .nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
  }
  .nav-tile {
    background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
    padding: 14px 16px; text-decoration: none; color: var(--ink);
    display: flex; flex-direction: column; gap: 3px;
    transition: border-color .1s;
  }
  .nav-tile:hover { border-color: var(--ink); }
  .nt-label { font-size: 14px; font-weight: 600; }
  .nt-desc  { font-size: 12px; color: var(--dim); }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  /* Medium (~481-640px): results stays pinned right, left compresses to 2 cols */
  @media (max-width: 640px) {
    .hgrid {
      grid-template-columns: 1fr 1fr 180px;
      grid-template-rows: auto auto auto;
    }
    .tile-hero    { grid-column: 1 / 3; grid-row: 1; }
    .tile-results { grid-column: 3;     grid-row: 1 / -1; }
    .tile-trivia  { grid-column: 1;     grid-row: 2; }
    .tile-cmp     { grid-column: 2;     grid-row: 2; }
    .tile-ldr     { grid-column: 1;     grid-row: 3; }
    .tile-ed      { grid-column: 2;     grid-row: 3; }
  }
  /* Mobile (~≤480px): single column, tiles stack hero → results → trivia → … */
  @media (max-width: 480px) {
    .hgrid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .tile-hero, .tile-results, .tile-trivia, .tile-cmp, .tile-ldr, .tile-ed {
      grid-column: 1; grid-row: auto;
    }
    .tile-ed { flex-direction: column; align-items: flex-start; gap: 6px; }
  }
  @media (max-width: 500px) {
    .home { padding-left: 12px; padding-right: 12px; }
    .nav-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

