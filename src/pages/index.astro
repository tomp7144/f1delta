---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

// ── Read live fantasy data at build time ──────────────────────────────────────
let players: any   = null;
let prices: any    = null;
let raceSummaries: any   = {};
let races2026: any[]     = [];
let gpNames: Map<string, string> = new Map();

try { players      = JSON.parse(fs.readFileSync(path.resolve("./data/fantasy/players.json"), "utf8")); } catch {}
try { prices       = JSON.parse(fs.readFileSync(path.resolve("./data/fantasy/prices.source.json"), "utf8")); } catch {}
try { raceSummaries = JSON.parse(fs.readFileSync(path.resolve("./public/fantasy/race-summaries.json"), "utf8")); } catch {}
try {
  const allRaces = JSON.parse(fs.readFileSync(path.resolve("./data/f1db/f1db-races.json"), "utf8"));
  races2026 = allRaces.filter((r: any) => r.year === 2026);
  const gps = JSON.parse(fs.readFileSync(path.resolve("./data/f1db/f1db-grands-prix.json"), "utf8"));
  for (const g of gps) gpNames.set(g.id, g.shortName ?? g.name);
} catch {}

// ── Top value by PPM (drivers only) ──────────────────────────────────────────
const topPPM: { name: string; pageId: string; team: string; price: number; ppm: number }[] = [];
if (players) {
  players.assets
    .filter((a: any) => a.type === "driver" && a.price > 0 && a.points > 0)
    .map((a: any) => ({
      name: a.name, pageId: a.pageId, team: a.team, price: a.price,
      ppm: Math.round((a.points / a.price) * 10) / 10,
    }))
    .sort((a: any, b: any) => b.ppm - a.ppm)
    .slice(0, 3)
    .forEach((d: any) => topPPM.push(d));
}

// ── Price movers (last two rounds from prices.source.json) ───────────────────
const nameToAsset = new Map<string, { pageId: string; type: string }>();
if (players) {
  for (const a of players.assets) {
    nameToAsset.set((a.name || "").toLowerCase(), { pageId: a.pageId, type: a.type });
  }
}
const movers: { name: string; pageId: string | null; type: string | null; price: number; delta: number }[] = [];
if (prices) {
  for (const [, rounds] of Object.entries(prices) as [string, any][]) {
    const ks = Object.keys(rounds).map(Number).sort((a, b) => a - b);
    if (ks.length < 2) continue;
    const last = rounds[String(ks[ks.length - 1])];
    const prev = rounds[String(ks[ks.length - 2])];
    const delta = Math.round(((last.price ?? 0) - (prev.price ?? 0)) * 10) / 10;
    if (delta === 0) continue;
    const lk = nameToAsset.get((last.name || "").toLowerCase());
    movers.push({ name: last.name, pageId: lk?.pageId ?? null, type: lk?.type ?? null, price: last.price, delta });
  }
}
movers.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta));
const risers = movers.filter(m => m.delta > 0).slice(0, 2);
const fallers = movers.filter(m => m.delta < 0).slice(0, 2);

// ── Latest f1δ race (2026 races that have results) ────────────────────────────
const race2026Ids = new Set(races2026.map((r: any) => r.id));
const latestF1dRaceId = Object.keys(raceSummaries)
  .map(Number)
  .filter(id => race2026Ids.has(id))
  .sort((a, b) => b - a)[0] ?? null;
const latestF1dSummary = latestF1dRaceId ? raceSummaries[String(latestF1dRaceId)] : null;
const latestF1dRace    = latestF1dRaceId ? races2026.find((r: any) => r.id === latestF1dRaceId) : null;
const latestF1dGpName  = latestF1dRace ? (gpNames.get(latestF1dRace.grandPrixId) ?? latestF1dRace.grandPrixId) : null;

const hasFant = topPPM.length > 0 || risers.length > 0 || latestF1dSummary;

---

<BaseLayout
  title="f1delta — F1 Statistics & History"
  description="Formula 1 statistics and history from 1950 to today. Driver records, team histories, season standings, and circuit data."
  canonical="https://f1delta.com/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="home">

    <!-- ── Static: hero ──────────────────────────────────────────────── -->
    <section class="hero">
      <h1>The F1 reference <span class="red">desk.</span></h1>
      <p class="tagline">Every driver, every season, every teammate battle — one fast, clean place to settle it.</p>
    </section>

    <!-- ── Dynamic: search + latest race + WDC standings ────────────── -->
    <div id="home-dynamic"></div>

    <!-- ── Static: fantasy teaser ───────────────────────────────────── -->
    {hasFant && (
      <section class="fant-module">
        <div class="module-hd">
          <span class="module-label">2026 F1 Fantasy</span>
          <a class="module-all" href="/fantasy">Full tracker →</a>
        </div>

        {topPPM.length > 0 && (
          <div class="fcard">
            <div class="fcard-hd">
              <span class="fcard-title">Top value</span>
              <span class="tier real">Live · 2026</span>
            </div>
            <table>
              <thead><tr><th class="l">Driver</th><th class="l">Team</th><th class="r">Price</th><th class="r">PPM</th></tr></thead>
              <tbody>
                {topPPM.map(d => (
                  <tr>
                    <td class="nm">{d.pageId ? <a href={`/drivers/${d.pageId}`}>{d.name}</a> : d.name}</td>
                    <td class="tm">{d.team}</td>
                    <td class="n">£{d.price.toFixed(1)}m</td>
                    <td class="n hi">{d.ppm.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {(risers.length > 0 || fallers.length > 0) && (
          <div class="fcard">
            <div class="fcard-hd">
              <span class="fcard-title">Price movers</span>
              <span class="tier real">Live · 2026</span>
            </div>
            <table>
              <thead><tr><th class="l">Asset</th><th class="r">Price</th><th class="r">Change</th></tr></thead>
              <tbody>
                {[...risers, ...fallers].map(m => (
                  <tr>
                    <td class="nm">{m.pageId ? <a href={m.type === "constructor" ? `/teams/${m.pageId}` : `/drivers/${m.pageId}`}>{m.name}</a> : m.name}</td>
                    <td class="n">£{m.price.toFixed(1)}m</td>
                    <td class:list={["n delta", m.delta > 0 ? "pos" : "neg"]}>{m.delta > 0 ? "+" : ""}{m.delta.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {latestF1dSummary && (
          <div class="fcard bridge">
            <div class="fcard-hd">
              <span class="fcard-title">f1δ top score{latestF1dGpName ? ` · ${latestF1dGpName}` : ""}</span>
              <span class="tier derived">f1δ derived</span>
            </div>
            <div class="bridge-row">
              <a class="bridge-name" href={`/drivers/${latestF1dSummary.topDriverId}`}>{latestF1dSummary.topDriverName}</a>
              <span class="bridge-score">{latestF1dSummary.topScore} pts</span>
            </div>
            <p class="bridge-note">f1δ Score applies current scoring rules to all eras for cross-era comparison — it is not the championship points drivers actually earned.</p>
          </div>
        )}
      </section>
    )}

    <!-- ── Static: nav grid ─────────────────────────────────────────── -->
    <section class="nav-grid">
      <a class="nav-tile" href="/standings"><span class="nt-label">Seasons</span><span class="nt-desc">WDC & WCC standings, 1950–today</span></a>
      <a class="nav-tile" href="/drivers"><span class="nt-label">Drivers</span><span class="nt-desc">Career stats for every F1 driver</span></a>
      <a class="nav-tile" href="/teams"><span class="nt-label">Teams</span><span class="nt-desc">Constructor histories & records</span></a>
      <a class="nav-tile" href="/grands-prix"><span class="nt-label">Grands Prix</span><span class="nt-desc">All races by event, with winners</span></a>
      <a class="nav-tile" href="/circuits"><span class="nt-label">Circuits</span><span class="nt-desc">Track histories & statistics</span></a>
      <a class="nav-tile" href="/records"><span class="nt-label">Records</span><span class="nt-desc">All-time leaders across every category</span></a>
      <a class="nav-tile" href="/fantasy"><span class="nt-label">Fantasy</span><span class="nt-desc">Price tracker, PPM & f1δ scores</span></a>
      <a class="nav-tile" href="/engineers"><span class="nt-label">Engineers</span><span class="nt-desc">Pitwall pairings, 1950–now</span></a>
    </section>

  </div>

  <!-- Dynamic home sections: search, latest race, standings -->
  <script is:inline src="/grid-map.js"></script>
  <script is:inline src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>
  <script type="text/babel" is:inline>
  (function () {
    const { useState, useEffect, useRef } = React;

    async function loadLatest() {
      try { const r = await fetch("/latest-race.json"); if (!r.ok) return null; return await r.json(); }
      catch (e) { return null; }
    }
    async function loadStandings() {
      try { const r = await fetch("/standings.json"); if (!r.ok) return null; const d = await r.json(); return Array.isArray(d) ? d : (d.standings || null); }
      catch (e) { return null; }
    }

    const GROUPS = [
      { type: "driver",  label: "Drivers",     cap: 5 },
      { type: "team",    label: "Teams",        cap: 4 },
      { type: "person",  label: "People",       cap: 4 },
      { type: "circuit", label: "Circuits",     cap: 3 },
      { type: "gp",      label: "Grands Prix",  cap: 3 },
      { type: "race",    label: "Races",        cap: 5 },
      { type: "season",  label: "Seasons",      cap: 3 },
      { type: "record",  label: "Records",      cap: 5 },
      { type: "h2h",    label: "Head-to-Head", cap: 3 },
      { type: "tool",   label: "Tools",        cap: 2 },
    ];
    const ROLE_LABELS = {
      "race-engineer": "Race Engineer",
      "technical-director": "Technical Director",
      "team-principal": "Team Principal",
    };

    function matchScore(str, needle) {
      if (!str) return 0;
      const s = String(str).toLowerCase();
      if (s === needle) return 4;
      if (s.startsWith(needle)) return 3;
      if (s.split(/[\s\-\/\.]+/).some(w => w.startsWith(needle))) return 2;
      return 0;
    }
    function scoreEntry(e, needle) {
      const f =
        e.type === "driver"  ? [e.label, e.code] :
        e.type === "team"    ? [e.label, e.nat, e.natId] :
        e.type === "person"  ? [e.label, ...(e.roles || [])] :
        e.type === "circuit" ? [e.label, e.country, e.place] :
        e.type === "gp"      ? [e.label, e.short, e.country] :
        e.type === "race"    ? [e.label, String(e.year), e.country] :
        e.type === "season"  ? [String(e.year), e.champion, e.ccode] :
        e.type === "h2h"     ? [e.label, ...(e.terms || [])] :
        e.type === "tool"    ? [e.label, ...(e.terms || [])] :
        /* record */           [e.label];
      return Math.max(0, ...f.filter(Boolean).map(s => matchScore(s, needle)));
    }
    function rowSecondary(e) {
      if (e.type === "driver")  return (e.code ? e.code + " · " : "") + e.fy + "–" + e.ly;
      if (e.type === "team")    return (e.nat ? e.nat + " · " : "") + e.fy + "–" + e.ly;
      if (e.type === "person")  return (e.roles || []).map(r => ROLE_LABELS[r] || r).join(", ");
      if (e.type === "circuit") return e.country || "";
      if (e.type === "gp")      return e.country || "";
      if (e.type === "race")    return e.country || "";
      if (e.type === "season")  return e.champion ? e.champion + (e.ccode ? " · " + e.ccode : "") : "In progress";
      if (e.type === "h2h")     return "";
      if (e.type === "tool")    return "";
      return "";
    }

    function Search() {
      const [q, setQ] = useState("");
      const [index, setIndex] = useState(null);
      const [loading, setLoading] = useState(false);
      const [activeIdx, setActiveIdx] = useState(-1);
      const wrapRef = useRef(null);

      function ensureIndex() {
        if (index !== null || loading) return;
        setLoading(true);
        fetch("/search-index.json").then(r => r.json())
          .then(d => { setIndex(d); setLoading(false); })
          .catch(() => { setIndex([]); setLoading(false); });
      }

      useEffect(() => {
        function onDown(e) {
          if (wrapRef.current && !wrapRef.current.contains(e.target)) {
            setQ(""); setActiveIdx(-1);
          }
        }
        document.addEventListener("mousedown", onDown);
        return () => document.removeEventListener("mousedown", onDown);
      }, []);

      useEffect(() => { setActiveIdx(-1); }, [q]);

      const needle = q.trim().toLowerCase();
      const needleWords = needle.split(/\s+/).filter(Boolean);
      const groups = [];
      const flat = [];

      if (needle.length >= 2 && index && index.length) {
        for (const cfg of GROUPS) {
          const matches = index
            .filter(e => e.type === cfg.type)
            .map(e => {
              const scores = needleWords.map(w => scoreEntry(e, w));
              const s = scores.length > 0 && scores.every(sc => sc > 0) ? Math.min(...scores) : 0;
              return { e, s };
            })
            .filter(({ s }) => s > 0)
            .sort((a, b) => {
              if (b.s !== a.s) return b.s - a.s;
              if (cfg.type === "driver" || cfg.type === "team") return (b.e.ly || 0) - (a.e.ly || 0);
              if (cfg.type === "season") return b.e.year - a.e.year;
              return (a.e.label || "").localeCompare(b.e.label || "");
            })
            .slice(0, cfg.cap)
            .map(({ e }) => e);
          if (matches.length) {
            const startIdx = flat.length;
            flat.push(...matches);
            groups.push({ cfg, results: matches, startIdx });
          }
        }
      }

      function onKeyDown(e) {
        if (e.key === "ArrowDown" && flat.length) {
          e.preventDefault();
          setActiveIdx(i => i < flat.length - 1 ? i + 1 : 0);
        } else if (e.key === "ArrowUp" && flat.length) {
          e.preventDefault();
          setActiveIdx(i => i > 0 ? i - 1 : flat.length - 1);
        } else if (e.key === "Enter") {
          const target = activeIdx >= 0 ? flat[activeIdx] : flat[0];
          if (target) window.location.href = target.url;
        } else if (e.key === "Escape") {
          setQ(""); setActiveIdx(-1);
        }
      }

      const open = needle.length >= 2 && (loading || groups.length > 0);

      return (
        <div className="h-search" ref={wrapRef}>
          <input
            type="text"
            placeholder="Search drivers, teams, circuits…"
            value={q}
            onFocus={ensureIndex}
            onChange={(e) => setQ(e.target.value)}
            onKeyDown={onKeyDown}
          />
          {open && (
            <div className="h-results">
              {loading && !groups.length && <div className="h-loading">Loading…</div>}
              {groups.map(({ cfg, results, startIdx }) => (
                <div key={cfg.type} className="h-group">
                  <div className="h-group-label">{cfg.label}</div>
                  {results.map((entry, i) => {
                    const fi = startIdx + i;
                    const sec = rowSecondary(entry);
                    return (
                      <a key={entry.url} href={entry.url}
                         className={"h-row" + (fi === activeIdx ? " active" : "")}
                         onMouseEnter={() => setActiveIdx(fi)}>
                        <span className="rn">{entry.label}</span>
                        {sec && <span className="rs">{sec}</span>}
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          )}
        </div>
      );
    }

    function LatestResult({ data, codeMap }) {
      if (!data || !data.tower) return null;
      return (
        <section className="h-sect">
          <div className="h-sect-hd">
            <h2>{data.session?.name || "Latest result"}</h2>
            <span>Round {data.session?.round} · final</span>
          </div>
          <div className="h-card">
            <table>
              <thead><tr><th className="l">P</th><th className="l">Driver</th><th>Gap</th><th>Pts</th></tr></thead>
              <tbody>
                {data.tower.map((r) => {
                  const slug = codeMap[(r.code || "").toUpperCase()];
                  const isDnf = r.dnf || r.position == null;
                  return (
                    <tr key={r.code} className={slug ? "clik" : ""} onClick={slug ? () => { window.location.href = `/drivers/${slug}`; } : undefined}>
                      <td className={"pos" + (isDnf ? " dnf" : "")}>{isDnf ? "—" : r.position}</td>
                      <td className="drv">
                        <span className="dot" style={{ background: r.teamColour || "#9aa0ab" }} />
                        <span className="cc">{r.code}</span>
                        <span className="tn">{r.teamName}</span>
                        {slug && <span className="go">→</span>}
                      </td>
                      <td className={"gap" + (r.leader ? " lead" : "")}>{r.leader ? "LEADER" : String(r.gap || "")}</td>
                      <td className={"pts" + (r.points > 0 ? "" : " zero")}>{r.points > 0 ? `+${r.points}` : "0"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      );
    }

    function Standings({ rows, codeMap }) {
      if (!rows || rows.length === 0) return null;
      return (
        <section className="h-sect">
          <div className="h-sect-hd"><h2>2026 Championship</h2><span>WDC standings</span></div>
          <div className="h-card">
            <table>
              <thead><tr><th className="l">P</th><th className="l">Driver</th><th>Pts</th></tr></thead>
              <tbody>
                {rows.map((s) => {
                  const slug = codeMap[(s.code || "").toUpperCase()];
                  return (
                    <tr key={s.code} className={slug ? "clik" : ""} onClick={slug ? () => { window.location.href = `/drivers/${slug}`; } : undefined}>
                      <td className="pos">{s.pos}</td>
                      <td className="drv">
                        <span className="cc">{s.code}</span>
                        {s.team && <span className="tn">{s.team}</span>}
                        {slug && <span className="go">→</span>}
                      </td>
                      <td className="pts">{s.points}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      );
    }

    function DynamicHome() {
      const [latest, setLatest] = useState(null);
      const [standings, setStandings] = useState(null);
      const [loaded, setLoaded] = useState(false);
      const codeMap = window.F1_GRID || {};

      useEffect(() => {
        let alive = true;
        Promise.all([loadLatest(), loadStandings()]).then(([lat, std]) => {
          if (!alive) return;
          setLatest(lat); setStandings(std); setLoaded(true);
        });
        return () => { alive = false; };
      }, []);

      return (
        <>
          <Search />
          {loaded && <LatestResult data={latest} codeMap={codeMap} />}
          {loaded && <Standings rows={standings} codeMap={codeMap} />}
        </>
      );
    }

    const el = document.getElementById("home-dynamic");
    if (el) ReactDOM.createRoot(el).render(<DynamicHome />);
  })();
  </script>
</BaseLayout>

<style>
  .home {
    max-width: 760px; margin: 0 auto; padding: 0 20px 56px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    background: var(--surface); border-bottom: 1px solid var(--line);
    margin: 0 -20px 20px; padding: 32px 20px 28px;
  }
  .hero h1 {
    font-family: var(--disp);
    font-weight: 700; font-size: clamp(28px, 5vw, 48px);
    line-height: 1; letter-spacing: -.01em; margin: 0 0 8px;
  }
  .red { color: var(--red); }
  .tagline { font-size: 14px; color: var(--dim); margin: 0; }

  /* ── Dynamic sections mount point ─────────────────────────────────── */
  #home-dynamic { margin-bottom: 8px; }

  /* ── Fantasy module ───────────────────────────────────────────────── */
  .fant-module { margin-bottom: 20px; }
  .module-hd {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 8px;
  }
  .module-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--dim); }
  .module-all { font-size: 12px; color: var(--dim); text-decoration: none; }
  .module-all:hover { color: var(--ink); text-decoration: underline; }

  .fcard {
    background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
    overflow: hidden; margin-bottom: 8px;
  }
  .fcard-hd {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 12px 0;
  }
  .fcard-title { font-size: 11px; font-weight: 600; color: var(--dim); text-transform: uppercase; letter-spacing: .06em; }
  .tier {
    font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em;
    padding: 2px 6px; border-radius: 3px;
  }
  .tier.real    { background: #e8f5e9; color: #2e7d32; }
  .tier.derived { background: #f3f0ff; color: #5c35bf; }

  .fcard table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .fcard th {
    text-align: right; padding: 6px 12px 4px;
    font-size: 10px; font-weight: 600; color: var(--faint);
    text-transform: uppercase; letter-spacing: .04em;
  }
  .fcard th.l { text-align: left; }
  .fcard th.r { text-align: right; }
  .fcard td { padding: 7px 12px; border-top: 1px solid var(--line); }
  td.nm { text-align: left; font-weight: 500; }
  td.nm a { color: var(--ink); text-decoration: none; }
  td.nm a:hover { text-decoration: underline; }
  td.tm { text-align: left; color: var(--dim); font-size: 12px; }
  td.n {
    text-align: right; color: var(--dim);
    font-variant-numeric: tabular-nums; font-feature-settings: "tnum";
    font-family: var(--mono); font-size: 12px;
  }
  td.hi { color: var(--ink); font-weight: 600; }
  td.delta.pos { color: #1a7a40; }
  td.delta.neg { color: #c0392b; }

