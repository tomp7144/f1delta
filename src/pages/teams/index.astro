---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeamsHub from "../../components/TeamsHub.astro";

const index = JSON.parse(fs.readFileSync(path.resolve("./data/teams/index.json"), "utf8"));
---

<BaseLayout
  title="F1 Teams — All Constructors | f1delta"
  description="Every F1 constructor in World Championship history, ranked by wins, titles and points."
  canonical="https://f1delta.com/teams"
>
  <TeamsHub index={index} />
  <script src="/f1-records.js" defer is:inline></script>
</BaseLayout>
