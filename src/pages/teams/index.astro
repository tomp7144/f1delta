---
// src/pages/teams/index.astro — the /teams index. Static.
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import TeamsHub from "../../components/TeamsHub.astro";

const index = JSON.parse(fs.readFileSync(path.resolve("./data/teams/index.json"), "utf8"));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>F1 Teams — All Constructors | f1delta</title>
    <meta name="description" content="Every F1 constructor in World Championship history, ranked by wins, titles and points." />
    <link rel="canonical" href="https://f1delta.com/teams" />
  </head>
  <body style="margin:0;background:#f4f4f1">
    <TeamsHub index={index} />
    <script src="/f1-records.js" defer></script>
  </body>
</html>
