---
// src/pages/teams/[id].astro — one static page per constructor.
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import TeamPage from "../../components/TeamPage.astro";

export function getStaticPaths() {
  const DIR = path.resolve("./data/teams");
  const index = JSON.parse(fs.readFileSync(path.join(DIR, "index.json"), "utf8"));
  const engByTeamPath = path.resolve("./data/people/by-team.json");
  const engByTeam: Record<string, any[]> = fs.existsSync(engByTeamPath)
    ? JSON.parse(fs.readFileSync(engByTeamPath, "utf8"))
    : {};
  return index.teams.map((t: any) => ({
    params: { id: t.id },
    props: {
      team: JSON.parse(fs.readFileSync(path.join(DIR, `${t.id}.json`), "utf8")),
      engineers: (engByTeam[t.id] ?? []).filter((e: any) => e.type === "race-engineer"),
    },
  }));
}

const { team, engineers } = Astro.props;
const title = `${team.name} — F1 Stats, Wins & Drivers | f1delta`;
const desc = `${team.name} in Formula 1: ${team.totals.championships} championships, ${team.totals.wins} wins, full season history and every driver who raced for the team.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={`https://f1delta.com/teams/${team.id}`} />
  </head>
  <body style="margin:0;background:#f4f4f1">
    <TeamPage team={team} engineers={engineers} />
    <script src="/f1-records.js" defer></script>
  </body>
</html>
