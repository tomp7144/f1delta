---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Guess the Driver — F1 Career Chain Quiz"
  description="Identify the F1 driver from their career team progression. Multiple choice arcade, daily challenge, or free-text casual mode."
  canonical="https://f1delta.com/trivia"
>

<style>
  /* ── page layout ── */
  .trivia-wrap { max-width: 680px; margin: 0 auto; padding: 28px 16px 60px; }
  h1.trivia-h1 { font-size: 22px; font-weight: 700; margin: 0 0 4px; color: var(--ink); }
  .trivia-sub { color: var(--dim); font-size: 14px; margin: 0 0 20px; }

  /* ── settings ── */
  .settings-sect { margin-bottom: 20px; }
  .settings-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .settings-label { font-size: 11px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--dim); padding-top: 5px; min-width: 60px; flex-shrink: 0; }
  .chips-wrap { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter-chip {
    padding: 4px 12px; border: 1px solid var(--line); border-radius: 20px;
    background: var(--surface); cursor: pointer; font-family: var(--body);
    font-size: 12px; color: var(--dim); transition: all .15s; white-space: nowrap;
  }
  .filter-chip:hover:not(.disabled) { border-color: var(--dim); color: var(--ink); }
  .filter-chip.active { border-color: var(--ink); background: var(--ink); color: #fff; }
  .filter-chip.disabled { opacity: .38; cursor: not-allowed; }
  .combo-info { font-size: 12px; color: var(--faint); margin-top: 6px; min-height: 18px; }
  .diff-desc { font-size: 11px; color: var(--faint); margin-bottom: 12px; }

  /* ── mode selector ── */
  .mode-grid { display: flex; flex-direction: column; gap: 10px; max-width: 400px; }
  .mode-btn {
    display: flex; flex-direction: column; gap: 3px;
    padding: 14px 18px; border: 1.5px solid var(--line); border-radius: 8px;
    background: var(--surface); cursor: pointer; text-align: left;
    font-family: var(--body); transition: border-color .15s, background .15s;
  }
  .mode-btn:hover { border-color: var(--red); background: #fff; }
  .mode-btn .mb-title { font-size: 15px; font-weight: 600; color: var(--ink); }
  .mode-btn .mb-desc  { font-size: 12px; color: var(--dim); }

  /* ── game header ── */
  .game-header { display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 18px; gap: 10px; }
  .game-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .game-label { font-size: 11px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--dim); }
  .q-counter { font-family: var(--mono); font-size: 12px; color: var(--dim); }
  .score-chip { font-family: var(--mono); font-size: 13px; color: var(--ink);
    background: var(--bg); border: 1px solid var(--line); border-radius: 20px;
    padding: 3px 10px; white-space: nowrap; flex-shrink: 0; }

  /* ── chain display ── */
  .chain-box {
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    padding: 20px 18px; margin-bottom: 18px;
  }
  .chain-q { font-size: 11px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--dim); margin-bottom: 12px; }
  .chain-links {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    font-family: var(--mono);
  }
  .chain-team {
    background: var(--bg); border: 1px solid var(--line); border-radius: 5px;
    padding: 5px 10px; font-size: 13px; font-weight: 600; color: var(--ink);
    white-space: nowrap;
  }
  .chain-arr { color: var(--faint); font-size: 14px; flex-shrink: 0; }

  /* ── timer bar ── */
  .timer-wrap { margin-bottom: 14px; }
  .timer-track { height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .timer-fill { height: 100%; background: var(--red); border-radius: 2px; }
  .timer-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
  .timer-pts { font-family: var(--mono); font-size: 12px; color: var(--red); font-weight: 700; }
  .timer-sec { font-family: var(--mono); font-size: 11px; color: var(--dim); }

  /* ── multiple-choice options ── */
  .mc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }
  @media (max-width: 480px) { .mc-grid { grid-template-columns: 1fr; } }
  .mc-btn {
    padding: 13px 14px; border: 1.5px solid var(--line); border-radius: 8px;
    background: var(--surface); cursor: pointer; text-align: left;
    font-family: var(--body); font-size: 13px; font-weight: 500; color: var(--ink);
    transition: border-color .1s, background .1s; min-height: 48px; line-height: 1.3;
  }
  .mc-btn:hover:not(:disabled) { border-color: var(--dim); background: var(--bg); }
  .mc-btn.correct  { border-color: #3a9a3a; background: #edfaed; color: #1a6e1a; }
  .mc-btn.wrong    { border-color: var(--red); background: #fef0f0; color: var(--red); }
  .mc-btn:disabled { cursor: default; }

  /* ── free-text input ── */
  .ft-wrap { position: relative; margin-bottom: 16px; }
  .ft-in {
    width: 100%; font-family: var(--body); font-size: 14px; color: var(--ink);
    background: var(--surface); border: 1.5px solid var(--line); border-radius: 8px;
    padding: 12px 14px; box-sizing: border-box; outline: none;
  }
  .ft-in:focus { border-color: var(--dim); }
  .ft-suggest {
    position: absolute; left: 0; right: 0; top: calc(100% + 2px);
    background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
    box-shadow: 0 4px 12px rgba(0,0,0,.07); z-index: 100;
    max-height: 240px; overflow-y: auto;
  }
  .ft-opt {
    padding: 9px 14px; font-size: 13px; color: var(--ink); cursor: pointer;
    border-bottom: 1px solid var(--line); white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis;
  }
  .ft-opt:last-child { border-bottom: none; }
  .ft-opt:hover, .ft-opt.active { background: var(--bg); }
  .ft-hint { font-size: 11px; color: var(--dim); margin-top: 4px; }

  /* ── feedback panel ── */
  .feedback-box {
    padding: 14px 18px; border-radius: 8px; margin-bottom: 14px;
    border: 1px solid var(--line);
  }
  .feedback-box.correct { background: #edfaed; border-color: #3a9a3a; }
  .feedback-box.wrong   { background: #fef0f0; border-color: var(--red); }
  .feedback-box.timeout { background: #fef8ed; border-color: #c4952a; }
  .fb-verdict { font-weight: 700; font-size: 15px; margin-bottom: 4px; }
  .fb-name    { font-size: 13px; color: var(--ink); }
  .fb-name a  { color: var(--red); font-weight: 600; text-decoration: none; }
  .fb-name a:hover { text-decoration: underline; }

  /* ── action buttons ── */
  .action-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .next-btn {
    padding: 10px 20px; background: var(--ink); color: #fff; border: none;
    border-radius: 7px; cursor: pointer; font-family: var(--body); font-size: 13px;
    font-weight: 600;
  }
  .next-btn:hover { background: #2a2a30; }
  .skip-btn {
    padding: 10px 16px; background: none; border: 1px solid var(--line);
    border-radius: 7px; cursor: pointer; font-family: var(--body); font-size: 13px;
    color: var(--dim);
  }
  .skip-btn:hover { border-color: var(--dim); color: var(--ink); }

  /* ── end screen ── */
  .end-box { text-align: center; padding: 32px 16px; }
  .end-score { font-size: 56px; font-weight: 800; font-family: var(--mono); color: var(--ink);
    line-height: 1; margin-bottom: 6px; }
  .end-label { font-size: 11px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--dim); margin-bottom: 6px; }
  .end-correct { font-size: 18px; color: var(--dim); margin-bottom: 6px; }
  .end-best { font-family: var(--mono); font-size: 13px; color: var(--faint); margin-bottom: 4px; }
  .end-new-best { display: inline-block; font-size: 13px; font-weight: 700;
    color: #8a6a10; background: #fbf3d0; border: 1px solid #d4b87a;
    border-radius: 20px; padding: 3px 12px; margin-bottom: 20px; }
  .end-share  { margin-bottom: 20px; }
  .share-text {
    font-family: var(--mono); font-size: 12px; background: var(--bg);
    border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px;
    white-space: pre-wrap; text-align: left; margin-bottom: 8px; word-break: break-all;
    max-width: 380px; margin-left: auto; margin-right: auto;
  }
  .copy-btn {
    padding: 8px 16px; background: var(--surface); border: 1px solid var(--line);
    border-radius: 6px; cursor: pointer; font-family: var(--body); font-size: 12px;
    color: var(--dim); transition: all .15s;
  }
  .copy-btn.copied { background: #edfaed; border-color: #3a9a3a; color: #1a6e1a; }
  .end-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 16px; }
  .play-again {
    padding: 11px 24px; background: var(--red); color: #fff;
    border: none; border-radius: 7px; cursor: pointer; font-family: var(--body);
    font-size: 14px; font-weight: 700;
  }
  .play-again:hover { background: #c20500; }
  .change-settings {
    padding: 11px 18px; background: none; border: 1px solid var(--line);
    border-radius: 7px; cursor: pointer; font-family: var(--body);
    font-size: 13px; color: var(--dim);
  }
  .change-settings:hover { border-color: var(--dim); color: var(--ink); }

  /* ── daily meta ── */
  .daily-meta { font-size: 12px; color: var(--dim); margin-bottom: 10px; }

  /* ── back btn ── */
  .back-btn {
    display: inline-flex; align-items: center; gap: 4px; font-size: 12px;
    color: var(--dim); background: none; border: none; cursor: pointer;
    padding: 0; margin-bottom: 16px; font-family: var(--body);
  }
  .back-btn:hover { color: var(--ink); }

  [hidden] { display: none !important; }
</style>

<div class="trivia-wrap">

  <!-- Landing -->
  <div id="landing">
    <h1 class="trivia-h1">Guess the Driver</h1>
    <p class="trivia-sub">Identify the F1 driver from their career team progression</p>

    <!-- Settings -->
    <div class="settings-sect" id="settings-sect">
      <div class="settings-row">
        <span class="settings-label">Difficulty</span>
        <div class="chips-wrap" id="diff-chips">
          <button class="filter-chip active" data-diff="easy" title="100+ career race starts">Easy</button>
          <button class="filter-chip" data-diff="medium" title="Race winners &amp; champions">Medium</button>
          <button class="filter-chip" data-diff="hard" title="All drivers with 2+ teams">Hard</button>
        </div>
      </div>
      <div class="settings-row">
        <span class="settings-label">Era</span>
        <div class="chips-wrap" id="decade-chips">
          <button class="filter-chip active" data-decade="all">All-time</button>
          <button class="filter-chip" data-decade="2020s">2020s</button>
          <button class="filter-chip" data-decade="2010s">2010s</button>
          <button class="filter-chip" data-decade="2000s">2000s</button>
          <button class="filter-chip" data-decade="1990s">1990s</button>
          <button class="filter-chip" data-decade="1980s">1980s</button>
          <button class="filter-chip" data-decade="1970s">1970s</button>
          <button class="filter-chip" data-decade="1960s">1960s</button>
          <button class="filter-chip" data-decade="1950s">1950s</button>
        </div>
      </div>
      <div class="combo-info" id="combo-info"></div>
    </div>

    <div class="mode-grid">
      <button class="mode-btn" id="btn-arcade">
        <span class="mb-title">⏱ Arcade</span>
        <span class="mb-desc">10 questions · 10s timer · score decays · wrong costs points, not the round</span>
      </button>
      <button class="mode-btn" id="btn-daily">
        <span class="mb-title">📅 Daily Challenge</span>
        <span class="mb-desc">Same chain for everyone today · shareable result · ignores filters above</span>
      </button>
      <button class="mode-btn" id="btn-casual">
        <span class="mb-title">💬 Casual</span>
        <span class="mb-desc">10 questions · free-text · untimed · guess and learn at your own pace</span>
      </button>
    </div>
  </div>

  <!-- Game -->
  <div id="game" hidden>
    <button class="back-btn" id="back-btn">← Back</button>
    <div class="game-header">
      <div class="game-left">
        <span class="game-label" id="mode-label">Arcade</span>
        <span class="q-counter" id="q-counter" hidden></span>
      </div>
      <span class="score-chip" id="score-chip" hidden>
        <b id="score-val">0</b> pts
      </span>
    </div>

    <div class="chain-box">
      <div class="chain-q">Who drove for…</div>
      <div class="chain-links" id="chain-links"></div>
    </div>

    <div class="timer-wrap" id="timer-wrap" hidden>
      <div class="timer-row">
        <span class="timer-pts" id="timer-pts">+1000</span>
        <span class="timer-sec" id="timer-sec">10.0s</span>
      </div>
      <div class="timer-track"><div class="timer-fill" id="timer-fill"></div></div>
    </div>

    <div class="mc-grid" id="mc-grid" hidden></div>

    <div class="ft-wrap" id="ft-wrap" hidden>
      <input class="ft-in" id="ft-in" type="text"
        placeholder="Type a driver name…" autocomplete="off" spellcheck="false" />
      <div class="ft-suggest" id="ft-suggest" hidden></div>
      <p class="ft-hint">Surname or full name — pick from the dropdown</p>
    </div>

    <div class="daily-meta" id="daily-meta" hidden></div>

    <div class="feedback-box" id="feedback" hidden>
      <div class="fb-verdict" id="fb-verdict"></div>
      <div class="fb-name" id="fb-name"></div>
    </div>

    <div class="action-row" id="action-row" hidden>
      <button class="next-btn" id="next-btn">Next →</button>
      <button class="skip-btn" id="skip-btn">Skip</button>
    </div>
  </div>

  <!-- End screen -->
  <div id="endscreen" hidden>
    <div class="end-box">
      <div class="end-label" id="end-label">Round Complete</div>
      <div class="end-score" id="end-score">0</div>
      <div class="end-correct" id="end-correct"></div>
      <div class="end-best" id="end-best"></div>
      <div class="end-new-best" id="end-new-best" hidden>🏆 New best!</div>
      <div class="end-share" id="end-share" hidden>
        <div class="share-text" id="share-text"></div>
        <button class="copy-btn" id="copy-btn">Copy result</button>
      </div>
      <div class="end-actions">
        <button class="play-again" id="play-again">Play again</button>
        <button class="change-settings" id="change-settings">Change settings</button>
      </div>
    </div>
  </div>

</div>

<script is:inline>
(function () {
  // ── Constants ──────────────────────────────────────────────────────────────
  var ROUND_SIZE = 10;
  var TIMER_MS   = 10000;
  var MIN_POOL   = 15;
  var DECADE_RANGES = {
    '2020s': [2020,2029], '2010s': [2010,2019], '2000s': [2000,2009],
    '1990s': [1990,1999], '1980s': [1980,1989], '1970s': [1970,1979],
    '1960s': [1960,1969], '1950s': [1950,1959]
  };
  var DIFF_OPTIONS   = ['easy','medium','hard'];
  var DECADE_OPTIONS = ['all','2020s','2010s','2000s','1990s','1980s','1970s','1960s','1950s'];

  // ── State ──────────────────────────────────────────────────────────────────
  var MODE     = null;
  var DIFF     = 'easy';
  var DECADE   = 'all';
  var triviaData  = null;
  var comboPools  = {};
  var pool        = [];
  var used        = new Set();
  var currentQ    = null;
  var totalScore  = 0;
  var qNum        = 0;
  var qCorrect    = 0;
  var timerRAF    = null;
  var timerStart  = 0;
  var answered    = false;
  var dailyDriver = null;
  var dailyDecoys = [];

  // ── DOM refs ───────────────────────────────────────────────────────────────
  var landing      = document.getElementById('landing');
  var game         = document.getElementById('game');
  var endscreen    = document.getElementById('endscreen');
  var backBtn      = document.getElementById('back-btn');
  var modeLabel    = document.getElementById('mode-label');
  var qCounter     = document.getElementById('q-counter');
  var scoreChip    = document.getElementById('score-chip');
  var scoreVal     = document.getElementById('score-val');
  var diffChips    = document.getElementById('diff-chips');
  var decadeChips  = document.getElementById('decade-chips');
  var comboInfo    = document.getElementById('combo-info');
  var chainLinks   = document.getElementById('chain-links');
  var timerWrap    = document.getElementById('timer-wrap');
  var timerPts     = document.getElementById('timer-pts');
  var timerSec     = document.getElementById('timer-sec');
  var timerFill    = document.getElementById('timer-fill');
  var mcGrid       = document.getElementById('mc-grid');
  var ftWrap       = document.getElementById('ft-wrap');
  var ftIn         = document.getElementById('ft-in');
  var ftSuggest    = document.getElementById('ft-suggest');
  var feedback     = document.getElementById('feedback');
  var fbVerdict    = document.getElementById('fb-verdict');
  var fbName       = document.getElementById('fb-name');
  var dailyMeta    = document.getElementById('daily-meta');
  var actionRow    = document.getElementById('action-row');
  var nextBtn      = document.getElementById('next-btn');
  var skipBtn      = document.getElementById('skip-btn');
  var endLabel     = document.getElementById('end-label');
  var endScore     = document.getElementById('end-score');
  var endCorrect   = document.getElementById('end-correct');
  var endBest      = document.getElementById('end-best');
  var endNewBest   = document.getElementById('end-new-best');
  var endShare     = document.getElementById('end-share');
  var shareText    = document.getElementById('share-text');
  var copyBtn      = document.getElementById('copy-btn');
  var playAgain    = document.getElementById('play-again');
  var changeSettings = document.getElementById('change-settings');

  // ── localStorage ──────────────────────────────────────────────────────────
  function saveBest(combo, score, correct) {
    try {
      localStorage.setItem('f1delta:trivia:best:' + combo, JSON.stringify({ score: score, correct: correct }));
    } catch(e) {}
  }

  function getBest(combo) {
    try {
      var v = localStorage.getItem('f1delta:trivia:best:' + combo);
      return v ? JSON.parse(v) : null;
    } catch(e) { return null; }
  }

  // ── Chip UI ────────────────────────────────────────────────────────────────
  function setActiveChip(wrap, attrName, val) {
    Array.from(wrap.querySelectorAll('.filter-chip')).forEach(function(btn) {
      btn.classList.toggle('active', btn.dataset[attrName] === val);
    });
  }

  function updateChipAvailability() {
    if (!triviaData) return;

    // Decade chips: grey out those that are too thin for current DIFF
    Array.from(decadeChips.querySelectorAll('.filter-chip')).forEach(function(btn) {
      var decade = btn.dataset.decade;
      var count = comboPools[DIFF + ':' + decade] || 0;
      var thin = count < MIN_POOL;
      btn.classList.toggle('disabled', thin);
      if (thin) {
        btn.title = 'Not enough drivers for a full round (' + count + ' available)';
      } else {
        // Restore original title for diff chips only; decade chips get count
        var rng = DECADE_RANGES[decade];
        btn.title = rng ? '' : '';
      }
    });

    // Diff chips: grey out those that are too thin for current DECADE
    Array.from(diffChips.querySelectorAll('.filter-chip')).forEach(function(btn) {
      var diff = btn.dataset.diff;
      var count = comboPools[diff + ':' + DECADE] || 0;
      var thin = count < MIN_POOL;
      btn.classList.toggle('disabled', thin);
      if (thin) {
        btn.title = 'Not enough drivers for this combination (' + count + ' available)';
      } else {
        // Restore original title
        if (diff === 'easy') btn.title = '100+ career race starts';
        else if (diff === 'medium') btn.title = 'Race winners & champions';
        else btn.title = 'All drivers with 2+ teams';
      }
    });
  }

  function updateComboInfo() {
    var combo = DIFF + ':' + DECADE;
    var count = comboPools[combo] || 0;
    var best  = getBest(combo);
    var text  = count ? count + ' driver' + (count !== 1 ? 's' : '') : '';
    if (best) text += ' · Best: ' + best.score + ' pts';
    comboInfo.textContent = text;
  }

  // ── Chip click handlers ────────────────────────────────────────────────────
  diffChips.addEventListener('click', function(e) {
    var btn = e.target.closest('.filter-chip');
    if (!btn || btn.classList.contains('disabled')) return;
    DIFF = btn.dataset.diff;
    setActiveChip(diffChips, 'diff', DIFF);
    updateChipAvailability();
    // If current DECADE is now too thin, switch to 'all'
    if ((comboPools[DIFF + ':' + DECADE] || 0) < MIN_POOL) {
      DECADE = 'all';
      setActiveChip(decadeChips, 'decade', DECADE);
    }
    updateComboInfo();
  });

  decadeChips.addEventListener('click', function(e) {
    var btn = e.target.closest('.filter-chip');
    if (!btn || btn.classList.contains('disabled')) return;
    DECADE = btn.dataset.decade;
    setActiveChip(decadeChips, 'decade', DECADE);
    updateChipAvailability();
    updateComboInfo();
  });

  // ── Mode buttons ───────────────────────────────────────────────────────────
  document.getElementById('btn-arcade').addEventListener('click', function() { startMode('arcade'); });
  document.getElementById('btn-daily').addEventListener('click', function() { startMode('daily'); });
  document.getElementById('btn-casual').addEventListener('click', function() { startMode('casual'); });

  backBtn.addEventListener('click', function() {
    stopTimer();
    landing.hidden = false; game.hidden = true; endscreen.hidden = true;
    reset();
  });

  playAgain.addEventListener('click', function() {
    endscreen.hidden = true;
    if (MODE === 'daily') {
      landing.hidden = false; reset();
    } else {
      reset();
      startMode(MODE);
    }
  });

  changeSettings.addEventListener('click', function() {
    endscreen.hidden = true; landing.hidden = false; reset();
  });

  // ── Data loading ───────────────────────────────────────────────────────────
  async function loadData() {
    if (triviaData) return;
    var res = await fetch('/trivia.json');
    triviaData = await res.json();
    computeComboPools();
    updateChipAvailability();
    updateComboInfo();
  }

  function computeComboPools() {
    comboPools = {};
    var all = triviaData.drivers;
    for (var i = 0; i < DIFF_OPTIONS.length; i++) {
      var diff = DIFF_OPTIONS[i];
      var diffBase = diff === 'easy'   ? all.filter(function(d) { return d.races >= 100; })
                   : diff === 'medium' ? all.filter(function(d) { return d.wins >= 1; })
                   : all;
      for (var j = 0; j < DECADE_OPTIONS.length; j++) {
        var decade = DECADE_OPTIONS[j];
        var base;
        if (decade === 'all') {
          base = diffBase;
        } else {
          var rng = DECADE_RANGES[decade];
          base = diffBase.filter(function(d) { return d.fy <= rng[1] && d.ly >= rng[0]; });
        }
        comboPools[diff + ':' + decade] = base.length;
      }
    }
  }

  function buildPool() {
    var base = triviaData.drivers.slice();
    if (DIFF === 'easy')   base = base.filter(function(d) { return d.races >= 100; });
    else if (DIFF === 'medium') base = base.filter(function(d) { return d.wins >= 1; });
    if (DECADE !== 'all') {
      var rng = DECADE_RANGES[DECADE];
      base = base.filter(function(d) { return d.fy <= rng[1] && d.ly >= rng[0]; });
    }
    pool = base;
    used.clear();
  }

  // ── Seeded RNG (daily determinism) ─────────────────────────────────────────
  function seededRNG(seed) {
    var s = seed >>> 0;
    return function() {
      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }

  function seededShuffle(arr, rng) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(rng() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  function dayIndex() {
    var epoch = Date.UTC(2025, 0, 1);
    var d = new Date();
    var now = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
    return Math.floor((now - epoch) / 86400000);
  }

  // ── Distractor generation ──────────────────────────────────────────────────
  function pickDecoys(answer, sourcePool, rng) {
    var answerKey = answer.chainIds.join(',');
    var candidates = sourcePool
      .filter(function(d) { return d.id !== answer.id && d.chainIds.join(',') !== answerKey; })
      .map(function(d) {
        var shared = 0;
        for (var i = 0; i < d.chainIds.length; i++) {
          if (answer.chainIds.indexOf(d.chainIds[i]) >= 0) shared++;
        }
        var eraOverlap = Math.max(0, Math.min(d.ly, answer.ly) - Math.max(d.fy, answer.fy) + 1);
        var lenSim = Math.max(0, 5 - Math.abs(d.chain.length - answer.chain.length));
        return { d: d, score: shared * 100 + eraOverlap * 5 + lenSim };
      });

    candidates.sort(function(a, b) { return b.score - a.score; });
    var top = candidates.slice(0, 20).map(function(x) { return x.d; });

    if (rng) {
      top = seededShuffle(top, rng);
    } else {
      for (var i = top.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = top[i]; top[i] = top[j]; top[j] = tmp;
      }
    }
    return top.slice(0, 3);
  }

  // ── Chain rendering ────────────────────────────────────────────────────────
  function renderChain(driver) {
    chainLinks.innerHTML = '';
    driver.chain.forEach(function(team, i) {
      if (i > 0) {
        var arr = document.createElement('span');
        arr.className = 'chain-arr'; arr.textContent = '→';
        chainLinks.appendChild(arr);
      }
      var t = document.createElement('span');
      t.className = 'chain-team'; t.textContent = team;
      chainLinks.appendChild(t);
    });
  }

  // ── Start mode ─────────────────────────────────────────────────────────────
  async function startMode(m) {
    MODE = m;
    reset();
    landing.hidden = true; game.hidden = false; endscreen.hidden = true;

    modeLabel.textContent = m === 'arcade' ? '⏱ Arcade' : m === 'daily' ? '📅 Daily' : '💬 Casual';
    timerWrap.hidden = (m !== 'arcade');
    scoreChip.hidden = (m === 'daily');
    qCounter.hidden  = (m === 'daily');

    try {
      await loadData();
    } catch(e) {
      chainLinks.textContent = 'Failed to load game data. Please refresh.';
      return;
    }

    if (m === 'daily') {
      setupDaily();
    } else {
      buildPool();
      showNextQuestion();
    }
  }

  // ── Daily setup (single question, date-seeded) ─────────────────────────────
  function setupDaily() {
    var idx = dayIndex();
    var dailyPool = triviaData.drivers.filter(function(d) { return d.wins >= 1; });
    var shuffled  = seededShuffle(dailyPool, seededRNG(idx * 31337));
    dailyDriver   = shuffled[idx % shuffled.length];
    dailyDecoys   = pickDecoys(dailyDriver, dailyPool, seededRNG(idx * 7919 + 999));

    var today = new Date();
    dailyMeta.hidden = false;
    dailyMeta.textContent = 'Daily #' + idx + ' · ' +
      today.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' });

    renderChain(dailyDriver);
    feedback.hidden = true;
    actionRow.hidden = true;
    answered = false;
    showMC(dailyDriver, dailyDecoys);
  }

  // ── Next question (arcade / casual) ────────────────────────────────────────
  function showNextQuestion() {
    qNum++;
    qCounter.textContent = 'Q' + qNum + ' / ' + ROUND_SIZE;

    var available = pool.filter(function(d) { return !used.has(d.id); });
    if (!available.length) { used.clear(); available = pool.slice(); }

    var driver = available[Math.floor(Math.random() * available.length)];
    used.add(driver.id);

    var decoys = pickDecoys(driver, pool, null);
    currentQ = { driver: driver, decoys: decoys };

    renderChain(driver);
    feedback.hidden = true;
    actionRow.hidden = true;
    dailyMeta.hidden = true;
    answered = false;

    if (MODE === 'casual') {
      mcGrid.hidden = true; ftWrap.hidden = false;
      ftIn.value = ''; ftSuggest.hidden = true;
      setTimeout(function() { ftIn.focus(); }, 50);
    } else {
      showMC(driver, decoys);
      if (MODE === 'arcade') startTimer();
    }
  }

  // ── MC rendering ───────────────────────────────────────────────────────────
  function showMC(driver, decoys) {
    var options = [driver].concat(decoys).sort(function() { return Math.random() - 0.5; });
    mcGrid.hidden = false; ftWrap.hidden = true;
    mcGrid.innerHTML = '';
    options.forEach(function(d) {
      var btn = document.createElement('button');
      btn.className = 'mc-btn'; btn.textContent = d.name;
      btn.addEventListener('click', function() { handleMCAnswer(d, driver); });
      mcGrid.appendChild(btn);
    });
  }

  // ── MC answer ──────────────────────────────────────────────────────────────
  function handleMCAnswer(chosen, correctDriver) {
    if (answered) return;
    answered = true;
    stopTimer();

    var correct = chosen.id === correctDriver.id;
    var pts = 0;

    Array.from(mcGrid.children).forEach(function(b) {
      b.disabled = true;
      if (b.textContent === correctDriver.name) b.classList.add('correct');
      else if (b.textContent === chosen.name && !correct) b.classList.add('wrong');
    });

    if (correct) {
      if (MODE === 'arcade') {
        pts = Math.round(100 + 900 * Math.max(0, 1 - (Date.now() - timerStart) / TIMER_MS));
      }
      qCorrect++;
    }
    totalScore += pts;
    updateScoreDisplay();
    showFeedback(correct ? 'correct' : 'wrong', correctDriver, pts);

    if (MODE === 'daily') {
      showDailyEnd(correct, correctDriver);
    } else {
      actionRow.hidden = false;
      skipBtn.hidden = true;
      nextBtn.textContent = qNum >= ROUND_SIZE ? 'Finish' : 'Next →';
    }
  }

  // ── Feedback ───────────────────────────────────────────────────────────────
  function showFeedback(type, driver, pts) {
    feedback.className = 'feedback-box ' + type;
    fbVerdict.textContent = type === 'correct'
      ? (pts ? '✓ Correct! +' + pts + ' pts' : '✓ Correct!')
      : type === 'timeout' ? '⏱ Time\'s up!'
      : '✗ Wrong';
    fbName.innerHTML = 'It was <a href="/drivers/' + driver.id + '">' + driver.name + '</a>';
    feedback.hidden = false;
  }

  // ── Arcade timer ───────────────────────────────────────────────────────────
  function startTimer() {
    timerStart = Date.now();
    timerFill.style.width = '100%';

    function tick() {
      var elapsed   = Date.now() - timerStart;
      var remaining = Math.max(0, TIMER_MS - elapsed);
      var pct       = remaining / TIMER_MS;
      var pts       = Math.round(100 + 900 * pct);

      timerFill.style.width      = (pct * 100) + '%';
      timerFill.style.background = pct > 0.4 ? 'var(--red)' : '#c4952a';
      timerPts.textContent = '+' + pts;
      timerSec.textContent = (remaining / 1000).toFixed(1) + 's';

      if (elapsed >= TIMER_MS) { handleTimeout(currentQ.driver); return; }
      timerRAF = requestAnimationFrame(tick);
    }
    timerRAF = requestAnimationFrame(tick);
  }

  function stopTimer() {
    if (timerRAF) { cancelAnimationFrame(timerRAF); timerRAF = null; }
  }

  function handleTimeout(driver) {
    if (answered) return;
    answered = true;
    Array.from(mcGrid.children).forEach(function(b) {
      b.disabled = true;
      if (b.textContent === driver.name) b.classList.add('correct');
    });
    showFeedback('timeout', driver, 0);
    actionRow.hidden = false;
    skipBtn.hidden = true;
    nextBtn.textContent = qNum >= ROUND_SIZE ? 'Finish' : 'Next →';
  }

  // ── Score display ──────────────────────────────────────────────────────────
  function updateScoreDisplay() {
    scoreVal.textContent = totalScore;
  }

  // ── End round ──────────────────────────────────────────────────────────────
  function endRound() {
    stopTimer();
    game.hidden = true; endscreen.hidden = false;

    endLabel.textContent  = MODE === 'arcade' ? '⏱ Arcade Score' : '💬 Casual Score';
    endScore.textContent  = totalScore;
    endCorrect.textContent = qCorrect + ' / ' + ROUND_SIZE + ' correct';
    endShare.hidden = true;
    changeSettings.hidden = false;

    var combo    = DIFF + ':' + DECADE;
    var prev     = getBest(combo);
    var isNew    = totalScore > (prev ? prev.score : -1);
    if (isNew) saveBest(combo, totalScore, qCorrect);

    var bestSc   = isNew ? totalScore : (prev ? prev.score : null);
    endBest.textContent  = bestSc != null ? 'Best: ' + bestSc + ' pts' : '';
    endNewBest.hidden    = !isNew;
  }

  // ── Daily end ──────────────────────────────────────────────────────────────
  function showDailyEnd(won, driver) {
    var idx = dayIndex();
    var today = new Date();
    var dateStr = today.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' });
    var chain = driver.chain.join(' → ');
    var text  = 'F1 Daily Chain #' + idx + ' (' + dateStr + ')\n' +
      chain + '\n' + (won ? '✓ Got it!' : '✗ Missed it') + '\nf1delta.com/trivia';

    shareText.textContent = text;

    setTimeout(function() {
      game.hidden = true; endscreen.hidden = false;
      endLabel.textContent   = '📅 Daily #' + idx;
      endScore.textContent   = won ? '✓' : '✗';
      endCorrect.textContent = won ? 'Correct!' : 'Better luck tomorrow';
      endBest.textContent    = '';
      endNewBest.hidden      = true;
      endShare.hidden        = false;
      changeSettings.hidden  = true;
    }, 1200);
  }

  copyBtn.addEventListener('click', function() {
    navigator.clipboard.writeText(shareText.textContent).then(function() {
      copyBtn.textContent = 'Copied!'; copyBtn.classList.add('copied');
      setTimeout(function() {
        copyBtn.textContent = 'Copy result'; copyBtn.classList.remove('copied');
      }, 2000);
    });
  });

  // ── Next / Skip ────────────────────────────────────────────────────────────
  nextBtn.addEventListener('click', function() {
    if (MODE === 'daily') {
      game.hidden = true; endscreen.hidden = false;
    } else if (qNum >= ROUND_SIZE) {
      endRound();
    } else {
      showNextQuestion();
    }
  });

  skipBtn.addEventListener('click', function() {
    if (answered || !currentQ) return;
    answered = true;
    stopTimer();
    showFeedback('wrong', currentQ.driver, 0);
    actionRow.hidden = false;
    skipBtn.hidden = true;
    nextBtn.textContent = qNum >= ROUND_SIZE ? 'Finish' : 'Next →';
  });

  // ── Free-text (casual mode) ────────────────────────────────────────────────
  var ftActiveIdx = -1;

  ftIn.addEventListener('input', function() {
    var q = ftIn.value.trim().toLowerCase();
    if (!q) { ftSuggest.hidden = true; return; }
    var matches = pool
      .filter(function(d) {
        var n = d.name.toLowerCase();
        return n.startsWith(q) || n.split(/\s+/).some(function(p) { return p.startsWith(q); });
      })
      .slice(0, 8);
    renderSuggestions(matches);
  });

  function renderSuggestions(matches) {
    ftSuggest._matches = matches;
    ftActiveIdx = -1;
    if (!matches.length) { ftSuggest.hidden = true; return; }
    ftSuggest.innerHTML = '';
    matches.forEach(function(d) {
      var opt = document.createElement('div');
      opt.className = 'ft-opt'; opt.textContent = d.name;
      opt.addEventListener('mousedown', function(e) { e.preventDefault(); selectFTDriver(d); });
      ftSuggest.appendChild(opt);
    });
    ftSuggest.hidden = false;
  }

  ftIn.addEventListener('keydown', function(e) {
    var opts = Array.from(ftSuggest.querySelectorAll('.ft-opt'));
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      ftActiveIdx = Math.min(ftActiveIdx + 1, opts.length - 1);
      opts.forEach(function(o, i) { o.classList.toggle('active', i === ftActiveIdx); });
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      ftActiveIdx = Math.max(ftActiveIdx - 1, -1);
      opts.forEach(function(o, i) { o.classList.toggle('active', i === ftActiveIdx); });
    } else if (e.key === 'Enter') {
      e.preventDefault();
      var matches = ftSuggest._matches || [];
      if (ftActiveIdx >= 0 && matches[ftActiveIdx]) selectFTDriver(matches[ftActiveIdx]);
      else if (matches.length === 1) selectFTDriver(matches[0]);
      else ftSuggest.hidden = false;
    } else if (e.key === 'Escape') {
      ftSuggest.hidden = true; ftActiveIdx = -1;
    }
  });

  ftIn.addEventListener('blur', function() {
    setTimeout(function() { ftSuggest.hidden = true; ftActiveIdx = -1; }, 160);
  });

  function selectFTDriver(d) {
    ftSuggest.hidden = true;
    ftIn.value = d.name;
    if (!currentQ || answered) return;
    answered = true;
    var correct = d.id === currentQ.driver.id;
    if (correct) qCorrect++;
    updateScoreDisplay();
    showFeedback(correct ? 'correct' : 'wrong', currentQ.driver, 0);
    actionRow.hidden = false;
    skipBtn.hidden = true;
    nextBtn.textContent = qNum >= ROUND_SIZE ? 'Finish' : 'Next →';
  }

  // ── Reset ──────────────────────────────────────────────────────────────────
  function reset() {
    stopTimer();
    totalScore = 0; qNum = 0; qCorrect = 0; answered = false; currentQ = null;
    used.clear();
    updateScoreDisplay();
    feedback.hidden = true; actionRow.hidden = true;
    mcGrid.hidden = true; ftWrap.hidden = true;
    timerWrap.hidden = true; dailyMeta.hidden = true;
    skipBtn.hidden = false; endShare.hidden = true;
    endNewBest.hidden = true;
    if (qCounter) { qCounter.textContent = ''; qCounter.hidden = true; }
    if (scoreChip) scoreChip.hidden = true;
  }

  // ── Eager data preload (for chip availability on landing) ──────────────────
  loadData().catch(function() {});

})();
</script>

</BaseLayout>
