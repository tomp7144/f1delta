---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";

const raw = JSON.parse(fs.readFileSync(path.resolve("./data/standings/index.json"), "utf8"));
const seasons = raw.seasons as any[];
---

<BaseLayout
  title="F1 Championship Standings — Every Season | f1delta"
  description="Formula 1 World Championship standings for every season, 1950 to today. World Drivers' and Constructors' champions season by season."
  canonical="https://f1delta.com/standings"
>
  <div class="hub">
    <h1>Standings</h1>
    <p class="lede">
      World Championship results for all {seasons.length} seasons, 1950&ndash;present.
      The Constructors&rsquo; Championship began in 1958; earlier seasons list a World Champion only.
    </p>

    <div class="card">
      <div class="table-scroll">
      <table data-standings-table>
        <thead>
          <tr>
            <th data-sort="year" data-type="num" aria-sort="descending" tabindex="0">Year</th>
            <th class="l" data-sort="wdc" data-type="text" tabindex="0">World Champion</th>
            <th class="l" data-sort="wcc" data-type="text" tabindex="0">Constructors&rsquo; Champion</th>
            <th data-sort="drivers" data-type="num" tabindex="0">Drivers</th>
          </tr>
        </thead>
        <tbody>
          {seasons.map((s: any) => {
            const wccName = s.wccChampion?.name ?? "—";
            const wccId   = s.wccChampion?.constructorId ?? null;
            const wdcName = s.wdcChampion?.name ?? "—";
            return (
              <tr
                data-year={s.year}
                data-wdc={wdcName}
                data-wcc={wccName}
                data-drivers={s.driverCount}
                class={s.year >= 1958 && s.wccChampion ? "champ-row" : ""}
              >
                <td class="yr">
                  <a href={`/standings/${s.year}`}>{s.year}</a>
                </td>
                <td class="drv">
                  {s.wdcChampion
                    ? (<>
                        <a href={`/drivers/${encodeURIComponent(s.wdcChampion.driverId)}`}>
                          {s.wdcChampion.name}
                        </a>
                        {s.wdcChampion.code && <span class="code">{s.wdcChampion.code}</span>}
                      </>)
                    : <span class="dash">—</span>
                  }
                </td>
                <td class="con">
                  {wccId
                    ? <a href={`/teams/${wccId}`}>{wccName}</a>
                    : <span class="dash">{wccName}</span>}
                </td>
                <td class="num">{s.driverCount}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <script is:inline>
  (function () {
    var table = document.querySelector("[data-standings-table]");
    if (!table) return;
    var tbody = table.tBodies[0];
    var sortKey = "year";
    var sortDir = -1;

    function sortBy(key, type) {
      if (sortKey === key) { sortDir = -sortDir; }
      else { sortKey = key; sortDir = type === "text" ? 1 : -1; }

      var rows = Array.prototype.slice.call(tbody.rows);
      rows.sort(function (a, b) {
        var av = a.getAttribute("data-" + key) || "";
        var bv = b.getAttribute("data-" + key) || "";
        if (type === "num") { av = parseFloat(av) || 0; bv = parseFloat(bv) || 0; }
        else { av = av.toLowerCase(); bv = bv.toLowerCase(); }
        if (av < bv) return -sortDir;
        if (av > bv) return sortDir;
        return 0;
      });
      var frag = document.createDocumentFragment();
      rows.forEach(function (r) { frag.appendChild(r); });
      tbody.appendChild(frag);

      var heads = table.tHead.rows[0].cells;
      for (var i = 0; i < heads.length; i++) heads[i].removeAttribute("aria-sort");
      var active = table.querySelector('[data-sort="' + key + '"]');
      if (active) active.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
    }

    var heads = table.querySelectorAll("th[data-sort]");
    for (var i = 0; i < heads.length; i++) {
      (function (th) {
        th.addEventListener("click", function () {
          sortBy(th.getAttribute("data-sort"), th.getAttribute("data-type") || "text");
        });
        th.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            sortBy(th.getAttribute("data-sort"), th.getAttribute("data-type") || "text");
          }
        });
      })(heads[i]);
    }
  })();
  </script>
</BaseLayout>

<style>
  .hub {
    max-width: 760px; margin: 0 auto; padding: 28px 20px 48px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: #16161a;
  }
  h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .lede { color: #6b6b70; margin: 0 0 18px; font-size: 15px; line-height: 1.5; max-width: 58ch; }

  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: clip; }

  th { text-align: right; }
  th.l { text-align: left; }
  td { white-space: nowrap; }

  td.yr { text-align: right; font-variant-numeric: tabular-nums; }
  td.yr a { color: #16161a; text-decoration: none; font-weight: 600; font-size: 13px; }
  td.yr a:hover { color: #e10600; }

  td.drv { text-align: left; }
  td.drv a { color: #16161a; text-decoration: none; font-weight: 500; }
  td.drv a:hover { text-decoration: underline; }
  .code {
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 10px; color: #9a9a9e; margin-left: 6px; letter-spacing: .04em;
  }

  td.con { text-align: left; }
  td.con a { color: #6b6b70; text-decoration: none; }
  td.con a:hover { color: #16161a; }
  .dash { color: #c4c4c9; }

  td.num {
    text-align: right; color: #6b6b70;
    font-variant-numeric: tabular-nums; font-feature-settings: "tnum";
  }
</style>
