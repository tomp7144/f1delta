---
export const prerender = true;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const DIR = path.resolve("./data/standings");
  const index = JSON.parse(fs.readFileSync(path.join(DIR, "index.json"), "utf8"));
  const allYears: number[] = index.seasons.map((s: any) => s.year);
  return index.seasons.map((s: any) => ({
    params: { year: String(s.year) },
    props: {
      season: JSON.parse(fs.readFileSync(path.join(DIR, `${s.year}.json`), "utf8")),
      allYears,
    },
  }));
}

const { season, allYears } = Astro.props as { season: any; allYears: number[] };
const { year, wccExists, wdcChampion, wccChampion, wdc, wcc, races, notes } = season;

const prevYear = allYears.includes(year - 1) ? year - 1 : null;
const nextYear = allYears.includes(year + 1) ? year + 1 : null;

const fmt = (n: number | null | undefined) => {
  if (n == null) return "";
  return n % 1 === 0 ? String(n) : n.toFixed(1);
};
---

<BaseLayout
  title={`${year} F1 Championship Standings | f1delta`}
  description={`${year} Formula 1 championship standings. World Champion: ${wdcChampion.name}${wccChampion ? `. Constructors' Champion: ${wccChampion.name}.` : "."}`}
  canonical={`https://f1delta.com/standings/${year}`}
>
  <div class="hub">

    <div class="season-nav">
      {prevYear
        ? <a href={`/standings/${prevYear}`} class="snav-link">&#8592; {prevYear}</a>
        : <span class="snav-blank"></span>}
      <a href="/standings" class="snav-index">All seasons</a>
      {nextYear
        ? <a href={`/standings/${nextYear}`} class="snav-link">{nextYear} &#8594;</a>
        : <span class="snav-blank"></span>}
    </div>

    <h1>{year}</h1>

    <div class="champ-strip">
      <div class="champ-item">
        <span class="champ-label">World Champion</span>
        <a class="champ-name" href={`/driver?d=${wdcChampion.driverId}`}>{wdcChampion.name}</a>
      </div>
      {wccChampion && (
        <div class="champ-item">
          <span class="champ-label">Constructors' Champion</span>
          <a class="champ-name" href={`/teams/${wccChampion.constructorId}`}>{wccChampion.name}</a>
        </div>
      )}
    </div>

    {notes && (
      <div class="notes-block">
        <p>{notes}</p>
      </div>
    )}

    <section>
      <h2 class="sec-h">Drivers' Championship</h2>
      <div class="card">
        <table>
          <thead>
            <tr>
              <th class="pos">Pos</th>
              <th class="l">Driver</th>
              <th class="l">Team</th>
              <th class="r">Points</th>
            </tr>
          </thead>
          <tbody>
            {(wdc ?? []).map((row: any) => (
              <tr class={row.position === 1 ? "champ" : ""}>
                <td class="pos">{row.position}</td>
                <td class="drv">
                  <a href={`/driver?d=${encodeURIComponent(row.driverId)}`}>{row.name}</a>
                  {row.code && <span class="code">{row.code}</span>}
                </td>
                <td class="team">
                  <a href={`/teams/${row.teamId}`}>{row.team}</a>
                </td>
                <td class="pts">{fmt(row.points)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {wccExists ? (
      <section>
        <h2 class="sec-h">Constructors' Championship</h2>
        <div class="card">
          <table>
            <thead>
              <tr>
                <th class="pos">Pos</th>
                <th class="l">Constructor</th>
                <th class="r">Points</th>
              </tr>
            </thead>
            <tbody>
              {(wcc ?? []).map((row: any) => (
                <tr class={row.championshipWon ? "champ" : ""}>
                  <td class="pos">{row.position}</td>
                  <td class="team">
                    <a href={`/teams/${row.constructorId}`}>{row.name}</a>
                  </td>
                  <td class="pts">{fmt(row.points)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <p class="no-wcc">The Constructors&rsquo; Championship was not awarded until 1958.</p>
    )}

    {races && races.length > 0 && (
      <section>
        <h2 class="sec-h">Races</h2>
        <div class="card">
          <table>
            <thead>
              <tr>
                <th class="pos">Rd</th>
                <th class="l">Grand Prix</th>
                <th class="l">Winner</th>
              </tr>
            </thead>
            <tbody>
              {races.map((r: any) => (
                <tr>
                  <td class="pos">{r.round}</td>
                  <td class="gp"><a href={`/grands-prix/${r.grandPrixId}`}>{r.name}</a></td>
                  <td class="drv"><a href={`/driver?d=${encodeURIComponent(r.winnerId)}`}>{r.winner}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .hub {
    max-width: 760px; margin: 0 auto; padding: 20px 20px 48px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: #16161a;
  }

  .season-nav {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .snav-link {
    font-size: 13px; color: #6b6b70; text-decoration: none;
    padding: 4px 0;
  }
  .snav-link:hover { color: #16161a; }
  .snav-index {
    font-size: 12px; color: #9a9a9e; text-decoration: none;
    letter-spacing: .04em;
  }
  .snav-index:hover { color: #6b6b70; }
  .snav-blank { display: inline-block; width: 60px; }

  h1 {
    font-size: 36px; font-weight: 700; margin: 0 0 10px;
    letter-spacing: -.02em; line-height: 1;
  }

  .champ-strip {
    display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 22px;
  }
  .champ-item { display: flex; flex-direction: column; gap: 2px; }
  .champ-label {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .08em; color: #6b6b70;
  }
  .champ-name {
    font-size: 15px; font-weight: 600; color: #16161a; text-decoration: none;
  }
  .champ-name:hover { color: #e10600; }

  .notes-block {
    background: #fff; border: 1px solid #e4e4df; border-left: 3px solid #6b6b70;
    border-radius: 5px; padding: 10px 14px; margin-bottom: 18px;
    font-size: 14px; color: #6b6b70; line-height: 1.5;
  }
  .notes-block p { margin: 0; }

  .no-wcc {
    font-size: 13px; color: #9a9a9e; margin: 16px 0 0;
    font-style: italic;
  }

  section { margin-top: 20px; }
  .sec-h {
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .08em; color: #6b6b70; margin: 0 0 7px;
  }

  .card {
    background: #fff; border: 1px solid #e4e4df;
    border-radius: 8px; overflow: clip;
  }

  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th {
    text-align: right; padding: 8px 12px; font-size: 11px; font-weight: 600;
    color: #6b6b70; text-transform: uppercase; letter-spacing: .04em;
    border-bottom: 2px solid #e4e4df; white-space: nowrap; background: #fff;
  }
  th.pos { text-align: left; width: 36px; }
  th.l   { text-align: left; }
  th.r   { text-align: right; }
  td {
    padding: 8px 12px; border-bottom: 1px solid #e4e4df;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  tr:last-child td { border-bottom: none; }
  tr.champ td { background: #fbf3d0; }
  tr:hover td { background: #faf9f6; }
  tr.champ:hover td { background: #f5ecbf; }

  td.pos {
    color: #6b6b70; font-size: 12px; width: 36px;
  }
  tr.champ td.pos { color: #b8962e; font-weight: 600; }

  td.drv { text-align: left; }
  td.drv a { color: #16161a; text-decoration: none; font-weight: 500; }
  td.drv a:hover { text-decoration: underline; }
  .code {
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 10px; color: #9a9a9e; margin-left: 7px; letter-spacing: .04em;
  }
  tr.champ .code { color: #b8962e; }

  td.team { text-align: left; }
  td.team a { color: #6b6b70; text-decoration: none; font-size: 13px; }
  td.team a:hover { color: #16161a; }

  td.gp { text-align: left; }
  td.gp a { color: #16161a; text-decoration: none; font-weight: 500; }
  td.gp a:hover { text-decoration: underline; }

  td.pts {
    text-align: right; color: #6b6b70;
    font-feature-settings: "tnum";
  }
  tr.champ td.pts { color: #b8962e; font-weight: 600; }
</style>
