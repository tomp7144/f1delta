---
// EngineersHub.astro — the /engineers index, fully static + sortable via /f1-records.js.
const { engineers } = Astro.props;
---

<section class="hub">
  <h1>Race Engineers</h1>
  <p class="lede">The engineers on the pitwall — current grid pairings and historical careers.</p>

  <div class="card">
    <div class="table-scroll">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="name" data-type="text" aria-sort="ascending">Engineer</th>
          <th data-sort="driver" data-type="text">Current Driver</th>
          <th data-sort="team" data-type="text">Team</th>
          <th class="num" data-sort="since" data-type="num">Since</th>
          <th class="num" data-sort="pairings" data-type="num">Pairings</th>
        </tr>
      </thead>
      <tbody>
        {engineers.map((e: any) => (
          <tr data-name={e.name} data-driver={e.currentDriverName ?? ""}
              data-team={e.currentTeamId ?? ""} data-since={e.currentFromYear ?? 0}
              data-pairings={e.pairingsCount}>
            <td>
              <a class="ent" href={`/people/${e.id}`}>{e.name}</a>
              {e.aka && <span class="aka">"{e.aka}"</span>}
            </td>
            <td>{e.currentDriverName
              ? <a class="dim-link" href={`/driver?d=${e.currentDriverId}`}>{e.currentDriverName}</a>
              : <span class="muted">—</span>}
            </td>
            <td>{e.currentTeamId
              ? <a class="dim-link" href={`/teams/${e.currentTeamId}`}>{e.currentTeamName ?? e.currentTeamId}</a>
              : <span class="muted">—</span>}
            </td>
            <td class="num">{e.currentFromYear ?? "—"}</td>
            <td class="num">{e.pairingsCount}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
</section>

<style>
  .hub { max-width: 760px; margin: 0 auto; padding: 28px 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #16161a; }
  .hub h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .lede { color: #6b6b70; margin: 0 0 18px; font-size: 15px; }
  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: clip; }
  .ent { color: #16161a; text-decoration: none; font-weight: 500; }
  .ent:hover { text-decoration: underline; }
  .aka { color: #6b6b70; font-size: 12px; margin-left: 6px; font-style: italic; }
  .dim-link { color: #6b6b70; text-decoration: none; }
  .dim-link:hover { color: #16161a; text-decoration: underline; }
  .muted { color: #9a9a9e; }
</style>
