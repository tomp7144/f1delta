---
// PeopleHub.astro — generic hub for team principals and technical directors.
const { people, title, lede } = Astro.props;
---

<section class="hub">
  <h1>{title}</h1>
  <p class="lede">{lede}</p>

  <div class="card">
    <div class="table-scroll">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="name" data-type="text" aria-sort="ascending">Name</th>
          <th data-sort="team" data-type="text">Team(s)</th>
          <th class="num" data-sort="from" data-type="num">First year</th>
          <th class="num" data-sort="to" data-type="num">Last year</th>
        </tr>
      </thead>
      <tbody>
        {people.map((p: any) => (
          <tr data-name={p.name} data-team={p.teams.join(", ")}
              data-from={p.firstYear ?? 0} data-to={p.lastYear ?? 0}>
            <td>
              <a class="ent" href={`/people/${p.id}`}>{p.name}</a>
              {p.aka && <span class="aka">"{p.aka}"</span>}
            </td>
            <td class="teams">{p.teams.join(", ")}</td>
            <td class="num">{p.firstYear ?? "—"}</td>
            <td class="num">{p.status === "active" ? <span class="active">present</span> : (p.lastYear ?? "—")}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
</section>

<style>
  .hub { max-width: 760px; margin: 0 auto; padding: 28px 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #16161a; }
  .hub h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .lede { color: #6b6b70; margin: 0 0 18px; font-size: 15px; }
  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: hidden; }
  .ent { color: #16161a; text-decoration: none; font-weight: 500; }
  .ent:hover { text-decoration: underline; }
  .aka { color: #6b6b70; font-size: 12px; margin-left: 6px; font-style: italic; }
  .teams { color: #6b6b70; font-size: 13px; }
  .active { color: #2a7a3b; font-weight: 500; }
</style>
