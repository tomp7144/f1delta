---
const { index } = Astro.props;
const circuits = index.circuits;

function flag(a2: string | null | undefined) {
  if (!a2 || a2.length !== 2) return "";
  const A = 0x1f1e6, base = 65;
  return String.fromCodePoint(...([...a2.toUpperCase()].map((c) => A + (c.charCodeAt(0) - base)))) + " ";
}
---

<section class="hub">
  <h1>F1 Circuits</h1>
  <p class="lede">Every track that has hosted a World Championship race, 1950–present.</p>

  <div class="card">
    <div class="table-scroll">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="name" data-type="text">Circuit</th>
          <th data-sort="type" data-type="text">Type</th>
          <th class="num" data-sort="races" data-type="num" aria-sort="descending">Races</th>
          <th class="num" data-sort="length" data-type="num">Length (km)</th>
          <th class="num" data-sort="turns" data-type="num">Turns</th>
          <th data-sort="first" data-type="num">First</th>
          <th data-sort="last" data-type="num">Last</th>
        </tr>
      </thead>
      <tbody>
        {circuits.map((c) => (
          <tr
            data-name={c.name}
            data-type={c.type}
            data-races={c.totalRacesHeld}
            data-length={c.length ?? 0}
            data-turns={c.turns ?? 0}
            data-first={c.firstYear ?? 0}
            data-last={c.lastYear ?? 0}
          >
            <td>
              <a class="ent" href={`/circuits/${c.id}`}>{c.name}</a>
              {c.country && <span class="nat">{flag(c.country.a2)}{c.placeName ?? c.country.name}</span>}
            </td>
            <td class="typ">{c.type === "STREET" ? "Street" : "Race"}</td>
            <td class="num val">{c.totalRacesHeld}</td>
            <td class="num">{c.length?.toFixed(3) ?? "—"}</td>
            <td class="num">{c.turns ?? "—"}</td>
            <td class="yrs">{c.firstYear ?? "—"}</td>
            <td class="yrs">{c.lastYear ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
</section>

<style>
  .hub {
    max-width: 760px; margin: 0 auto; padding: 28px 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #16161a;
  }
  .hub h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .lede { color: #6b6b70; margin: 0 0 18px; font-size: 15px; }
  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: hidden; }
  .val  { font-weight: 600; }
  .yrs  { color: #6b6b70; font-variant-numeric: tabular-nums; }
  .typ  { color: #6b6b70; font-size: 13px; }
  .ent  { color: #16161a; text-decoration: none; font-weight: 500; }
  .ent:hover { text-decoration: underline; }
  .nat  { color: #6b6b70; font-size: 12px; margin-left: 8px; white-space: nowrap; }
</style>
