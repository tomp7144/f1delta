---
const { current } = Astro.props;
---
<nav class="site-nav">
  <a class="wordmark" href="/">f1delta</a>
  <a href="/records" aria-current={current === "records" ? "page" : undefined}>Records</a>
  <a href="/teams" aria-current={current === "teams" ? "page" : undefined}>Teams</a>
</nav>
<style>
  .site-nav {
    max-width: 760px; margin: 0 auto; padding: 10px 20px;
    display: flex; align-items: center; gap: 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 14px; border-bottom: 1px solid #e4e4df;
  }
  .wordmark { font-weight: 700; color: #e10600; text-decoration: none; margin-right: 4px; }
  .site-nav a { color: #6b6b70; text-decoration: none; }
  .site-nav a:hover { color: #16161a; }
  .site-nav a[aria-current] { color: #16161a; font-weight: 600; }
</style>
