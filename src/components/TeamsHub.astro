---
// TeamsHub.astro — the /teams index, fully static + sortable via /f1-records.js.
const { index } = Astro.props;
const teams = index.teams;

function flag(a2) {
  if (!a2 || a2.length !== 2) return "";
  const A = 0x1f1e6, base = 65;
  return String.fromCodePoint(...[...a2.toUpperCase()].map((c) => A + (c.charCodeAt(0) - base))) + " ";
}
const fmt = (n) => (typeof n === "number" ? n.toLocaleString("en-US") : n);
const active = (t) => (t.first == null ? "—" : t.first === t.last ? `${t.first}` : `${t.first}\u2013${t.last}`);
---

<section class="hub">
  <h1>F1 Teams</h1>
  <p class="lede">Every constructor in World Championship history, 1950&ndash;present.</p>

  <div class="card">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="name" data-type="text">Team</th>
          <th class="num" data-sort="championships" data-type="num">Titles</th>
          <th class="num" data-sort="wins" data-type="num" aria-sort="descending">Wins</th>
          <th class="num" data-sort="points" data-type="num">Points</th>
          <th class="num" data-sort="entries" data-type="num">Entries</th>
          <th data-sort="first" data-type="num">Active</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((t) => (
          <tr data-name={t.name} data-championships={t.championships} data-wins={t.wins}
              data-points={t.points} data-entries={t.entries} data-first={t.first ?? 0}>
            <td>
              <a class="ent" href={`/teams/${t.id}`}>{t.name}</a>
              {t.nat && <span class="nat">{flag(t.nat.a2)}{t.nat.code || t.nat.id}</span>}
            </td>
            <td class="num">{t.championships || "—"}</td>
            <td class="num val">{fmt(t.wins)}</td>
            <td class="num">{fmt(t.points)}</td>
            <td class="num">{fmt(t.entries)}</td>
            <td class="yrs">{active(t)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div id="teams-ad-slot" data-ad-slot></div>
</section>

<style>
  .hub { max-width: 760px; margin: 0 auto; padding: 28px 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #16161a; }
  .hub h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .lede { color: #6b6b70; margin: 0 0 18px; font-size: 15px; }
  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { text-align: left; padding: 8px 12px; font-size: 11px; font-weight: 600; color: #6b6b70;
    text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #e4e4df;
    cursor: pointer; user-select: none; white-space: nowrap; }
  th:focus-visible { outline: 2px solid #e10600; outline-offset: -2px; }
  th[aria-sort="ascending"]::after { content: " \25B2"; }
  th[aria-sort="descending"]::after { content: " \25BC"; }
  td { padding: 8px 12px; border-bottom: 1px solid #e4e4df; }
  .num { text-align: right; font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }
  .val { font-weight: 600; }
  .yrs { color: #6b6b70; font-variant-numeric: tabular-nums; }
  .ent { color: #16161a; text-decoration: none; font-weight: 500; }
  .ent:hover { text-decoration: underline; }
  .nat { color: #6b6b70; font-size: 12px; margin-left: 8px; white-space: nowrap; }
</style>
