---
const { index } = Astro.props;
const gps = index.grandsPrix;

function flag(a2: string | null | undefined) {
  if (!a2 || a2.length !== 2) return "";
  const A = 0x1f1e6, base = 65;
  return String.fromCodePoint(...([...a2.toUpperCase()].map((c) => A + (c.charCodeAt(0) - base)))) + " ";
}
---

<section class="hub">
  <h1>F1 Grands Prix</h1>
  <p class="lede">Every Grand Prix in World Championship history, 1950–present.</p>

  <div class="card">
    <div class="table-scroll">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="name" data-type="text">Grand Prix</th>
          <th class="num" data-sort="runnings" data-type="num" aria-sort="descending">Runnings</th>
          <th data-sort="first" data-type="num">First</th>
          <th data-sort="last" data-type="num">Last</th>
          <th class="num" data-sort="circuits" data-type="num">Circuits</th>
        </tr>
      </thead>
      <tbody>
        {gps.map((gp) => (
          <tr
            data-name={gp.name}
            data-runnings={gp.runnings}
            data-first={gp.firstYear ?? 0}
            data-last={gp.lastYear ?? 0}
            data-circuits={gp.circuits}
          >
            <td>
              <a class="ent" href={`/grands-prix/${gp.id}`}>{gp.name}</a>
              {gp.country && <span class="nat">{flag(gp.country.a2)}{gp.country.name}</span>}
            </td>
            <td class="num val">{gp.runnings}</td>
            <td class="yrs">{gp.firstYear ?? "—"}</td>
            <td class="yrs">{gp.lastYear ?? "—"}</td>
            <td class="num">{gp.circuits}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
</section>

<style>
  .hub {
    max-width: 760px; margin: 0 auto; padding: 28px 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #16161a;
  }
  .hub h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; letter-spacing: -.01em; }
  .lede { color: #6b6b70; margin: 0 0 18px; font-size: 15px; }
  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: clip; }
  .val  { font-weight: 600; }
  .yrs  { color: #6b6b70; font-variant-numeric: tabular-nums; }
  .ent  { color: #16161a; text-decoration: none; font-weight: 500; }
  .ent:hover { text-decoration: underline; }
  .nat  { color: #6b6b70; font-size: 12px; margin-left: 8px; white-space: nowrap; }
</style>
