---
// TeamPage.astro — one constructor's page, fully static. Totals strip, season-by-
// season table, and the full driver lineup. Sorting via the shared /f1-records.js
// (tables tagged data-record-table). Light reference-desk theme.
const { team, engineers = [] } = Astro.props;
const { name, fullName, nat, span, totals, seasons, drivers } = team;

function flag(a2: string) {
  if (!a2 || a2.length !== 2) return "";
  const A = 0x1f1e6, base = 65;
  return String.fromCodePoint(...[...a2.toUpperCase()].map((c) => A + (c.charCodeAt(0) - base))) + " ";
}
const fmt = (n: number) => (typeof n === "number" ? n.toLocaleString("en-US") : n);
const years = span.first ? (span.first === span.last ? `${span.first}` : `${span.first}\u2013${span.last}`) : "";
const driverYears = (d: any) => (d.first == null ? "—" : d.first === d.last ? `${d.first}` : `${d.first}\u2013${d.last}`);

const STATS = [
  ["Championships", totals.championships],
  ["Wins", totals.wins],
  ["Podiums", totals.podiums],
  ["Poles", totals.poles],
  ["Points", totals.points],
  ["Entries", totals.entries],
];
---

<section class="team">
  <a class="back" href="/teams">← All teams</a>
  <h1>{name}</h1>
  <p class="sub">
    {nat && <span class="nat">{flag(nat.a2)}{nat.code || nat.id}</span>}
    {years && <span class="dot">·</span>}{years}
    {fullName && fullName !== name && <span class="full"> · {fullName}</span>}
  </p>

  <div class="stats">
    {STATS.map(([label, v]) => (
      <div class="stat">
        <div class="stat-v">{fmt(v)}</div>
        <div class="stat-l">{label}</div>
      </div>
    ))}
  </div>

  <h2>Season by season</h2>
  <div class="card">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="year" data-type="num" aria-sort="descending">Year</th>
          <th class="num" data-sort="pos" data-type="num">Champ</th>
          <th class="num" data-sort="wins" data-type="num">Wins</th>
          <th class="num" data-sort="podiums" data-type="num">Podiums</th>
          <th class="num" data-sort="poles" data-type="num">Poles</th>
          <th class="num" data-sort="points" data-type="num">Points</th>
        </tr>
      </thead>
      <tbody>
        {seasons.map((s: any) => (
          <tr class={s.pos === 1 ? "champ" : undefined}
              data-year={s.year} data-pos={s.pos ?? 9999} data-wins={s.wins}
              data-podiums={s.podiums} data-poles={s.poles} data-points={s.points}>
            <td class="yr-lnk"><a href={`/standings/${s.year}`}>{s.year}</a></td>
            <td class="num">{s.pos == null ? "—" : s.pos}</td>
            <td class="num">{s.wins}</td>
            <td class="num">{s.podiums}</td>
            <td class="num">{s.poles}</td>
            <td class="num val">{fmt(s.points)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Drivers <span class="count">({drivers.length})</span></h2>
  <div class="card">
    <table data-record-table>
      <thead>
        <tr>
          <th data-sort="name" data-type="text">Driver</th>
          <th data-sort="first" data-type="num">Years</th>
          <th class="num" data-sort="races" data-type="num" aria-sort="descending">Races</th>
          <th class="num" data-sort="wins" data-type="num">Wins</th>
          <th class="num" data-sort="podiums" data-type="num">Podiums</th>
          <th class="num" data-sort="points" data-type="num">Points</th>
        </tr>
      </thead>
      <tbody>
        {drivers.map((d: any) => (
          <tr data-name={d.name} data-first={d.first ?? 0} data-races={d.races}
              data-wins={d.wins} data-podiums={d.podiums} data-points={d.points}>
            <td>
              <a class="ent" href={`/driver?d=${d.id}`}>{d.name}</a>
              {d.nat && <span class="nat">{flag(d.nat.a2)}{d.nat.code || d.nat.id}</span>}
            </td>
            <td class="yrs">{driverYears(d)}</td>
            <td class="num">{d.races}</td>
            <td class="num">{d.wins}</td>
            <td class="num">{d.podiums}</td>
            <td class="num val">{fmt(d.points)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {engineers.length > 0 && (
    <>
      <h2>Race engineers <span class="count">({engineers.length})</span></h2>
      <div class="card">
        <table data-f1-table>
          <thead>
            <tr>
              <th>Engineer</th>
              <th>Driver</th>
              <th>Years</th>
            </tr>
          </thead>
          <tbody>
            {engineers.map((e: any) => (
              <tr class={e.toYear === null ? "cur-eng" : undefined}>
                <td>
                  <a class="ent" href={`/people/${e.personId}`}>{e.personName}</a>
                </td>
                <td><a class="dim-link" href={`/driver?d=${e.driverId}`}>{e.driverName}</a></td>
                <td class="yrs">{e.fromYear === e.toYear ? e.fromYear : e.toYear === null ? `${e.fromYear}–present` : `${e.fromYear}–${e.toYear}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <div id="team-ad-slot" data-ad-slot></div>
</section>

<style>
  .team { max-width: 760px; margin: 0 auto; padding: 28px 20px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #16161a; }
  .back { color: #6b6b70; font-size: 13px; text-decoration: none; }
  .team h1 { font-size: 30px; font-weight: 700; margin: 10px 0 2px; letter-spacing: -.02em; }
  .sub { color: #6b6b70; margin: 0 0 20px; font-size: 14px; }
  .sub .nat { font-size: 13px; }
  .sub .dot { margin: 0 8px; }
  .sub .full { color: #9a9a9e; }
  .stats { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px;
    background: #e4e4df; border: 1px solid #e4e4df; border-radius: 8px; overflow: hidden; margin-bottom: 28px; }
  .stat { background: #fff; padding: 14px 10px; text-align: center; }
  .stat-v { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stat-l { font-size: 11px; color: #6b6b70; text-transform: uppercase; letter-spacing: .04em; margin-top: 2px; }
  .team h2 { font-size: 18px; font-weight: 700; margin: 24px 0 10px;
    border-left: 3px solid #e10600; padding-left: 10px; }
  .team h2 .count { color: #9a9a9e; font-weight: 500; font-size: 15px; }
  .card { background: #fff; border: 1px solid #e4e4df; border-radius: 8px; overflow: hidden; }
  .val { font-weight: 600; }
  .yrs { color: #6b6b70; font-variant-numeric: tabular-nums; }
  .ent { color: #16161a; text-decoration: none; font-weight: 500; }
  .ent:hover { text-decoration: underline; }
  td.yr-lnk { font-variant-numeric: tabular-nums; }
  td.yr-lnk a { color: #16161a; text-decoration: none; font-variant-numeric: tabular-nums; }
  td.yr-lnk a:hover { color: #e10600; }
  tr.champ td.yr-lnk a { color: #b8962e; }
  tr.champ td.yr-lnk a:hover { color: #e10600; }
  .nat { color: #6b6b70; font-size: 12px; margin-left: 8px; white-space: nowrap; }
  tr.champ { background: #fbf3d0; }
  tr.cur-eng td { background: #fbf3d0; }
  .dim-link { color: #6b6b70; text-decoration: none; }
  .dim-link:hover { color: #16161a; text-decoration: underline; }
  @media (max-width: 560px) { .stats { grid-template-columns: repeat(3, 1fr); } }
</style>
