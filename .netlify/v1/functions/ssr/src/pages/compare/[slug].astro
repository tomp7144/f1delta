---
export const prerender = false;
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import F1DeltaExplain from "../../components/F1DeltaExplain.astro";
import ReliabilityExplain from "../../components/ReliabilityExplain.astro";

// ── Module-level init (cold start, not per-request) ────────────────────────
const _root = path.resolve(".");

const { pairings: _pairings } = JSON.parse(
  fs.readFileSync(path.join(_root, "data/h2h-pairings.json"), "utf8")
);
const h2hSlugs = new Set<string>(_pairings.map((p: any) => p.slug));

const { drivers: _driverIndex } = JSON.parse(
  fs.readFileSync(path.join(_root, "data/drivers/index.json"), "utf8")
);
const validIds = new Set<string>(_driverIndex.map((d: any) => d.driverId));

// ── Request handling ───────────────────────────────────────────────────────
const { slug } = Astro.params as { slug: string };

const vsIdx = slug ? slug.indexOf("-vs-") : -1;
if (!slug || vsIdx < 0) return new Response(null, { status: 404 });

const rawA = slug.slice(0, vsIdx);
const rawB = slug.slice(vsIdx + 4);

if (!rawA || !rawB) return new Response(null, { status: 404 });

// Season mode: trailing -YYYY on each half (e.g. "ayrton-senna-1992")
// No driver ID ends in 4 digits (confirmed), so this is unambiguous.
const yearRe = /-(\d{4})$/;
const mA = rawA.match(yearRe);
const mB = rawB.match(yearRe);
// Mixed career/season not permitted — one has year, other doesn't → 404 (invalid ID fails validIds below)
const isSeasonMode = mA != null && mB != null;
const idA = isSeasonMode ? rawA.slice(0, mA!.index) : rawA;
const idB = isSeasonMode ? rawB.slice(0, mB!.index) : rawB;
const yearA: number | null = isSeasonMode ? parseInt(mA![1]) : null;
const yearB: number | null = isSeasonMode ? parseInt(mB![1]) : null;

if (idA === idB) return new Response(null, { status: 404 });

if (!validIds.has(idA) || !validIds.has(idB)) {
  return new Response(null, { status: 404 });
}

// Canonical: alphabetical by driver ID; years travel with their drivers
if (idA > idB) {
  const canonical = isSeasonMode
    ? `/compare/${idB}-${yearB}-vs-${idA}-${yearA}`
    : `/compare/${idB}-vs-${idA}`;
  return Astro.redirect(canonical, 301);
}

let dA: any, dB: any;
try {
  dA = JSON.parse(fs.readFileSync(path.join(_root, `data/drivers/${idA}.json`), "utf8"));
  dB = JSON.parse(fs.readFileSync(path.join(_root, `data/drivers/${idB}.json`), "utf8"));
} catch {
  return new Response(null, { status: 404 });
}

// Season-specific career rows — 404 if driver didn't race that year
const csA: any = isSeasonMode
  ? ((dA.career as any[]).find((c: any) => c.season === yearA) ?? null)
  : null;
const csB: any = isSeasonMode
  ? ((dB.career as any[]).find((c: any) => c.season === yearB) ?? null)
  : null;
if (isSeasonMode && (!csA || !csB)) return new Response(null, { status: 404 });

// CDN-cacheable: 1-hour browser, 7-day Netlify/Cloudflare, 1-day SWR
// Purge-on-deploy busts the CDN cache automatically.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400"
);

// ── Stats helpers ─────────────────────────────────────────────────────────
const tA = dA.totals ?? {};
const tB = dB.totals ?? {};

function pct(n: number, d: number) {
  return d > 0 ? (n / d * 100).toFixed(1) + "%" : "—";
}
function fmt(n: number | null | undefined) {
  if (n == null) return "—";
  return n % 1 === 0 ? String(n) : n.toFixed(1);
}

// Career teams (in order of first appearance, all teams including mid-season)
function careerTeams(d: any) {
  const seen = new Set<string>();
  const result: { id: string; name: string }[] = [];
  for (const s of (d.career ?? []) as any[]) {
    for (const t of (s.teams ?? []) as any[]) {
      if (t.constructorId && !seen.has(t.constructorId)) {
        seen.add(t.constructorId);
        result.push({ id: t.constructorId, name: t.constructor });
      }
    }
  }
  return result;
}
const teamsA = careerTeams(dA);
const teamsB = careerTeams(dB);

const seasonsA = Object.keys(dA.career ?? {}).length;
const seasonsB = Object.keys(dB.career ?? {}).length;

// ── Rate rows (era-fair, higher = better) ─────────────────────────────────
const rateRows = [
  {
    label: "Win %",
    aVal: pct(tA.wins ?? 0, tA.races ?? 0),
    bVal: pct(tB.wins ?? 0, tB.races ?? 0),
    aRaw: (tA.wins ?? 0) / (tA.races || 1),
    bRaw: (tB.wins ?? 0) / (tB.races || 1),
  },
  {
    label: "Podium %",
    aVal: pct(tA.podiums ?? 0, tA.races ?? 0),
    bVal: pct(tB.podiums ?? 0, tB.races ?? 0),
    aRaw: (tA.podiums ?? 0) / (tA.races || 1),
    bRaw: (tB.podiums ?? 0) / (tB.races || 1),
  },
  {
    label: "Pole %",
    aVal: pct(tA.poles ?? 0, tA.races ?? 0),
    bVal: pct(tB.poles ?? 0, tB.races ?? 0),
    aRaw: (tA.poles ?? 0) / (tA.races || 1),
    bRaw: (tB.poles ?? 0) / (tB.races || 1),
  },
];

// ── H2H cross-link ────────────────────────────────────────────────────────
const h2hSlug = [idA, idB].sort().join("-vs-");
const hasH2H = h2hSlugs.has(h2hSlug);

// ── f1δ lenses ────────────────────────────────────────────────────────────
const f1dA = (dA.f1delta ?? {}) as any;
const f1dB = (dB.f1delta ?? {}) as any;
const hasF1D = f1dA.career != null || f1dB.career != null;

const f1dRows = [
  {
    label: "Career f1δ",
    aVal: f1dA.career != null ? (f1dA.career as number).toFixed(1) : "—",
    bVal: f1dB.career != null ? (f1dB.career as number).toFixed(1) : "—",
    aRaw: f1dA.career ?? 0,
    bRaw: f1dB.career ?? 0,
  },
  {
    label: "Peak season",
    aVal: f1dA.peak != null ? `${(f1dA.peak as number).toFixed(1)} (${f1dA.peakYear})` : "—",
    bVal: f1dB.peak != null ? `${(f1dB.peak as number).toFixed(1)} (${f1dB.peakYear})` : "—",
    aRaw: f1dA.peak ?? 0,
    bRaw: f1dB.peak ?? 0,
  },
  {
    label: "Seasonal wins",
    aVal: f1dA.seasonalWins != null ? String(f1dA.seasonalWins) : "—",
    bVal: f1dB.seasonalWins != null ? String(f1dB.seasonalWins) : "—",
    aRaw: f1dA.seasonalWins ?? 0,
    bRaw: f1dB.seasonalWins ?? 0,
  },
  {
    label: "Seasonal podiums",
    aVal: f1dA.seasonalPodiums != null ? String(f1dA.seasonalPodiums) : "—",
    bVal: f1dB.seasonalPodiums != null ? String(f1dB.seasonalPodiums) : "—",
    aRaw: f1dA.seasonalPodiums ?? 0,
    bRaw: f1dB.seasonalPodiums ?? 0,
  },
  {
    label: "Longest stretch",
    aVal: f1dA.dominantStretch > 0
      ? `${f1dA.dominantStretch} · ${f1dA.stretchStart}–${f1dA.stretchEnd}`
      : f1dA.career != null ? "0" : "—",
    bVal: f1dB.dominantStretch > 0
      ? `${f1dB.dominantStretch} · ${f1dB.stretchStart}–${f1dB.stretchEnd}`
      : f1dB.career != null ? "0" : "—",
    aRaw: f1dA.dominantStretch ?? 0,
    bRaw: f1dB.dominantStretch ?? 0,
  },
];

// Season f1δ lookup (only used in season mode)
const f1dSeasonA = isSeasonMode
  ? ((f1dA.seasons as any[] | undefined)?.find((s: any) => s.year === yearA) ?? null)
  : null;
const f1dSeasonB = isSeasonMode
  ? ((f1dB.seasons as any[] | undefined)?.find((s: any) => s.year === yearB) ?? null)
  : null;

// Mode toggle URLs
const peakYearA: number = (f1dA.peakYear as number | undefined) ?? (dA.firstSeason as number);
const peakYearB: number = (f1dB.peakYear as number | undefined) ?? (dB.firstSeason as number);
const careerUrl = "/compare/" + idA + "-vs-" + idB;
const toSeasonUrl = "/compare/" + idA + "-" + peakYearA + "-vs-" + idB + "-" + peakYearB;

// ── Reliability rows (neutral in career mode — era-dependent) ─────────────
const relPct = (n: number, d: number) => d > 0 ? (n / d * 100).toFixed(1) + "%" : "—";
const relRows = [
  {
    label: "DNF rate",
    aVal: relPct(tA.dnfCount ?? 0, tA.races ?? 0),
    bVal: relPct(tB.dnfCount ?? 0, tB.races ?? 0),
  },
  {
    label: "Points-finish rate",
    aVal: relPct(tA.pointsFinishes ?? 0, tA.races ?? 0),
    bVal: relPct(tB.pointsFinishes ?? 0, tB.races ?? 0),
  },
];

// Season-shape strip — raw seasons
const stripA = (f1dA.seasons ?? []) as any[];
const stripB = (f1dB.seasons ?? []) as any[];
const stripCols = Math.max(stripA.length, stripB.length);

// Age alignment: age = season_year - birth_year (conventional BB-Ref "age you turn that year")
const birthYearA = dA.dateOfBirth ? parseInt((dA.dateOfBirth as string).slice(0, 4)) : null;
const birthYearB = dB.dateOfBirth ? parseInt((dB.dateOfBirth as string).slice(0, 4)) : null;
const stripAWithAge = stripA.map((s: any) => ({
  year: s.year as number,
  f1delta: s.f1delta as number,
  rank: s.rank as number | null,
  age: birthYearA != null ? (s.year as number) - birthYearA : null,
}));
const stripBWithAge = stripB.map((s: any) => ({
  year: s.year as number,
  f1delta: s.f1delta as number,
  rank: s.rank as number | null,
  age: birthYearB != null ? (s.year as number) - birthYearB : null,
}));

// ── Page meta ─────────────────────────────────────────────────────────────
const pageTitle = isSeasonMode
  ? `${dA.name} ${yearA} vs ${dB.name} ${yearB} — f1delta`
  : `${dA.name} vs ${dB.name} — f1delta`;
const pageDesc = isSeasonMode
  ? `Compare ${dA.name}'s ${yearA} season against ${dB.name}'s ${yearB} season: f1δ scores, wins, podiums, and rates.`
  : `Compare ${dA.name} and ${dB.name}: championships, wins, podiums, poles, and career rates.`;
const canonical = `https://f1delta.com/compare/${slug}`;
---

<BaseLayout title={pageTitle} description={pageDesc} canonical={canonical}>

  <div class="cmp">

    <!-- Header -->
    <div class="cmp-hd">
      <div class="cmp-names">
        <a class="cmp-name" href={"/drivers/" + idA}>{dA.name}</a>
        <span class="cmp-sep">vs</span>
        <a class="cmp-name" href={"/drivers/" + idB}>{dB.name}</a>
      </div>
      <p class="cmp-back"><a href="/compare">← Compare another pair</a></p>
    </div>

    <!-- Mode toggle -->
    <div class="mode-ctrl">
      <a href={careerUrl} class:list={["mode-btn", { "mode-active": !isSeasonMode }]}>Career</a>
      <a href={toSeasonUrl} class:list={["mode-btn", { "mode-active": isSeasonMode }]}>Season</a>
    </div>

    <!-- Comparison grid -->
    <div class="card">
      <div class="table-scroll">
        <table class="cmp-tbl">
          <thead>
            <tr>
              <th class="lbl"></th>
              <th class="drv-col">
                <a href={"/drivers/" + idA}>{dA.name}</a>
                {isSeasonMode && (
                  <select class="yr-sel" data-side="a" data-aid={idA} data-bid={idB} data-ayear={yearA} data-byear={yearB}>
                    {(dA.career as any[]).slice().sort((a: any, b: any) => b.season - a.season).map((c: any) => (
                      <option value={c.season} selected={c.season === yearA}>{c.season}</option>
                    ))}
                  </select>
                )}
              </th>
              <th class="drv-col">
                <a href={"/drivers/" + idB}>{dB.name}</a>
                {isSeasonMode && (
                  <select class="yr-sel" data-side="b" data-aid={idA} data-bid={idB} data-ayear={yearA} data-byear={yearB}>
                    {(dB.career as any[]).slice().sort((a: any, b: any) => b.season - a.season).map((c: any) => (
                      <option value={c.season} selected={c.season === yearB}>{c.season}</option>
                    ))}
                  </select>
                )}
              </th>
            </tr>
          </thead>
          <tbody>

            <!-- ── CAREER / SEASON ────────────────────────────── -->
            {isSeasonMode ? (
              <>
                <tr class="grp-hd"><th colspan="3">Season</th></tr>
                <tr>
                  <td class="lbl">Season</td>
                  <td class="val neutral"><a href={"/standings/" + yearA}>{yearA}</a></td>
                  <td class="val neutral"><a href={"/standings/" + yearB}>{yearB}</a></td>
                </tr>
                <tr class="teams-row">
                  <td class="lbl">Team</td>
                  <td class="val neutral teams">
                    {(csA.teams as any[]).map((t: any, i: number) => (
                      <>{i > 0 && <span class="tsep">, </span>}<a href={"/teams/" + t.constructorId}>{t.constructor}</a></>
                    ))}
                  </td>
                  <td class="val neutral teams">
                    {(csB.teams as any[]).map((t: any, i: number) => (
                      <>{i > 0 && <span class="tsep">, </span>}<a href={"/teams/" + t.constructorId}>{t.constructor}</a></>
                    ))}
                  </td>
                </tr>
                <tr>
                  <td class="lbl">Races</td>
                  <td class="val neutral">{csA.races ?? "—"}</td>
                  <td class="val neutral">{csB.races ?? "—"}</td>
                </tr>
                {(() => {
                  const aPos = csA.wdcFinish ?? 99, bPos = csB.wdcFinish ?? 99;
                  return (
                    <tr>
                      <td class="lbl">WDC finish</td>
                      <td class:list={["val", { win: aPos < bPos && aPos < 99, lose: bPos < aPos && bPos < 99 }]}>
                        {csA.wdcFinish ? "P" + csA.wdcFinish : "—"}
                      </td>
                      <td class:list={["val", { win: bPos < aPos && bPos < 99, lose: aPos < bPos && aPos < 99 }]}>
                        {csB.wdcFinish ? "P" + csB.wdcFinish : "—"}
                      </td>
                    </tr>
                  );
                })()}
              </>
            ) : (
              <>
                <tr class="grp-hd"><th colspan="3">Career</th></tr>
                {(() => {
                  const a = tA.championships ?? 0, b = tB.championships ?? 0;
                  const aWin = a > b, bWin = b > a;
                  return (
                    <tr>
                      <td class="lbl">Championships</td>
                      <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{a || "—"}</td>
                      <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{b || "—"}</td>
                    </tr>
                  );
                })()}
                <tr><td class="lbl">Career span</td><td class="val neutral">{dA.firstSeason}–{dA.lastSeason}</td><td class="val neutral">{dB.firstSeason}–{dB.lastSeason}</td></tr>
                <tr><td class="lbl">Seasons</td><td class="val neutral">{seasonsA}</td><td class="val neutral">{seasonsB}</td></tr>
                <tr><td class="lbl">Race starts</td><td class="val neutral">{tA.races ?? "—"}</td><td class="val neutral">{tB.races ?? "—"}</td></tr>
                <tr class="teams-row">
                  <td class="lbl">Teams</td>
                  <td class="val neutral teams">
                    {teamsA.map((t, i) => (
                      <>{i > 0 && <span class="tsep">, </span>}<a href={"/teams/" + t.id}>{t.name}</a></>
                    ))}
                  </td>
                  <td class="val neutral teams">
                    {teamsB.map((t, i) => (
                      <>{i > 0 && <span class="tsep">, </span>}<a href={"/teams/" + t.id}>{t.name}</a></>
                    ))}
                  </td>
                </tr>
              </>
            )}

            <!-- ── f1δ SCORE ──────────────────────────────────── -->
            {hasF1D && (isSeasonMode ? (
              <>
                <tr class="grp-hd">
                  <th colspan="3">f1δ Score <span class="grp-note">era-fair · season vs season · <a href="/methodology" class="grp-link">what is this?</a></span></th>
                </tr>
                {(() => {
                  const aV = f1dSeasonA?.f1delta ?? null;
                  const bV = f1dSeasonB?.f1delta ?? null;
                  const aWin = aV != null && bV != null && aV > bV;
                  const bWin = aV != null && bV != null && bV > aV;
                  return (
                    <tr>
                      <td class="lbl">Season f1δ · rank</td>
                      <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>
                        {aV != null ? (aV as number).toFixed(1) + " · #" + (f1dSeasonA as any).rank : "—"}
                      </td>
                      <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>
                        {bV != null ? (bV as number).toFixed(1) + " · #" + (f1dSeasonB as any).rank : "—"}
                      </td>
                    </tr>
                  );
                })()}
              </>
            ) : (
              <>
                <tr class="grp-hd">
                  <th colspan="3">f1δ Score <span class="grp-note">era-fair dominance · <a href="/methodology" class="grp-link">what is this?</a></span></th>
                </tr>
                {f1dRows.map(row => {
                  const aWin = row.aRaw > row.bRaw, bWin = row.bRaw > row.aRaw;
                  return (
                    <tr>
                      <td class="lbl">{row.label}</td>
                      <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{row.aVal}</td>
                      <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{row.bVal}</td>
                    </tr>
                  );
                })}
              </>
            ))}

            <!-- ── WINS & PODIUMS ──────────────────────────────── -->
            {isSeasonMode ? (
              <>
                <tr class="grp-hd"><th colspan="3">Wins &amp; podiums <span class="grp-note">that season · era-dependent</span></th></tr>
                {([
                  { label: "Wins",         aRaw: csA.wins ?? 0,        bRaw: csB.wins ?? 0 },
                  { label: "Podiums",      aRaw: csA.podiums ?? 0,     bRaw: csB.podiums ?? 0 },
                  { label: "Poles",        aRaw: csA.poles ?? 0,       bRaw: csB.poles ?? 0 },
                  { label: "Fastest laps", aRaw: csA.fastestLaps ?? 0, bRaw: csB.fastestLaps ?? 0 },
                ] as { label: string; aRaw: number; bRaw: number }[]).map(row => {
                  const aWin = row.aRaw > row.bRaw, bWin = row.bRaw > row.aRaw;
                  return (
                    <tr>
                      <td class="lbl">{row.label}</td>
                      <td class:list={["val", { win: aWin, lose: !aWin && bWin }]}>{row.aRaw}</td>
                      <td class:list={["val", { win: bWin, lose: !bWin && aWin }]}>{row.bRaw}</td>
                    </tr>
                  );
                })}
              </>
            ) : (
              <>
                <tr class="grp-hd"><th colspan="3">Wins &amp; podiums <span class="grp-note">era-dependent · not directly comparable across eras</span></th></tr>
                <tr><td class="lbl">Wins</td><td class="val neutral">{fmt(tA.wins)}</td><td class="val neutral">{fmt(tB.wins)}</td></tr>
                <tr><td class="lbl">Podiums</td><td class="val neutral">{fmt(tA.podiums)}</td><td class="val neutral">{fmt(tB.podiums)}</td></tr>
                <tr><td class="lbl">Poles</td><td class="val neutral">{fmt(tA.poles)}</td><td class="val neutral">{fmt(tB.poles)}</td></tr>
                <tr><td class="lbl">Fastest laps</td><td class="val neutral">{fmt(tA.fastestLaps)}</td><td class="val neutral">{fmt(tB.fastestLaps)}</td></tr>
              </>
            )}

            <!-- ── RATES ──────────────────────────────────────── -->
            {isSeasonMode ? (
              <>
                <tr class="grp-hd"><th colspan="3">Season rates <span class="grp-note">that season · same conditions</span></th></tr>
                {([
                  { label: "Win %",    aNum: csA.wins ?? 0,    bNum: csB.wins ?? 0 },
                  { label: "Podium %", aNum: csA.podiums ?? 0, bNum: csB.podiums ?? 0 },
                  { label: "Pole %",   aNum: csA.poles ?? 0,   bNum: csB.poles ?? 0 },
                ] as { label: string; aNum: number; bNum: number }[]).map(row => {
                  const aR = row.aNum / (csA.races || 1), bR = row.bNum / (csB.races || 1);
                  const aWin = aR > bR, bWin = bR > aR;
                  return (
                    <tr>
                      <td class="lbl">{row.label}</td>
                      <td class:list={["val", { win: aWin, lose: !aWin && bWin }]}>{pct(row.aNum, csA.races ?? 0)}</td>
                      <td class:list={["val", { win: bWin, lose: !bWin && aWin }]}>{pct(row.bNum, csB.races ?? 0)}</td>
                    </tr>
                  );
                })}
              </>
            ) : (
              <>
                <tr class="grp-hd"><th colspan="3">Era-fair rates <span class="grp-note">career rate · across all seasons</span></th></tr>
                {rateRows.map(row => {
                  const aWin = row.aRaw > row.bRaw, bWin = row.bRaw > row.aRaw;
                  return (
                    <tr>
                      <td class="lbl">{row.label}</td>
                      <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{row.aVal}</td>
                      <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{row.bVal}</td>
                    </tr>
                  );
                })}
              </>
            )}

            <!-- ── RELIABILITY & CONSISTENCY ──────────────────── -->
            {isSeasonMode ? (
              <>
                <tr class="grp-hd"><th colspan="3">Reliability &amp; consistency <span class="grp-note">that season · conditions matched</span></th></tr>
                {(() => {
                  const aS = csA.races ?? 0, bS = csB.races ?? 0;
                  const dA2 = csA.dnfCount ?? 0, dB2 = csB.dnfCount ?? 0;
                  const pA = csA.pointsFinishes ?? 0, pB = csB.pointsFinishes ?? 0;
                  const dnfRA = aS > 0 ? dA2 / aS : 0, dnfRB = bS > 0 ? dB2 / bS : 0;
                  const pRA  = aS > 0 ? pA / aS : 0,  pRB  = bS > 0 ? pB / bS : 0;
                  return (
                    <>
                      <tr>
                        <td class="lbl">DNF rate</td>
                        <td class:list={["val", { win: aS > 0 && dnfRA < dnfRB, lose: dnfRA > dnfRB }]}>{relPct(dA2, aS)}</td>
                        <td class:list={["val", { win: bS > 0 && dnfRB < dnfRA, lose: dnfRB > dnfRA }]}>{relPct(dB2, bS)}</td>
                      </tr>
                      <tr>
                        <td class="lbl">Points-finish rate</td>
                        <td class:list={["val", { win: pRA > pRB, lose: aS > 0 && pRA < pRB }]}>{relPct(pA, aS)}</td>
                        <td class:list={["val", { win: pRB > pRA, lose: bS > 0 && pRB < pRA }]}>{relPct(pB, bS)}</td>
                      </tr>
                    </>
                  );
                })()}
              </>
            ) : (
              <>
                <tr class="grp-hd"><th colspan="3">Reliability &amp; consistency <span class="grp-note">era-dependent · see explanation</span></th></tr>
                {relRows.map(row => (
                  <tr>
                    <td class="lbl">{row.label}</td>
                    <td class="val neutral">{row.aVal}</td>
                    <td class="val neutral">{row.bVal}</td>
                  </tr>
                ))}
              </>
            )}

            <!-- ── POINTS ──────────────────────────────────────── -->
            {isSeasonMode ? (
              <>
                <tr class="grp-hd"><th colspan="3">Points <span class="grp-note">that season · scoring-era variable</span></th></tr>
                {(() => {
                  const aV = csA.points ?? 0, bV = csB.points ?? 0;
                  const aWin = aV > bV, bWin = bV > aV;
                  return (
                    <tr>
                      <td class="lbl">Season total</td>
                      <td class:list={["val", { win: aWin, lose: bWin && !aWin }]}>{fmt(csA.points)}</td>
                      <td class:list={["val", { win: bWin, lose: aWin && !bWin }]}>{fmt(csB.points)}</td>
                    </tr>
                  );
                })()}
              </>
            ) : (
              <>
                <tr class="grp-hd"><th colspan="3">Points <span class="grp-note">scoring-era variable · not directly comparable</span></th></tr>
                <tr><td class="lbl">Career total</td><td class="val neutral">{fmt(tA.points)}</td><td class="val neutral">{fmt(tB.points)}</td></tr>
              </>
            )}

          </tbody>
        </table>
      </div>

      {isSeasonMode && <F1DeltaExplain seasonNote={true} />}

      {stripCols > 0 && (
        <div class="f1ds-section">
          <div class="f1ds-hd">
            <span class="f1ds-title">f1δ season shape</span>
            <div class="f1dt-row">
              <button class="f1dt active" data-align="career">career</button>
              <button class="f1dt" data-align="age">age</button>
              <button class="f1dt" data-align="calendar">calendar</button>
            </div>
          </div>
          <div class="f1ds-legend">
            <span class="f1ds-leg">
              <svg width="16" height="3" aria-hidden="true" class="f1ds-lsvg">
                <line x1="0" y1="1.5" x2="16" y2="1.5" stroke="#e10600" stroke-width="2"/>
              </svg>
              <a href={"/drivers/" + idA} class="f1ds-lname">{dA.name}</a>
            </span>
            <span class="f1ds-leg">
              <svg width="16" height="3" aria-hidden="true" class="f1ds-lsvg">
                <line x1="0" y1="1.5" x2="16" y2="1.5" stroke="#6b6b70" stroke-width="2" stroke-dasharray="4 2"/>
              </svg>
              <a href={"/drivers/" + idB} class="f1ds-lname">{dB.name}</a>
            </span>
          </div>
          <div
            class="f1ds-chart"
            id="f1ds-chart"
            data-a={JSON.stringify(stripAWithAge)}
            data-b={JSON.stringify(stripBWithAge)}
            data-na={dA.name}
            data-nb={dB.name}
            data-ha={isSeasonMode ? String(yearA) : ""}
            data-hb={isSeasonMode ? String(yearB) : ""}
          ></div>
          <F1DeltaExplain compareNote={true} />
        </div>
      )}
      <ReliabilityExplain />
    </div>

    <!-- Ad slot (E2): after table, before footer links -->
    <div id="cmp-ad-slot" data-ad-slot></div>

    <!-- H2H cross-link (E1): only if they were teammates with a race-comparable pairing -->
    {hasH2H && (
      <div class="h2h-xlink">
        <span class="h2h-xlink-icon">🏎</span>
        <div>
          <strong>They shared a car.</strong>
          <a class="h2h-xlink-a" href={`/h2h/${h2hSlug}`}>See the teammate head-to-head →</a>
        </div>
      </div>
    )}

    <!-- Footer links (E1) -->
    <div class="cmp-foot">
      <a href={`/drivers/${idA}`}>{dA.name} career page →</a>
      <a href={`/drivers/${idB}`}>{dB.name} career page →</a>
    </div>

  </div>

</BaseLayout>

<script is:inline>
(function () {
  var el = document.getElementById('f1ds-chart');
  if (!el) return;

  var stripA = JSON.parse(el.dataset.a);
  var stripB = JSON.parse(el.dataset.b);
  var highlightA = parseInt(el.dataset.ha) || null;
  var highlightB = parseInt(el.dataset.hb) || null;

  var W = 560, CH = 60, LH = 14, H = CH + LH;

  function py(v) { return +(CH - v * CH / 100).toFixed(2); }

  function rankFill(r) {
    if (r === 1) return '#b8952a';
    if (r <= 3) return '#e10600';
    if (r != null) return '#9398a3';
    return '#c0c4c8';
  }

  function buildCols(mode) {
    if (mode === 'career') {
      var len = Math.max(stripA.length, stripB.length);
      return Array.from({ length: len }, function (_, i) {
        return { aData: stripA[i] || null, bData: stripB[i] || null, label: String(i + 1) };
      });
    }
    if (mode === 'age') {
      var ages = stripA.concat(stripB).map(function (s) { return s.age; }).filter(function (a) { return a != null; });
      if (!ages.length) return buildCols('career');
      var lo = Math.min.apply(null, ages), hi = Math.max.apply(null, ages);
      return Array.from({ length: hi - lo + 1 }, function (_, i) {
        var age = lo + i;
        return {
          aData: stripA.find(function (s) { return s.age === age; }) || null,
          bData: stripB.find(function (s) { return s.age === age; }) || null,
          label: String(age),
        };
      });
    }
    // calendar
    var years = stripA.concat(stripB).map(function (s) { return s.year; });
    var lo2 = Math.min.apply(null, years), hi2 = Math.max.apply(null, years);
    return Array.from({ length: hi2 - lo2 + 1 }, function (_, i) {
      var yr = lo2 + i;
      return {
        aData: stripA.find(function (s) { return s.year === yr; }) || null,
        bData: stripB.find(function (s) { return s.year === yr; }) || null,
        label: "'" + String(yr).slice(2),
      };
    });
  }

  function pathFor(cols, key) {
    var cw = W / cols.length;
    var d = '', prevHad = false;
    cols.forEach(function (col, i) {
      var s = col[key];
      if (!s) { prevHad = false; return; }
      var x = ((i + 0.5) * cw).toFixed(1);
      var y = py(s.f1delta);
      d += (prevHad ? ' L' : ' M') + x + ',' + y;
      prevHad = true;
    });
    return d.trim();
  }

  function esc(v) { return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function render(mode) {
    var cols = buildCols(mode);
    var n = cols.length;
    if (!n) return;
    var cw = W / n;
    var skip = Math.max(1, Math.ceil(n / 15));
    var svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;display:block;overflow:visible" aria-hidden="true">';

    // grid lines
    [25, 50, 75].forEach(function (v) {
      svg += '<line x1="0" y1="' + py(v) + '" x2="' + W + '" y2="' + py(v) + '" stroke="#e4e4df" stroke-width="0.5"/>';
    });

    // paths
    var pa = pathFor(cols, 'aData');
    if (pa) svg += '<path d="' + pa + '" fill="none" stroke="#e10600" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>';
    var pb = pathFor(cols, 'bData');
    if (pb) svg += '<path d="' + pb + '" fill="none" stroke="#6b6b70" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="4 2"/>';

    // B dots first so A appears on top
    cols.forEach(function (col, i) {
      if (!col.bData) return;
      var x = ((i + 0.5) * cw).toFixed(1), y = py(col.bData.f1delta);
      var tip = esc(col.bData.year + ': ' + col.bData.f1delta.toFixed(1) + ' f1δ' + (col.bData.rank ? ' \xb7 #' + col.bData.rank : ''));
      svg += '<circle cx="' + x + '" cy="' + y + '" r="3" fill="' + rankFill(col.bData.rank) + '" stroke="#fff" stroke-width="1" opacity="0.9"><title>' + tip + '</title></circle>';
    });
    cols.forEach(function (col, i) {
      if (!col.aData) return;
      var x = ((i + 0.5) * cw).toFixed(1), y = py(col.aData.f1delta);
      var tip = esc(col.aData.year + ': ' + col.aData.f1delta.toFixed(1) + ' f1δ' + (col.aData.rank ? ' \xb7 #' + col.aData.rank : ''));
      svg += '<circle cx="' + x + '" cy="' + y + '" r="3.5" fill="' + rankFill(col.aData.rank) + '" stroke="#fff" stroke-width="1"><title>' + tip + '</title></circle>';
    });

    // highlight rings for season-mode selected years
    if (highlightA || highlightB) {
      cols.forEach(function (col, i) {
        var x = ((i + 0.5) * cw).toFixed(1);
        if (highlightA && col.aData && col.aData.year === highlightA) {
          svg += '<circle cx="' + x + '" cy="' + py(col.aData.f1delta) + '" r="6.5" fill="none" stroke="#e10600" stroke-width="1.5" opacity="0.6"/>';
        }
        if (highlightB && col.bData && col.bData.year === highlightB) {
          svg += '<circle cx="' + x + '" cy="' + py(col.bData.f1delta) + '" r="6.5" fill="none" stroke="#6b6b70" stroke-width="1.5" stroke-dasharray="3 1" opacity="0.6"/>';
        }
      });
    }

    // x-axis labels
    cols.forEach(function (col, i) {
      if (i % skip !== 0 && i !== n - 1) return;
      var x = ((i + 0.5) * cw).toFixed(1);
      svg += '<text x="' + x + '" y="' + (H - 2) + '" text-anchor="middle" font-size="7" font-family="monospace" fill="#9398a3">' + esc(col.label) + '</text>';
    });

    svg += '</svg>';
    el.innerHTML = svg;
  }

  var mode = 'career';
  render(mode);

  document.querySelectorAll('.f1dt[data-align]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.f1dt[data-align]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      mode = btn.dataset.align;
      render(mode);
    });
  });
}());

document.querySelectorAll('.yr-sel').forEach(function (sel) {
  sel.addEventListener('change', function () {
    var side = sel.dataset.side;
    var yr = sel.value;
    var aId = sel.dataset.aid, bId = sel.dataset.bid;
    var aYr = sel.dataset.ayear, bYr = sel.dataset.byear;
    var newA = side === 'a' ? yr : aYr;
    var newB = side === 'b' ? yr : bYr;
    window.location = '/compare/' + aId + '-' + newA + '-vs-' + bId + '-' + newB;
  });
});
</script>

<style>
  .cmp {
    max-width: 680px; margin: 0 auto; padding: 0 20px 56px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .cmp-hd { padding: 28px 0 20px; }
  .cmp-names {
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap; margin-bottom: 8px;
  }
  .cmp-name {
    font-family: var(--disp);
    font-size: clamp(18px, 3.5vw, 26px); font-weight: 700;
    color: var(--red); text-decoration: none; letter-spacing: -.01em;
  }
  .cmp-name:hover { text-decoration: underline; }
  .cmp-sep {
    font-family: var(--disp); font-size: 18px;
    font-weight: 700; color: var(--faint);
  }
  .cmp-back { margin: 0; }
  .cmp-back a { font-size: 12px; color: var(--dim); text-decoration: none; }
  .cmp-back a:hover { color: var(--ink); text-decoration: underline; }

  /* ── Card ────────────────────────────────────────────────────── */
  .card {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 8px; overflow: hidden; margin-bottom: 16px;
  }
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  /* ── Table ───────────────────────────────────────────────────── */
  .cmp-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }

  .cmp-tbl thead th {
    padding: 10px 12px; text-align: left;
    font-size: 12px; font-weight: 600; color: var(--ink);
    border-bottom: 2px solid var(--line); background: var(--surface);
  }
  .cmp-tbl thead th.drv-col { text-align: right; min-width: 100px; }
  .cmp-tbl thead th a { color: var(--red); text-decoration: none; }
  .cmp-tbl thead th a:hover { text-decoration: underline; }
  .cmp-tbl thead th.lbl { width: 38%; min-width: 110px; }

  /* Group headers */
  .grp-hd th {
    padding: 8px 12px 4px; text-align: left;
    font-size: 9.5px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--faint);
    background: var(--bg); border-top: 1px solid var(--line);
  }
  .grp-hd:first-of-type th { border-top: none; }
  .grp-note {
    font-weight: 400; letter-spacing: 0; text-transform: none;
    font-size: 9.5px; color: var(--faint); margin-left: 6px;
  }

  /* Data rows */
  .cmp-tbl tbody td {
    padding: 9px 12px; border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .cmp-tbl tbody tr:last-child td { border-bottom: none; }

  td.lbl {
    text-align: left; color: var(--dim); font-size: 12px;
  }
  td.val {
    text-align: right; font-family: var(--mono);
    font-variant-numeric: tabular-nums; font-size: 13px;
  }
  td.val.neutral { color: var(--ink); }
  /* Directional highlighting (C4) */
  td.val.win  { color: var(--red); font-weight: 700; }
  td.val.lose { color: var(--dim); }

  /* Teams cell */
  td.teams { font-family: system-ui, -apple-system, sans-serif; font-size: 12px; }
  td.teams a { color: var(--ink); text-decoration: none; }
  td.teams a:hover { color: var(--red); text-decoration: underline; }
  .tsep { color: var(--faint); }

  /* ── Ad slot ─────────────────────────────────────────────────── */
  #cmp-ad-slot {
    min-height: 90px; background: var(--bg);
    border: 1px dashed var(--line); border-radius: 6px;
    margin-bottom: 16px;
  }

  /* ── H2H cross-link ──────────────────────────────────────────── */
  .h2h-xlink {
    display: flex; align-items: center; gap: 12px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 8px; padding: 14px 16px; margin-bottom: 16px;
  }
  .h2h-xlink-icon { font-size: 20px; flex-shrink: 0; }
  .h2h-xlink strong { display: block; font-size: 13px; color: var(--ink); margin-bottom: 2px; }
  .h2h-xlink-a { font-size: 13px; color: var(--red); text-decoration: none; font-weight: 600; }
  .h2h-xlink-a:hover { text-decoration: underline; }

  /* ── Footer links ────────────────────────────────────────────── */
  .cmp-foot {
    display: flex; gap: 16px; flex-wrap: wrap;
    padding-top: 4px;
  }
  .cmp-foot a { font-size: 13px; color: var(--red); text-decoration: none; font-weight: 600; }
  .cmp-foot a:hover { text-decoration: underline; }

  /* ── Mode toggle ─────────────────────────────────────────────── */
  .mode-ctrl { display: flex; gap: 6px; margin-bottom: 12px; }
  .mode-btn {
    font-family: var(--mono); font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em;
    padding: 5px 12px; border: 1px solid var(--line);
    background: transparent; color: var(--dim);
    border-radius: 3px; text-decoration: none; line-height: 1;
  }
  .mode-btn.mode-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .mode-btn:hover:not(.mode-active) { background: var(--line); color: var(--ink); }

  /* Year dropdown in thead */
  .yr-sel {
    display: block; width: 100%; margin-top: 4px;
    font-family: var(--mono); font-size: 11px; color: var(--dim);
    border: 1px solid var(--line); border-radius: 3px;
    padding: 2px 4px; background: var(--bg); cursor: pointer;
  }

  /* ── f1δ group header link ───────────────────────────────────── */
  .grp-link { color: var(--faint); text-decoration: none; font-weight: 400; font-size: 9.5px; }
  .grp-link:hover { color: var(--ink); text-decoration: underline; }

  /* ── f1δ season shape chart ──────────────────────────────────── */
  .f1ds-section { border-top: 2px solid var(--line); }
  .f1ds-hd {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 12px; background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .f1ds-title {
    font-size: 9.5px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--faint);
    font-family: var(--mono);
  }
  /* alignment toggle */
  .f1dt-row { display: flex; gap: 4px; margin-left: auto; }
  .f1dt {
    font-family: var(--mono); font-size: 9px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em;
    padding: 3px 8px; border: 1px solid var(--line);
    background: transparent; color: var(--dim); cursor: pointer;
    border-radius: 3px; line-height: 1;
  }
  .f1dt.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .f1dt:hover:not(.active) { background: var(--line); }
  /* legend */
  .f1ds-legend {
    display: flex; gap: 16px; padding: 6px 12px;
    border-bottom: 1px solid var(--line); align-items: center;
  }
  .f1ds-leg { display: flex; align-items: center; gap: 5px; }
  .f1ds-lsvg { display: block; flex-shrink: 0; }
  .f1ds-lname {
    font-family: var(--mono); font-size: 10px; color: var(--dim);
    font-weight: 600; text-decoration: none; letter-spacing: .02em;
  }
  .f1ds-lname:hover { color: var(--ink); }
  /* chart container */
  .f1ds-chart { padding: 10px 12px 4px; }
</style>
